---
import Button from '../components/Button.astro';
import Input from '../components/Input.astro';
import Badge from '../components/Badge.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  class?: string;
}

const {
  title = 'CONVIÉRTETE EN OPERADOR DE RYUKAMI',
  subtitle = 'Recibe actualizaciones de nuevos bloques, componentes y tokens W3C directamente en tu terminal.',
  buttonText = 'REGISTRAR TTY',
  class: className = '',
} = Astro.props;
---

<div class={`tui-window p-6 sm:p-8 font-mono text-xs space-y-5 bg-white dark:bg-slate-900 border-2 border-black dark:border-slate-700 shadow-brutal ${className}`}>
  <div class="flex items-center justify-between border-b-2 border-black dark:border-slate-700 pb-3">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-scorch-gold border border-black inline-block"></span>
      <Badge variant="gold">CTA_DISPATCH</Badge>
    </div>
    <span class="text-[10px] text-slate-500 font-bold">TERMINAL_BROADCAST // READY</span>
  </div>

  <div class="space-y-2">
    <h3 class="font-extrabold text-lg sm:text-xl uppercase text-slate-900 dark:text-white">
      {title}
    </h3>
    <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed max-w-2xl">
      {subtitle}
    </p>
  </div>

  <form class="flex flex-col sm:flex-row gap-3 pt-2" onsubmit="event.preventDefault(); window.showToast && window.showToast('REGISTRO COMPLETADO', 'Canal de telemetría enlazado.', 'emerald');">
    <div class="flex-1">
      <Input
        label="Terminal / Email"
        placeholder="alex@ryukami.dev"
        prefix="tty://"
        required
      />
    </div>
    <div class="sm:self-end">
      <Button variant="gold" size="md" type="submit">
        <span>{buttonText} ↵</span>
      </Button>
    </div>
  </form>
</div>
