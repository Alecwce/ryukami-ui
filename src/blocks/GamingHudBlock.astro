---
import ProgressBar from '../components/ProgressBar.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';

export interface Props {
  playerName?: string;
  level?: number;
  class?: string;
}

const {
  playerName = 'RYU_OPERATOR_01',
  level = 42,
  class: className = '',
} = Astro.props;
---

<section class={`p-4 sm:p-6 bg-white dark:bg-[#0B0F17] border-2 border-black dark:border-slate-800 shadow-[-4px_4px_0px_0px_#000000] font-mono ${className}`}>
  <!-- Cabecera de Ventana Arcade -->
  <div class="bg-black text-white p-2 sm:px-3 flex items-center justify-between border-b-2 border-black mb-4">
    <div class="flex items-center gap-2 text-xs">
      <span class="w-2.5 h-2.5 bg-scorch-crimson border border-white inline-block"></span>
      <span class="font-extrabold uppercase tracking-widest text-[11px] sm:text-xs">
        0xRPG_HUD // GAMING_TELEMETRY
      </span>
    </div>
    <div class="flex items-center gap-1 select-none">
      <span class="w-4 h-4 border border-current inline-flex items-center justify-center text-[10px]">-</span>
      <span class="w-4 h-4 border border-current inline-flex items-center justify-center text-[10px]">□</span>
      <span class="w-4 h-4 border border-current inline-flex items-center justify-center bg-scorch-crimson text-white text-[10px]">×</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Perfil del Operador & Avatar Cuadrado -->
    <div class="border-2 border-black dark:border-slate-800 p-4 bg-slate-50 dark:bg-slate-900/60 flex flex-col justify-between">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <div class="w-12 h-12 bg-black text-scorch-gold border-2 border-black dark:border-scorch-gold flex items-center justify-center font-extrabold text-base select-none">
            [>_]
          </div>
          <div>
            <span class="text-[10px] text-slate-500 uppercase font-bold block">OPERADOR ACTIVO</span>
            <span class="font-extrabold text-sm text-slate-900 dark:text-white">{playerName}</span>
            <div class="flex gap-1.5 mt-0.5">
              <Badge variant="gold">LVL {level}</Badge>
              <Badge variant="cyan">ARCHITECT</Badge>
            </div>
          </div>
        </div>

        <div class="text-[11px] text-slate-600 dark:text-slate-400 space-y-1 border-t-2 border-dashed border-slate-300 dark:border-slate-800 pt-3">
          <div class="flex justify-between">
            <span class="font-bold">CLASE:</span>
            <span class="text-slate-900 dark:text-white font-mono">SCORCH_ENGINEER</span>
          </div>
          <div class="flex justify-between">
            <span class="font-bold">ARMADURA:</span>
            <span class="text-slate-900 dark:text-white font-mono">NEO_BRUTAL_MK4</span>
          </div>
          <div class="flex justify-between">
            <span class="font-bold">SECTOR:</span>
            <span class="text-scorch-cyan font-bold font-mono">0xSECTOR_404</span>
          </div>
        </div>
      </div>

      <!-- Ranuras de Acceso Rápido / Inventario -->
      <div class="pt-4 border-t-2 border-slate-300 dark:border-slate-800 mt-4">
        <span class="text-[10px] text-slate-500 uppercase font-bold block mb-1.5">ACCIONES RÁPIDAS:</span>
        <div class="grid grid-cols-4 gap-1.5 text-center text-[10px] font-bold">
          <div class="border-2 border-black dark:border-slate-700 p-1.5 bg-white dark:bg-black hover:border-scorch-crimson cursor-pointer transition-colors">
            <span class="text-scorch-crimson block font-extrabold">[1]</span>
            <span>POTION</span>
          </div>
          <div class="border-2 border-black dark:border-slate-700 p-1.5 bg-white dark:bg-black hover:border-scorch-cyan cursor-pointer transition-colors">
            <span class="text-scorch-cyan block font-extrabold">[2]</span>
            <span>MANA</span>
          </div>
          <div class="border-2 border-black dark:border-slate-700 p-1.5 bg-white dark:bg-black hover:border-scorch-gold cursor-pointer transition-colors">
            <span class="text-scorch-gold block font-extrabold">[3]</span>
            <span>SHIELD</span>
          </div>
          <div class="border-2 border-black dark:border-slate-700 p-1.5 bg-white dark:bg-black hover:border-emerald-500 cursor-pointer transition-colors">
            <span class="text-emerald-500 block font-extrabold">[4]</span>
            <span>BURST</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel Central: Barras de Vida (HP), Maná (MP) y Experiencia (XP) -->
    <div class="lg:col-span-2 border-2 border-black dark:border-slate-800 p-4 bg-slate-50 dark:bg-slate-900/60 space-y-4">
      <div class="flex items-center justify-between border-b-2 border-black dark:border-slate-800 pb-2">
        <span class="font-extrabold text-xs uppercase tracking-tight text-slate-900 dark:text-white">
          // ESTADO VITAL & ENERGÍA
        </span>
        <span class="text-[10px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 border border-emerald-500/30">
          [ESTADO: COMBATE_ACTIVO]
        </span>
      </div>

      <!-- Barra de Salud (HP) -->
      <ProgressBar
        label="VIDA [HP]"
        value={850}
        max={1000}
        variant="health"
        status="850 / 1000 HP"
        pixelCorners={true}
      />

      <!-- Barra de Maná (MP) -->
      <ProgressBar
        label="ENERGÍA [MP]"
        value={320}
        max={500}
        variant="mana"
        status="320 / 500 MP"
        pixelCorners={true}
      />

      <!-- Barra de Experiencia con Alerta Animada LEVEL UP! -->
      <ProgressBar
        label="EXPERIENCIA [XP]"
        value={100}
        max={100}
        variant="xp"
        status="100 / 100 XP"
        levelUpMessage="[ ! ] LEVEL UP!"
        pixelCorners={true}
      />

      <!-- Barra de Jefe / Enemigo (Target) -->
      <div class="pt-2 border-t-2 border-dashed border-slate-300 dark:border-slate-800">
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-[10px] font-extrabold text-scorch-crimson uppercase">
            OBJETIVO EN RANGO: 0xBOSS_CORRUPT
          </span>
          <span class="text-[10px] text-slate-500 font-bold">4,200 / 5,000 HP</span>
        </div>
        <ProgressBar
          label="BOSS INTEGRITY"
          value={4200}
          max={5000}
          variant="crimson"
          showAscii={false}
          pixelCorners={true}
        />
      </div>
    </div>
  </div>
</section>
