---
import Input from '../components/Input.astro';
import Button from '../components/Button.astro';
import Checkbox from '../components/Checkbox.astro';
import Badge from '../components/Badge.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  title = '0xAUTH // ACCESO OPERADOR',
  subtitle = 'Introduce tus credenciales para autenticar tu terminal en el clúster Scorch.',
  class: className = '',
} = Astro.props;
---

<div class={`tui-window p-6 sm:p-8 max-w-md mx-auto font-mono text-xs space-y-5 bg-white dark:bg-slate-900 border-2 border-black dark:border-slate-700 shadow-brutal ${className}`}>
  <div class="flex items-center justify-between border-b-2 border-black dark:border-slate-700 pb-3">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 bg-scorch-crimson border border-black inline-block"></span>
      <Badge variant="crimson">SESSION_LOGIN</Badge>
    </div>
    <span class="text-[10px] text-slate-500 font-bold">TTY1 // SECURE</span>
  </div>

  <div class="space-y-1 text-center sm:text-left">
    <h3 class="font-extrabold text-lg uppercase text-slate-900 dark:text-white">
      {title}
    </h3>
    <p class="text-[11px] text-slate-700 dark:text-slate-300 leading-relaxed">
      {subtitle}
    </p>
  </div>

  <form class="space-y-4" onsubmit="event.preventDefault(); window.showToast && window.showToast('SESIÓN INICIADA', 'Operador autenticado con éxito.', 'emerald');">
    <Input
      label="Identificador de Operador"
      placeholder="alex@ryukami.dev"
      prefix="id://"
      required
    />

    <Input
      label="Llave de Seguridad / Contraseña"
      type="password"
      placeholder="••••••••••••"
      prefix="key://"
      required
    />

    <div class="flex items-center justify-between text-[11px]">
      <Checkbox label="Recordar sesión TTY" checked />
      <a href="#reset" class="underline text-slate-600 dark:text-slate-400 hover:text-scorch-crimson font-bold">¿Olvidaste clave?</a>
    </div>

    <Button variant="crimson" size="md" type="submit" class="w-full">
      <span>ENTRAR A LA CONSOLA ↵</span>
    </Button>
  </form>
</div>
