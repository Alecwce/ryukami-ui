---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeStudio from '../components/ThemeStudio.astro';
import Callout from '../components/Callout.astro';
---

<BaseLayout
  title="Themes - Ryukami-UI"
  description="Laboratorio en vivo de temas, paleta de colores Scorch y tokens W3C para Ryukami-UI."
>
  <div class="space-y-10">
    <section class="space-y-4 border-b-2 border-black dark:border-slate-700 pb-8 text-center md:text-left">
      <div class="flex items-center justify-center md:justify-start gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black inline-block"></span>
        <span class="text-xs font-mono font-bold uppercase text-scorch-crimson">// THEME_ENGINE_STUDIO</span>
      </div>
      <h1 class="title-8bit text-3xl sm:text-5xl text-slate-900 dark:text-white">
        THEMES &amp; TOKENS
      </h1>
      <p class="text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300 max-w-2xl">
        Ajusta la paleta cromática en tiempo real, calibrada para superar WCAG AA (5.04:1). Exporta tus tokens directamente en CSS o JSON compatible con Obsidian.
      </p>
    </section>

    <Callout type="scorch" title="W3C DESIGN TOKENS INTEGRATION" badge="v4.1.0">
      Los tokens están disponibles en <a href="/r/tokens.json" target="_blank" class="underline font-bold text-scorch-crimson">/r/tokens.json</a> e integrados con el comando <code>ryukami-ui init --obsidian</code>.
    </Callout>

    <!-- ThemeStudio Component -->
    <section class="space-y-4">
      <ThemeStudio />
    </section>
  </div>
</BaseLayout>
