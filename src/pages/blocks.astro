---
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import DataTable from '../components/DataTable.astro';
import TerminalEmulator from '../components/TerminalEmulator.astro';
import AsciiGenerator from '../components/AsciiGenerator.astro';
import Callout from '../components/Callout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout
  title="Blocks - Ryukami-UI"
  description="Bloques modulares de página, pantallas de consola TUI y plantillas listas para copiar en Ryukami-UI."
>
  <div class="space-y-12">
    <!-- Encabezado de Bloques -->
    <section class="space-y-4 border-b-2 border-black dark:border-slate-700 pb-8 text-center md:text-left">
      <div class="flex items-center justify-center md:justify-start gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black inline-block"></span>
        <span class="text-xs font-mono font-bold uppercase text-scorch-gold-text dark:text-scorch-gold">// MODULAR_PAGE_BLOCKS</span>
      </div>
      <h1 class="title-8bit text-3xl sm:text-5xl text-slate-900 dark:text-white">
        BLOCKS &amp; SHELL
      </h1>
      <p class="text-sm sm:text-base leading-relaxed text-slate-700 dark:text-slate-300 max-w-2xl">
        Secciones completas de interfaz, dashboards de telemetría y herramientas integradas al estilo 8bitcn para ensamblar páginas completas en minutos.
      </p>
    </section>

    <!-- Block 1: Bento Grid Dashboard -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-pixel text-sm uppercase text-slate-900 dark:text-white">// BLOCK 01: BENTO TELEMETRY DASHBOARD</h2>
        <span class="text-xs font-mono bg-black text-scorch-gold px-2 py-0.5 border border-slate-700 font-bold">READY TO USE</span>
      </div>
      <BentoGrid
        columns={3}
        items={[
          {
            title: '0xVAULT // OBSIDIAN_BRIDGE',
            subtitle: 'W3C DESIGN TOKENS',
            metric: '35 MÓDULOS',
            badge: 'SYNCED',
            description: 'Sincronización bidireccional entre ryukami-ui (/r/tokens.json) y tu bóveda de notas.',
            span: '2',
            variant: 'crimson',
          },
          {
            title: '0xSHA256 // INTEGRITY',
            subtitle: 'SUPPLY CHAIN',
            metric: '100% PASS',
            badge: 'VERIFIED',
            description: 'Auditoría local de integridad criptográfica con ryukami-ui diff.',
            span: '1',
            variant: 'cyan',
          },
          {
            title: '0xMCP // AI_SERVER',
            subtitle: 'JSON-RPC 2.0',
            metric: 'STDIO READY',
            badge: 'AGENT',
            description: 'Servidor MCP integrado para agentes de inteligencia artificial.',
            span: '1',
            variant: 'gold',
          },
          {
            title: '0xSCORCH // ZERO_JS',
            subtitle: 'HTML5 NATIVE DIALOGS',
            metric: '0 KiB BUNDLE',
            badge: 'PERF',
            description: 'Componentes accesibles con dialog nativo y aceleración por GPU.',
            span: '2',
            variant: 'emerald',
          },
        ]}
      />
    </section>

    <!-- Block 2: Data Table Cluster -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-pixel text-sm uppercase text-slate-900 dark:text-white">// BLOCK 02: TUI SERVICE REGISTRY TABLE</h2>
        <span class="text-xs font-mono bg-black text-scorch-cyan px-2 py-0.5 border border-slate-700 font-bold">FILTER &amp; SORT</span>
      </div>
      <DataTable
        title="ACTIVE_CLUSTER_NODES // 0xGRID"
        columns={[
          { key: 'service', label: 'Módulo / Servicio' },
          { key: 'protocol', label: 'Protocolo' },
          { key: 'uptime', label: 'Uptime' },
          { key: 'status', label: 'Estado' },
        ]}
        rows={[
          { service: 'PostgreSQL 17.2', protocol: 'tcp://5432', uptime: '99.98%', status: 'ONLINE' },
          { service: 'Redis 7.2 LTS', protocol: 'tcp://6379', uptime: '100.0%', status: 'ONLINE' },
          { service: 'Cloudflare Pages CDN', protocol: 'https://ryukami-ui.pages.dev', uptime: '100.0%', status: 'ONLINE' },
          { service: 'Ryukami MCP Server', protocol: 'jsonrpc://ryukami-ui-mcp', uptime: '100.0%', status: 'STABLE' },
        ]}
      />
    </section>

    <!-- Block 3: Interactive TUI Terminal -->
    <section id="shell" class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-pixel text-sm uppercase text-slate-900 dark:text-white">// BLOCK 03: INTERACTIVE 0xSCORCH_SHELL</h2>
        <span class="text-xs font-mono bg-black text-emerald-400 px-2 py-0.5 border border-slate-700 font-bold">LIVE CONSOLE</span>
      </div>
      <TerminalEmulator />
    </section>

    <!-- Block 4: ASCII Matrix Forge -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="font-pixel text-sm uppercase text-slate-900 dark:text-white">// BLOCK 04: 8-BIT ASCII FORGE</h2>
        <span class="text-xs font-mono bg-black text-scorch-gold px-2 py-0.5 border border-slate-700 font-bold">ASCII ENGINE</span>
      </div>
      <AsciiGenerator />
    </section>
  </div>
</BaseLayout>
