  <!-- Simulación interactiva de telemetría en barras de progreso -->
  <script is:inline>
    (function () {
      const btn = document.getElementById('simulate-telemetry-btn');
      const stack = document.getElementById('telemetry-demo-stack');
      if (!btn || !stack) return;

      btn.addEventListener('click', () => {
        const bars = stack.querySelectorAll('[data-progress-root]');
        bars.forEach((bar) => {
          const fill = bar.querySelector('[data-progress-fill]');
          const pctEl = bar.querySelector('[data-progress-pct]');
          const asciiEl = bar.querySelector('[data-progress-ascii]');
          const barWrap = bar.querySelector('[role="progressbar"]');
          if (!fill || !pctEl) return;

          const randomVal = Math.floor(Math.random() * 65) + 35;
          fill.style.transform = `scaleX(${randomVal / 100})`;
          pctEl.textContent = `${randomVal}%`;
          if (barWrap) barWrap.setAttribute('aria-valuenow', String(randomVal));

          if (asciiEl) {
            const total = 16;
            const filled = Math.round((randomVal / 100) * total);
            asciiEl.textContent = `[${'█'.repeat(filled)}${'░'.repeat(total - filled)}]`;
          }
        });

        if (window.showToast) {
          window.showToast(
            'TELEMETRÍA SINCRONIZADA',
            'Lecturas térmicas y de red actualizadas en tiempo real.',
            'cyan',
            2200
          );
        }
      });
    })();
  </script>

