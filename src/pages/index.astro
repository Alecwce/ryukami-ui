import Button from '@/components/Button.astro';

<Card title="0xSERVER // NODE_2" status="ONLINE">
  <div class="space-y-3">
    <h4 class="font-extrabold text-base uppercase">Botkeep Cloud Container</h4>
    <p class="text-xs leading-relaxed opacity-80">
      Contenedor asignado con 2 GB de RAM, PostgreSQL 17 y Redis 7.2.
    </p>
    <Button variant="cyan" size="sm">INSPECCIONAR NODO</Button>
  </div>
</Card>`;

const progressSnippet = `import ProgressBar from '@/components/ProgressBar.astro';

<ProgressBar label="Núcleo Térmico Velgrynd" value={92} variant="crimson" status="CRITICAL" />
<ProgressBar label="Memoria RAM Asignada" value={68} variant="cyan" status="1.36 GB / 2 GB" />
<ProgressBar label="Sincronización de Paquetes" value={100} variant="emerald" status="NOMINAL" />`;

const inputSnippet = `import Input from '@/components/Input.astro';

<Input
  label="Comando CLI"
  prefix="$"
  placeholder="ryukami-ui add button"
  hint="Ejecuta en tu terminal de confianza"
/>
<Input
  label="Host de Base de Datos"
  prefix="tcp://"
  placeholder="db.internal.botkeep.xyz"
  value="127.0.0.1:5432"
/>`;

const selectSliderSnippet = `import Select from '@/components/Select.astro';
import Slider from '@/components/Slider.astro';

<Select
  label="Motor de Compilación"
  prefix="ENGINE //"
  options={[
    { value: 'astro-7', label: 'Astro 7.4.0 (Vite 8 + Rolldown)' },
    { value: 'next-16', label: 'Next.js 16 App Router (Turbopack)' },
  ]}
/>

<Slider
  label="Potencia de Sombreado ASCII"
  min={0}
  max={100}
  value={75}
  unit="%"
  variant="crimson"
/>`;

const toggleSnippet = `import Checkbox from '@/components/Checkbox.astro';
import Switch from '@/components/Switch.astro';

<Checkbox
  label="Autenticación Cuántica"
  description="Requiere llave SSH ed25519 física"
  checked
/>
<Switch
  label="Vigilancia RF Activa"
  variant="crimson"
  checked
/>`;

const tabsSnippet = `import Tabs from '@/components/Tabs.astro';

<Tabs
  title="0xDEPLOY // TARGETS"
  tabs={[
    { id: 'astro', label: 'ASTRO 7.4', badge: 'DEFAULT', content: 'Compilación estática en 820ms con 0 KiB JS.', code: 'ryukami-ui init && ryukami-ui add --all' },
    { id: 'docker', label: 'DOCKER ALPINE', badge: 'PROD', content: 'Contenedor ligero en Botkeep Cloud.', code: 'docker compose up -d --build' },
  ]}
/>`;

const accordionSnippet = `import Accordion from '@/components/Accordion.astro';

<Accordion
  name="scorch-faq"
  items={[
    { title: '¿Por qué cero border-radius (0px)?', badge: 'DESIGN RULE #1', content: 'El Neo-Brutalismo puro elimina las curvas suaves para emular la precisión mecánica de terminales CRT y consolas industriales.', open: true },
    { title: '¿Cómo funciona la síntesis de sonido Web Audio?', badge: 'ZERO ASSETS', content: 'Los clics mecánicos se generan matemáticamente en tiempo real con osciladores triangulares y filtros pasa-banda sin descargar archivos MP3.' },
  ]}
/>`;

const alertSnippet = `import Alert from '@/components/Alert.astro';

<Alert variant="crimson" title="SOBRECALENTAMIENTO DE NÚCLEO">
  Frecuencia de CPU al 98%. Temperatura en 89°C. Se activan ventiladores secundarios.
</Alert>

<Alert variant="cyan" title="SISTEMA ACTUALIZADO">
  Núcleo actualizado exitosamente a Astro 7.4.0 y Tailwind CSS 4.3.3.
</Alert>`;

const avatarSkeletonSnippet = `import Avatar from '@/components/Avatar.astro';
import Skeleton from '@/components/Skeleton.astro';
import Kbd from '@/components/Kbd.astro';

<Avatar name="0xAlex // Architect" role="CORE LEAD" initials="0X" status="ONLINE" variant="crimson" />
<Skeleton lines={2} label="FETCHING_DRAGON_TELEMETRY" variant="cyan" />
<Kbd>Ctrl</Kbd> + <Kbd>K</Kbd>`;

const textareaRadioSnippet = `import Textarea from '@/components/Textarea.astro';
import RadioGroup from '@/components/RadioGroup.astro';

<Textarea label="Payload de Configuración" value="{\\n  \\"node\\": \\"scorch-02\\"\\n}" />
<RadioGroup
  label="Modo de Encriptación"
  name="cipher-mode"
  value="ed25519"
  options={[
    { value: 'ed25519', label: 'Ed25519 Quantum Key', badge: 'DEFAULT' },
    { value: 'rsa4096', label: 'RSA-4096 Legacy' },
  ]}
/>`;

const navPrimitivesSnippet = `import Breadcrumb from '@/components/Breadcrumb.astro';
import Pagination from '@/components/Pagination.astro';

<Breadcrumb
  items={[
    { label: 'ryukami-labs', href: '#hero' },
    { label: 'scorch-v4.1', href: '#components' },
    { label: '0xkernel.astro', active: true },
  ]}
/>
<Pagination currentPage={2} totalPages={8} />`;

const modalToastSnippet = `import Modal from '@/components/Modal.astro';
import Popover from '@/components/Popover.astro';
import Button from '@/components/Button.astro';

<Button variant="crimson" onclick="window.showToast('ALERT_CRITICAL', 'Pulso térmico detectado.', 'crimson')">
  Disparar Toast Carmesí
</Button>

<Popover id="node-popover" triggerLabel="INSPECCIONAR NODO (POPOVER)" title="0xNODE // TELEMETRY">
  <p>Popover nativo HTML5 Top-Layer sin JS externo.</p>
</Popover>

<Modal id="demo-modal" title="0xKERNEL // SYSTEM_DIAGNOSTIC" status="ROOT_ACCESS">
  <p>Diagnóstico cuántico completado sin anomalías.</p>
</Modal>`;

const installAstroSnippet = `# 1. Obtener el CLI desde el repositorio de GitHub (bin/ryukami-ui.mjs)
# Se instala en ~/.local/bin/ryukami-ui para usarlo como comando global:
git clone https://github.com/Alecwce/ryukami-ui.git ~/.local/share/ryukami-ui
ln -sf ~/.local/share/ryukami-ui/bin/ryukami-ui.mjs ~/.local/bin/ryukami-ui
chmod +x ~/.local/bin/ryukami-ui

# 2. Inicializar tokens CSS (Tailwind v4) y ryukami.json en tu proyecto
ryukami-ui init --dir ./mi-proyecto-astro

# 3. Listar los 27 componentes disponibles en el registro
ryukami-ui list

# 4. Instalar componentes específicos (resuelve dependencias automáticamente)
ryukami-ui add button card avatar skeleton textarea radio-group breadcrumb pagination popover --dir ./mi-proyecto-astro

# 5. O instalar los 27 componentes del catálogo de una sola vez
ryukami-ui add --all --dir ./mi-proyecto-astro`;
---

<BaseLayout
  title="🐉 Ryukami-UI // Retro TUI & Neo-Brutalism Component Library"
  description="Librería completa de 27 componentes retro TUI e instalador CLI inspirada en Velgrynd Scorch Lore para Astro 7 & Tailwind 4."
>

  <!-- 1. HERO SHOWCASE -->
  <section id="hero" class="space-y-6 text-center md:text-left">
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
      <Badge variant="crimson">v2.3.0 // 27 MODULES + CLI</Badge>
      <Badge variant="cyan">ASTRO 7.4 + TAILWIND 4.3</Badge>
      <Badge variant="gold">LIGHTHOUSE 96 / 100 / 100 / 100</Badge>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-2">
      <div class="lg:col-span-7 space-y-5">
        <h1 class="title-8bit text-3xl sm:text-5xl md:text-6xl">
          <span class="text-sky-700 dark:text-scorch-cyan">RYUKAMI</span>
          <span class="text-scorch-crimson">× SCORCH</span>
        </h1>

        <p class="subtitle-pixel text-base sm:text-xl md:text-2xl font-bold tracking-normal sm:tracking-widest">
          27 COMPONENTES RETRO TUI, CONSOLA EN VIVO &amp; CLI PARA LA WEB MODERNA
        </p>

        <p class="text-sm md:text-base leading-relaxed text-slate-800 dark:text-slate-200 max-w-xl">
          Inspirado en la estética hacker de consola, terminales CRT y el poder del dragón oriental carmesí. Cero bordes redondeados, controles de ventana interactivos, sombras sólidas hacia la izquierda-abajo y síntesis táctil Web Audio API.
        </p>

        <div class="flex flex-wrap gap-4 pt-2 justify-center md:justify-start">
          <Button variant="crimson" size="lg" href="#components">
            &gt; EXPLORAR 27 MÓDULOS
          </Button>
          <Button variant="cyan" size="lg" href="#live-shell">
            <Icon name="terminal" class="w-4 h-4 shrink-0 inline-block mr-1.5" />
            <span>0xSCORCH_SHELL</span>
          </Button>
          <Button variant="outline" size="lg" onclick="window.openPalette && window.openPalette()">
            <Icon name="command" class="w-4 h-4 shrink-0 inline-block mr-1.5" />
            <span>CMD+K</span>
          </Button>
        </div>
      </div>

      <!-- Banner Oficial Destacado (Optimizado WebP + CLS 0.000) -->
      <div class="lg:col-span-5">
        <Card title="OFFICIAL_BANNER // 16:9" status="4K READY">
          <picture>
            <source
              type="image/webp"
              srcset="/scorch-dragon-banner-480.webp 480w, /scorch-dragon-banner-800.webp 800w, /scorch-dragon-banner.webp 1376w"
              sizes="(max-width: 1024px) 92vw, 440px"
            />
            <img
              src="/scorch-dragon-banner.jpg"
              alt="Ryukami Scorch Dragon Banner"
              width="800"
              height="447"
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              class="w-full h-auto aspect-[800/447] border-2 border-black shadow-[-4px_4px_0px_#D62436]"
            />
          </picture>
          <div class="flex justify-between items-center text-xs font-bold pt-3 font-mono">
            <span>RYUKAMI × 5.5 // ART ASSET</span>
            <span class="text-scorch-gold-text dark:text-scorch-gold">VELGRYND EDITION</span>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- 2. QUICK INSTALL (CLI) -->
  <section class="tui-window">
    <div class="tui-header">
      <span>QUICK_START // RYUKAMI-UI CLI INSTALLER</span>
      <span>27 MODULES // /r/registry.json</span>
    </div>
    <div class="p-5 flex flex-col sm:flex-row gap-3 items-center">
      <div class="flex-1 w-full bg-slate-900 text-slate-100 p-3 border-2 border-black dark:border-slate-700 font-mono text-xs sm:text-sm flex items-center justify-between gap-2">
        <div class="truncate">
          <span class="text-scorch-crimson font-extrabold mr-2">$</span>
          <span>ryukami-ui init &amp;&amp; ryukami-ui add --all</span>
        </div>
        <a
          href="/r/registry.json"
          target="_blank"
          class="hidden md:inline-block bg-black text-scorch-cyan border border-slate-700 px-2 py-0.5 text-[10px] font-bold hover:bg-scorch-cyan hover:text-black shrink-0"
        >
          [JSON REGISTRY ↗]
        </a>
      </div>
      <Button
        variant="gold"
        size="md"
        onclick="navigator.clipboard.writeText('ryukami-ui init && ryukami-ui add --all'); window.showToast && window.showToast('CLI COPIADO', 'Comando copiado: ryukami-ui init && ryukami-ui add --all', 'emerald');"
      >
        COPIAR CLI
      </Button>
    </div>
  </section>

  <!-- BARRA DE SALTO RÁPIDO PARA MÓVILES / TABLETS -->
  <nav
    aria-label="Navegación rápida móvil"
    class="lg:hidden tui-window p-2.5 flex items-center gap-2 overflow-x-auto font-mono text-xs"
  >
    <span class="bg-black text-scorch-gold px-2 py-1 font-extrabold text-[10px] shrink-0">IR A:</span>
    <a href="#comp-button" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">01.Core</a>
    <a href="#comp-progress" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Progress</a>
    <a href="#comp-input" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">02.Forms</a>
    <a href="#comp-select" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Select/Slider</a>
    <a href="#comp-tabs" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">03.Tabs/Acc</a>
    <a href="#comp-alert" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Modals</a>
    <a href="#live-shell" class="px-2.5 py-1 border border-black bg-scorch-crimson text-white font-bold shrink-0">0xShell</a>
    <a href="#theme-studio" class="px-2.5 py-1 border border-black bg-scorch-cyan text-black font-bold shrink-0">Studio</a>
  </nav>

  <!-- ARQUITECTURA DE DOS COLUMNAS ESTILO 8BITCN / SHADCN (SIDEBAR + WORKSPACE) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Sidebar Lateral Fijo (Desktop) -->
    <div class="hidden lg:block lg:col-span-3 sticky top-28">
      <SidebarNav />
    </div>

    <!-- Columna Principal de Contenido -->
    <div class="lg:col-span-9 space-y-16 min-w-0">

  <!-- 3. COMPONENT CATALOG CON PESTAÑAS [PREVIEW | CODE] (ESTILO 8BITCN) -->
  <section id="components" class="space-y-12">
    
    <div class="flex items-center gap-2.5 sm:gap-4 min-w-0">
      <h2 class="subtitle-pixel text-base sm:text-2xl md:text-3xl font-bold tracking-tight sm:tracking-normal break-words min-w-0">// 01_NÚCLEO_TUI_Y_TELEMETRÍA</h2>
      <div class="h-0.5 bg-current flex-1 min-w-2"></div>
    </div>

    <!-- A) BOTONES MECÁNICOS -->
    <div id="comp-button" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Botones Mecánicos (Button.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Botones con física de pulsación mecánica hacia la izquierda-abajo y sonido táctil Web Audio API incorporado.
      </p>

      <ComponentPreview title="BUTTON_VARIANTS" code={buttonSnippet} status="5 STYLES" cli="ryukami-ui add button">
        <div class="flex flex-wrap items-center gap-4 py-2">
          <Button variant="crimson">Carmesí Scorch</Button>
          <Button variant="cyan">Cian Eléctrico</Button>
          <Button variant="gold">Oro Dragón</Button>
          <Button variant="dark">Modo Hacker</Button>
          <Button variant="outline">Contorno Paper</Button>
        </div>
      </ComponentPreview>
    </div>

    <!-- B) BADGES Y PASTILLAS TUI -->
    <div id="comp-badge" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-cyan border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Badges y Pastillas (Badge.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Etiquetas de estado de nodo, protocolos de red y categorías técnicas.
      </p>

      <ComponentPreview title="BADGE_STATUS" code={badgeSnippet} status="ASCII READY" cli="ryukami-ui add badge">
        <div class="flex flex-wrap items-center gap-3 py-2">
          <Badge variant="crimson">● SYSTEM_ALERT</Badge>
          <Badge variant="cyan">◆ RE_ENGINEERING</Badge>
          <Badge variant="gold">★ VELGRYND_CORE</Badge>
          <Badge variant="dark">TS TYPESCRIPT 7</Badge>
          <Badge variant="outline">POSTGRESQL 17</Badge>
        </div>
      </ComponentPreview>
    </div>

    <!-- C) VENTANAS TUI CON CONTROLES RETRO INTERACTIVOS -->
    <div id="comp-card" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Ventanas de Consola TUI Interactivas (Card.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Haz clic en los controles geométricos <code>[-]</code> para minimizar/restaurar la ventana, <code>[□]</code> para resaltar el borde o <code>[×]</code> para probar la protección del kernel.
      </p>

      <ComponentPreview title="TUI_WINDOW_CONSOLE" code={cardSnippet} status="INTERACTIVE" cli="ryukami-ui add card">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <Card title="0xSERVER // NODE_2" status="ONLINE">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Botkeep Cloud Container</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Contenedor asignado con 2 GB de RAM, PostgreSQL 17 y Redis 7.2 sin suspensión por inactividad.
              </p>
              <div class="pt-2">
                <Button variant="cyan" size="sm">INSPECCIONAR NODO</Button>
              </div>
            </div>
          </Card>

          <Card title="0xSENTINEL // FIELDWATCH" status="LISTENING">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Monitor Pasivo RF Android</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Escucha de balizas Wi-Fi y Bluetooth Low Energy (AirTags, Flipper Zero, drones con Remote ID).
              </p>
              <div class="pt-2">
                <Button variant="crimson" size="sm">VER LOGS DE RADIO</Button>
              </div>
            </div>
          </Card>
        </div>
      </ComponentPreview>
    </div>

    <!-- D) BARRAS DE PROGRESO Y TELEMETRÍA BIOS (NUEVO) -->
    <div id="comp-progress" class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-emerald-500 border border-black"></span>
          <h3 class="font-extrabold text-lg uppercase font-mono">Barras de Progreso BIOS &amp; ASCII (ProgressBar.astro)</h3>
        </div>
        <button
          type="button"
          id="simulate-telemetry-btn"
          class="btn-brutal bg-scorch-crimson text-white px-3 py-1 text-xs font-extrabold inline-flex items-center gap-1.5"
        >
          <Icon name="zap" class="w-3.5 h-3.5 shrink-0" />
          <span>SIMULAR PULSO DE TELEMETRÍA</span>
        </button>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Barras de carga segmentadas estilo monitor BIOS con lectura matricial <code>[████████░░░░]</code> sincronizada y animación en GPU (<code>scaleX</code>).
      </p>

      <ComponentPreview title="BIOS_PROGRESS_METERS" code={progressSnippet} status="GPU SCALEX" cli="ryukami-ui add progress-bar">
        <div class="space-y-5 w-full py-1" id="telemetry-demo-stack">
          <ProgressBar label="Núcleo Térmico Velgrynd" value={92} variant="crimson" status="8,940 °C" />
          <ProgressBar label="Memoria RAM Contenedor Node_2" value={64} variant="cyan" status="1.28 GB / 2.0 GB" />
          <ProgressBar label="Ancho de Banda Túnel WireGuard" value={78} variant="gold" status="940 Mbps" />
          <ProgressBar label="Integridad de Paquetes Astro 7" value={100} variant="emerald" status="NOMINAL" />
        </div>
      </ComponentPreview>
    </div>

    <!-- E) AVATARES DE OPERADOR, SKELETON BUFFERS Y TECLAS KBD (NUEVO) -->
    <div id="comp-avatar" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Avatares de Operador, Skeletons &amp; Teclas (Avatar.astro &amp; Skeleton.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Identificadores cuadrados de operador con indicador de estado en vivo, buffers de carga matricial ASCII y teclas mecánicas 3D.
      </p>

      <ComponentPreview title="OPERATOR_AVATARS_AND_BUFFERS" code={avatarSkeletonSnippet} status="TUI IDENTITY" cli="ryukami-ui add avatar skeleton kbd">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full py-2">
          <div class="space-y-3">
            <h4 class="font-extrabold text-xs uppercase text-slate-700 dark:text-slate-300">// Avatares de Operador</h4>
            <div class="flex flex-wrap gap-3">
              <Avatar name="0xAlex // Lead" role="ROOT ARCHITECT" initials="0X" status="ONLINE" variant="crimson" />
              <Avatar name="Velgrynd Core" role="AI SENTINEL" initials="VG" status="BUSY" variant="gold" />
              <Avatar name="Node_02 Relay" role="EDGE DAEMON" initials="N2" status="IDLE" variant="cyan" />
            </div>
            <div id="comp-kbd" class="pt-2 flex flex-wrap items-center gap-2 text-xs font-mono">
              <span class="font-bold text-slate-700 dark:text-slate-300">Atajos Kbd:</span>
              <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd>
              <span class="mx-1">|</span>
