---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import Kbd from '../components/Kbd.astro';
import Input from '../components/Input.astro';
import Checkbox from '../components/Checkbox.astro';
import Switch from '../components/Switch.astro';
import Alert from '../components/Alert.astro';
import ComponentPreview from '../components/ComponentPreview.astro';

// Snippets de código para el visor [Preview | Code]
const buttonSnippet = `import Button from '@/components/Button.astro';

<Button variant="crimson" size="md">Carmesí Scorch</Button>
<Button variant="cyan" size="md">Cian Eléctrico</Button>
<Button variant="gold" size="md">Oro Dragón</Button>
<Button variant="dark" size="md">Modo Hacker</Button>
<Button variant="outline" size="md">Contorno Paper</Button>`;

const badgeSnippet = `import Badge from '@/components/Badge.astro';

<Badge variant="crimson">● SYSTEM_ALERT</Badge>
<Badge variant="cyan">◆ REA_ENGINEERING</Badge>
<Badge variant="gold">★ VELGRYND_CORE</Badge>
<Badge variant="dark">TS TYPESCRIPT 7</Badge>
<Badge variant="outline">POSTGRESQL 17</Badge>`;

const cardSnippet = `import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';

<Card title="0xSERVER // NODE_2" status="ONLINE">
  <div class="space-y-3">
    <h4 class="font-extrabold text-base uppercase">Botkeep Cloud Container</h4>
    <p class="text-xs leading-relaxed opacity-80">
      Contenedor asignado con 2 GB de RAM, PostgreSQL 17 y Redis 7.2.
    </p>
    <Button variant="cyan" size="sm">INSPECCIONAR NODO</Button>
  </div>
</Card>`;

const inputSnippet = `import Input from '@/components/Input.astro';

<Input
  label="Comando CLI"
  prefix="$"
  placeholder="pnpm create scorch-app"
  hint="Ejecuta en tu terminal de confianza"
/>
<Input
  label="Host de Base de Datos"
  placeholder="db.internal.botkeep.xyz"
  value="127.0.0.1"
/>`;

const toggleSnippet = `import Checkbox from '@/components/Checkbox.astro';
import Switch from '@/components/Switch.astro';

<Checkbox
  label="Autenticación Cuántica"
  description="Requiere llave SSH ed25519 física"
  checked
/>
<Switch
  label="Vigilancia RF Activa"
  variant="crimson"
  checked
/>`;

const alertSnippet = `import Alert from '@/components/Alert.astro';

<Alert variant="crimson" title="SOBRECALENTAMIENTO DE NÚCLEO">
  Frecuencia de CPU al 98%. Temperatura en 89°C. Se activan ventiladores secundarios.
</Alert>

<Alert variant="cyan" title="SISTEMA ACTUALIZADO">
  Núcleo actualizado exitosamente a Astro 7.4.0 y Tailwind CSS 4.3.3.
</Alert>`;
---

<BaseLayout
  title="🐉 Ryukami-UI // Retro TUI & Neo-Brutalism Component Library"
  description="Librería de componentes retro TUI inspirada en Velgrynd Scorch Lore para Astro 7 & Tailwind 4."
>

  <!-- 1. HERO SHOWCASE -->
  <section class="space-y-6 text-center md:text-left">
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
      <Badge variant="crimson">v1.1.0 // FASE 1 ACTIVA</Badge>
      <Badge variant="cyan">ASTRO 7.4 + TAILWIND 4.3</Badge>
      <Badge variant="gold">VELGRYND LORE</Badge>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-2">
      <div class="lg:col-span-7 space-y-5">
        <h1 class="title-8bit text-4xl sm:text-5xl md:text-6xl">
          <span class="text-scorch-cyan">RYUKAMI</span>
          <span class="text-scorch-crimson">× SCORCH</span>
        </h1>

        <p class="subtitle-pixel text-xl sm:text-2xl font-bold tracking-widest opacity-90">
          COMPONENTES RETRO TUI &amp; NEO-BRUTALISMO PARA LA WEB MODERNA
        </p>

        <p class="text-sm md:text-base leading-relaxed opacity-80 max-w-xl">
          Inspirado en la estética hacker de consola, terminales CRT y el poder del dragón oriental carmesí. Cero bordes redondeados, sombras sólidas hacia la izquierda-abajo y retroalimentación táctil mecánica con Web Audio API.
        </p>

        <div class="flex flex-wrap gap-4 pt-2 justify-center md:justify-start">
          <Button variant="crimson" size="lg" href="#components">
            &gt; EXPLORAR COMPONENTES
          </Button>
          <Button variant="outline" size="lg" href="#forms">
            VER FORMULARIOS
          </Button>
        </div>
      </div>

      <!-- Banner Oficial Destacado -->
      <div class="lg:col-span-5">
        <Card title="OFFICIAL_BANNER // 16:9" status="4K READY">
          <img
            src="/scorch-dragon-banner.jpg"
            alt="Ryukami Scorch Dragon Banner"
            class="w-full h-auto border-2 border-black shadow-[-4px_4px_0px_#E63946]"
          />
          <div class="flex justify-between items-center text-xs font-bold pt-3 font-mono">
            <span>RYUKAMI × 5.5 // ART ASSET</span>
            <span class="text-scorch-gold">VELGRYND EDITION</span>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- 2. QUICK INSTALL (CLI) -->
  <section class="tui-window">
    <div class="tui-header">
      <span>QUICK_START // CLI INSTALL</span>
      <span>pnpm / npm</span>
    </div>
    <div class="p-5 flex flex-col sm:flex-row gap-3 items-center">
      <div class="flex-1 w-full bg-slate-900 text-slate-100 p-3 border-2 border-black dark:border-slate-700 font-mono text-xs sm:text-sm flex items-center">
        <span class="text-scorch-crimson font-extrabold mr-2">$</span>
        <span>pnpm create scorch-app --template=astro</span>
      </div>
      <Button variant="gold" size="md" onclick="navigator.clipboard.writeText('pnpm create scorch-app --template=astro'); alert('Comando copiado al portapapeles!');">
        COPIAR COMANDO
      </Button>
    </div>
  </section>

  <!-- 3. COMPONENT CATALOG CON PESTAÑAS [PREVIEW | CODE] (ESTILO 8BITCN) -->
  <section id="components" class="space-y-12">
    
    <div class="flex items-center gap-4">
      <h2 class="subtitle-pixel text-2xl sm:text-3xl font-bold">// 01_CATÁLOGO_DE_COMPONENTES</h2>
      <div class="h-0.5 bg-current flex-1"></div>
    </div>

    <!-- A) BOTONES MECÁNICOS -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Botones Mecánicos (Button.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Botones con física de pulsación mecánica hacia la izquierda-abajo y sonido táctil Web Audio API incorporado.
      </p>

      <ComponentPreview title="BUTTON_VARIANTS" code={buttonSnippet} status="5 STYLES">
        <div class="flex flex-wrap items-center gap-4 py-2">
          <Button variant="crimson">Carmesí Scorch</Button>
          <Button variant="cyan">Cian Eléctrico</Button>
          <Button variant="gold">Oro Dragón</Button>
          <Button variant="dark">Modo Hacker</Button>
          <Button variant="outline">Contorno Paper</Button>
        </div>
      </ComponentPreview>
    </div>

    <!-- B) BADGES Y PASTILLAS TUI -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-cyan border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Badges y Pastillas (Badge.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Etiquetas de estado de nodo, protocolos de red y categorías técnicas.
      </p>

      <ComponentPreview title="BADGE_STATUS" code={badgeSnippet} status="ASCII READY">
        <div class="flex flex-wrap items-center gap-3 py-2">
          <Badge variant="crimson">● SYSTEM_ALERT</Badge>
          <Badge variant="cyan">◆ REA_ENGINEERING</Badge>
          <Badge variant="gold">★ VELGRYND_CORE</Badge>
          <Badge variant="dark">TS TYPESCRIPT 7</Badge>
          <Badge variant="outline">POSTGRESQL 17</Badge>
        </div>
      </ComponentPreview>
    </div>

    <!-- C) VENTANAS TUI CON CONTROLES RETRO -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Ventanas de Consola TUI (Card.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Contenedores de información emulando ventanas de emulador de terminal retro con botones `[ _ ][ □ ][ × ]`.
      </p>

      <ComponentPreview title="TUI_WINDOW_CONSOLE" code={cardSnippet} status="ONLINE">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <Card title="0xSERVER // NODE_2" status="ONLINE">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Botkeep Cloud Container</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Contenedor asignado con 2 GB de RAM, PostgreSQL 17 y Redis 7.2 sin suspensión por inactividad.
              </p>
              <div class="pt-2">
                <Button variant="cyan" size="sm">INSPECCIONAR NODO</Button>
              </div>
            </div>
          </Card>

          <Card title="0xSENTINEL // FIELDWATCH" status="LISTENING">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Monitor Pasivo RF Android</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Escucha de balizas Wi-Fi y Bluetooth Low Energy (AirTags, Flipper Zero, drones con Remote ID).
              </p>
              <div class="pt-2">
                <Button variant="crimson" size="sm">VER LOGS DE RADIO</Button>
              </div>
            </div>
          </Card>
        </div>
      </ComponentPreview>
    </div>

  </section>

  <!-- 4. SUITE DE FORMULARIOS RETRO (NUEVO EN FASE 1) -->
  <section id="forms" class="space-y-12">
    <div class="flex items-center gap-4">
      <h2 class="subtitle-pixel text-2xl sm:text-3xl font-bold">// 02_SUITE_DE_FORMULARIOS</h2>
      <div class="h-0.5 bg-current flex-1"></div>
    </div>

    <!-- A) CAMPOS DE TEXTO (INPUT) -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Campos de Entrada (Input.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Inputs de texto brutalistas con prefijo de terminal, sombra hacia la izquierda y foco de alta visibilidad.
      </p>

      <ComponentPreview title="TEXT_INPUTS" code={inputSnippet} status="FORM CONTROLS">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <Input
            label="Comando de Terminal"
            prefix="$"
            placeholder="pnpm create scorch-app"
            hint="Ejecuta en tu terminal de confianza"
          />
          <Input
            label="Dirección de Host"
            prefix="tcp://"
            placeholder="node.scorch.internal"
            value="192.168.1.11:4321"
          />
          <Input
            label="Clave Maestra"
            type="password"
            placeholder="••••••••••••"
            hint="Token encriptado con SHA-256"
          />
          <Input
            label="Campo con Error de Validación"
            value="alexwce@invalid"
            error="Formato de correo o nodo no reconocido"
          />
        </div>
      </ComponentPreview>
    </div>

    <!-- B) CHECKBOXES Y SWITCHES -->
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-cyan border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Interruptores y Casillas (Switch &amp; Checkbox)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Casillas de selección cuadradas con marca pixel-art y deslizadores táctiles ON/OFF.
      </p>

      <ComponentPreview title="TOGGLES_AND_CHECKS" code={toggleSnippet} status="INTERACTIVE">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full py-2">
          <div class="space-y-4">
            <h4 class="font-extrabold text-xs uppercase opacity-70">// Checkboxes Cuadrados</h4>
            <div class="space-y-3">
              <Checkbox
                label="Permitir Conexiones SSH Cuánticas"
                description="Requiere llave criptográfica física"
                checked
              />
              <Checkbox
                label="Habilitar Registro Continuo en SQLite"
                description="Guarda historial de balizas en /var/log/scorch.db"
              />
              <Checkbox
                label="Opción Deshabilitada"
                description="Acceso restringido por el kernel del sistema"
                disabled
              />
            </div>
          </div>

          <div class="space-y-4">
            <h4 class="font-extrabold text-xs uppercase opacity-70">// Switches Deslizantes</h4>
            <div class="space-y-4">
              <div>
                <Switch label="Modo Scorch Carmesí" variant="crimson" checked />
              </div>
              <div>
                <Switch label="Monitoreo de Red Cian" variant="cyan" checked />
              </div>
              <div>
                <Switch label="Modo Oro de Emergencia" variant="gold" />
              </div>
            </div>
          </div>
        </div>
      </ComponentPreview>
    </div>

  </section>

  <!-- 5. FEEDBACK Y ALERTAS (NUEVO EN FASE 1) -->
  <section id="alerts" class="space-y-12">
    <div class="flex items-center gap-4">
      <h2 class="subtitle-pixel text-2xl sm:text-3xl font-bold">// 03_FEEDBACK_Y_ALERTAS</h2>
      <div class="h-0.5 bg-current flex-1"></div>
    </div>

    <div class="space-y-4">
      <p class="text-xs sm:text-sm opacity-80">
        Callouts y cajas de advertencia brutalistas con indicadores de estado de severidad.
      </p>

      <ComponentPreview title="SYSTEM_ALERTS" code={alertSnippet} status="CALLOUTS">
        <div class="space-y-4 w-full">
          <Alert variant="crimson" title="SOBRECALENTAMIENTO DE NÚCLEO">
            Frecuencia de CPU al 98%. Temperatura en 89°C. Se activan ventiladores secundarios de enfriamiento.
          </Alert>

          <Alert variant="gold" title="ADVERTENCIA DE CERTIFICADO TLS">
            El certificado para `*.scorch.dev` expira en 7 días. Se recomienda renovar mediante certbot.
          </Alert>

          <Alert variant="cyan" title="SISTEMA ACTUALIZADO">
            Núcleo actualizado exitosamente a Astro 7.4.0 y Tailwind CSS 4.3.3. Rendimiento nominal del 100%.
          </Alert>

          <Alert variant="emerald" title="CONEXIÓN SEGURA ESTABLECIDA">
            Túnel SSH y socket Web Audio inicializados correctamente sin pérdida de paquetes.
          </Alert>
        </div>
      </ComponentPreview>
    </div>
  </section>

  <!-- 6. TABLA DE DATOS TUI -->
  <section class="space-y-4">
    <div class="flex items-center gap-4">
      <h2 class="subtitle-pixel text-2xl sm:text-3xl font-bold">// 04_REGISTRO_TUI_ASCII</h2>
      <div class="h-0.5 bg-current flex-1"></div>
    </div>

    <div class="tui-window overflow-x-auto">
      <div class="tui-header">
        <span>ACTIVE_SERVICES_REGISTRY</span>
        <span>4 NODOS OPERATIVOS</span>
      </div>
      <table class="w-full border-collapse font-mono text-xs">
        <thead>
          <tr class="bg-black text-white dark:bg-scorch-crimson border-b-2 border-black">
            <th class="p-3 text-left">Módulo</th>
            <th class="p-3 text-left">Protocolo</th>
            <th class="p-3 text-left">Uptime</th>
            <th class="p-3 text-left">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/20 dark:divide-white/20">
          <tr class="hover:bg-scorch-crimson/10">
            <td class="p-3 font-bold">PostgreSQL 17</td>
            <td class="p-3">tcp://5432</td>
            <td class="p-3">99.98%</td>
            <td class="p-3"><Badge variant="cyan">● ONLINE</Badge></td>
          </tr>
          <tr class="hover:bg-scorch-crimson/10">
            <td class="p-3 font-bold">Redis 7.2 LTS</td>
            <td class="p-3">tcp://6379</td>
            <td class="p-3">100.0%</td>
            <td class="p-3"><Badge variant="cyan">● ONLINE</Badge></td>
          </tr>
          <tr class="hover:bg-scorch-crimson/10">
            <td class="p-3 font-bold">DevLink Shortener</td>
            <td class="p-3">https://devlink.bot-keep.xyz</td>
            <td class="p-3">99.95%</td>
            <td class="p-3"><Badge variant="gold">● ACTIVE</Badge></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 7. ATAJOS DE TECLADO KBD -->
  <section class="space-y-4 pb-8">
    <Card title="KEYBOARD_SHORTCUTS" status="ACCESSIBILITY">
      <div class="flex flex-wrap items-center gap-4 text-xs font-mono">
        <div class="flex items-center gap-1.5">
          <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd> <span>Abrir Paleta de Comandos</span>
        </div>
        <div class="flex items-center gap-1.5">
          <Kbd>Ctrl</Kbd> + <Kbd>D</Kbd> <span>Cambiar Modo Claro/Oscuro</span>
        </div>
        <div class="flex items-center gap-1.5">
          <Kbd>Esc</Kbd> <span>Cerrar Modales Activos</span>
        </div>
      </div>
    </Card>
  </section>

</BaseLayout>
