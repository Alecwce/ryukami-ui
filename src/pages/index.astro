---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import Kbd from '../components/Kbd.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Input from '../components/Input.astro';
import Select from '../components/Select.astro';
import Slider from '../components/Slider.astro';
import Checkbox from '../components/Checkbox.astro';
import Switch from '../components/Switch.astro';
import Tabs from '../components/Tabs.astro';
import Accordion from '../components/Accordion.astro';
import Alert from '../components/Alert.astro';
import Modal from '../components/Modal.astro';
import Popover from '../components/Popover.astro';
import Avatar from '../components/Avatar.astro';
import Skeleton from '../components/Skeleton.astro';
import Textarea from '../components/Textarea.astro';
import RadioGroup from '../components/RadioGroup.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Pagination from '../components/Pagination.astro';
import TerminalEmulator from '../components/TerminalEmulator.astro';
import ComponentPreview from '../components/ComponentPreview.astro';
import SidebarNav from '../components/SidebarNav.astro';
import ThemeStudio from '../components/ThemeStudio.astro';
import AsciiGenerator from '../components/AsciiGenerator.astro';
import Icon from '../components/Icon.astro';
import StatCard from '../components/StatCard.astro';
import Tooltip from '../components/Tooltip.astro';
import Callout from '../components/Callout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Drawer from '../components/Drawer.astro';
import CodeBlock from '../components/CodeBlock.astro';
import AudioSynth from '../components/AudioSynth.astro';
import DataTable from '../components/DataTable.astro';
import {
  buttonProps,
  badgeProps,
  cardProps,
  progressProps,
  avatarSkeletonProps,
  inputProps,
  selectSliderProps,
  toggleProps,
  textareaRadioProps,
  tabsProps,
  accordionProps,
  navPrimitivesProps,
  alertProps,
  modalToastProps,
  statCardTooltipProps,
  calloutBentoProps,
  drawerCodeSynthProps,
  dataTableProps,
} from '../data/component-props';
import {
  buttonSnippet,
  badgeSnippet,
  cardSnippet,
  progressSnippet,
  inputSnippet,
  selectSliderSnippet,
  toggleSnippet,
  tabsSnippet,
  accordionSnippet,
  alertSnippet,
  avatarSkeletonSnippet,
  textareaRadioSnippet,
  navPrimitivesSnippet,
  modalToastSnippet,
  statCardTooltipSnippet,
  calloutBentoSnippet,
  drawerCodeSynthSnippet,
  dataTableSnippet,
  installAstroSnippet,
} from '../data/component-snippets';
---

<BaseLayout
  title="Ryukami-UI"
  description="Librería de 35 componentes Neo-Brutalistas y Retro TUI, servidor MCP e instalador CLI para Astro 7 y Tailwind CSS 4."
>

  <!-- 1. HERO SHOWCASE (ESTILO 8BITCN / SHADCN) -->
  <section id="hero" class="space-y-6 text-center md:text-left">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5">
        <h1 class="title-8bit text-3xl sm:text-5xl md:text-6xl">
          <span class="text-sky-700 dark:text-scorch-cyan">RYUKAMI</span>
          <span class="text-scorch-crimson">× SCORCH</span>
        </h1>

        <p class="subtitle-pixel text-base sm:text-xl md:text-2xl font-bold tracking-normal sm:tracking-widest">
          RETRO TUI &amp; NEO-BRUTALIST UI LIBRARY
        </p>

        <p class="text-sm md:text-base leading-relaxed text-slate-800 dark:text-slate-200 max-w-xl">
          Componentes TUI, bloques modulares y consola interactiva para aplicaciones web modernas. Open source. Copy-paste o CLI.
        </p>

        <div class="flex flex-wrap gap-4 pt-2 justify-center md:justify-start">
          <Button variant="crimson" size="lg" href="/docs">
            OPEN DOCS
          </Button>
          <Button variant="cyan" size="lg" href="/docs/components">
            EXPLORE COMPONENTS
          </Button>
          <Button variant="outline" size="lg" href="/blocks">
            EXPLORE BLOCKS
          </Button>
        </div>
      </div>

      <!-- Banner Oficial Destacado (Optimizado WebP + CLS 0.000) -->
      <div class="lg:col-span-5">
        <Card title="OFFICIAL_BANNER // 16:9" status="4K READY">
          <picture>
            <source
              type="image/webp"
              srcset="/scorch-dragon-banner-480.webp 480w, /scorch-dragon-banner-800.webp 800w, /scorch-dragon-banner.webp 1376w"
              sizes="(max-width: 1024px) 92vw, 440px"
            />
            <img
              src="/scorch-dragon-banner.jpg"
              alt="Ryukami Scorch Dragon Banner"
              width="800"
              height="447"
              fetchpriority="high"
              loading="eager"
              decoding="sync"
              class="w-full h-auto aspect-[800/447] border-2 border-black shadow-[-4px_4px_0px_#D62436]"
            />
          </picture>
          <div class="flex justify-between items-center text-xs font-bold pt-3 font-mono">
            <span>RYUKAMI × 5.5 // ART ASSET</span>
            <span class="text-scorch-gold-text dark:text-scorch-gold">VELGRYND EDITION</span>
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- 2. QUICK INSTALL (CLI) -->
  <section id="quickstart" class="tui-window">
    <div class="tui-header">
      <span>QUICK_START // RYUKAMI-UI CLI INSTALLER</span>
      <span>35 MODULES // /r/registry.json</span>
    </div>
    <div class="p-5 flex flex-col sm:flex-row gap-3 items-center">
      <div class="flex-1 w-full bg-slate-900 text-slate-100 p-3 border-2 border-black dark:border-slate-700 font-mono text-xs sm:text-sm flex items-center justify-between gap-2">
        <div class="truncate">
          <span class="text-scorch-crimson font-extrabold mr-2">$</span>
          <span>ryukami-ui init &amp;&amp; ryukami-ui add --all</span>
        </div>
        <a
          href="/r/registry.json"
          target="_blank"
          class="hidden md:inline-block bg-black text-scorch-cyan border border-slate-700 px-2 py-0.5 text-[10px] font-bold hover:bg-scorch-cyan hover:text-black shrink-0"
        >
          [JSON REGISTRY]
        </a>
      </div>
      <Button
        variant="gold"
        size="md"
        onclick="navigator.clipboard.writeText('ryukami-ui init && ryukami-ui add --all'); window.showToast && window.showToast('CLI COPIADO', 'Comando copiado: ryukami-ui init && ryukami-ui add --all', 'emerald');"
      >
        COPIAR CLI
      </Button>
    </div>
  </section>

  <!-- BARRA DE NAVEGACIÓN RÁPIDA MÓVIL (Oculta en Desktop) -->
  <nav
    aria-label="Navegación rápida móvil"
    class="md:hidden tui-window p-2.5 flex items-center gap-1.5 overflow-x-auto font-mono text-xs"
  >
    <a href="/docs" class="px-2.5 py-1 border border-black bg-scorch-crimson text-white font-bold shrink-0">Docs</a>
    <a href="/docs/components" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Components</a>
    <a href="/blocks" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Blocks</a>
    <a href="/blocks#shell" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Shell</a>
    <a href="/themes" class="px-2.5 py-1 border border-black dark:border-slate-600 bg-slate-100 dark:bg-slate-800 font-bold shrink-0">Themes</a>
  </nav>

  <!-- ARQUITECTURA DE DOS COLUMNAS ESTILO 8BITCN / SHADCN (SIDEBAR + WORKSPACE) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Sidebar Lateral Fijo (Desktop sincronizado bajo Header) -->
    <div class="hidden lg:block lg:col-span-3 sticky top-[86px]">
      <SidebarNav />
    </div>

    <!-- Columna Principal de Contenido Simétrica -->
    <div class="lg:col-span-9 space-y-12 min-w-0">

  <!-- 3. COMPONENT CATALOG CON PESTAÑAS [PREVIEW | CODE] (ESTILO 8BITCN) -->
  <section id="components" class="tui-window overflow-hidden shadow-brutal">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white flex flex-wrap justify-between items-center gap-2 px-4 py-2.5">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 bg-scorch-gold border border-black inline-block shrink-0"></span>
        <h2 class="font-pixel text-xs sm:text-sm tracking-wider uppercase text-white truncate">// 01_NUCLEO &amp; TELEMETRIA TUI</h2>
      </div>
      <span class="font-mono text-[10px] bg-black text-scorch-cyan border border-slate-700 px-2 py-0.5 font-bold shrink-0">
        6 PREVIEWS // 9 COMPONENTES
      </span>
    </div>
    <div class="p-4 sm:p-6 space-y-10 bg-white dark:bg-slate-900/60">

    <!-- A) BOTONES MECÁNICOS -->
    <div id="comp-button" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Botones Mecánicos (Button.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Botones con física de pulsación mecánica hacia la izquierda-abajo y sonido táctil Web Audio API incorporado.
      </p>

      <ComponentPreview title="BUTTON_VARIANTS" code={buttonSnippet} status="5 STYLES" cli="ryukami-ui add button" propsDoc={buttonProps}>
        <div class="flex flex-wrap items-center gap-4 py-2">
          <Button variant="crimson">Carmesí Scorch</Button>
          <Button variant="cyan">Cian Eléctrico</Button>
          <Button variant="gold">Oro Dragón</Button>
          <Button variant="dark">Modo Hacker</Button>
          <Button variant="outline">Contorno Paper</Button>
        </div>
      </ComponentPreview>
    </div>

    <!-- B) BADGES Y PASTILLAS TUI -->
    <div id="comp-badge" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-cyan border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Badges y Pastillas (Badge.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Etiquetas de estado de nodo, protocolos de red y categorías técnicas.
      </p>

      <ComponentPreview title="BADGE_STATUS" code={badgeSnippet} status="ASCII READY" cli="ryukami-ui add badge" propsDoc={badgeProps}>
        <div class="flex flex-wrap items-center gap-3 py-2">
          <Badge variant="crimson">● SYSTEM_ALERT</Badge>
          <Badge variant="cyan">◆ RE_ENGINEERING</Badge>
          <Badge variant="gold">★ VELGRYND_CORE</Badge>
          <Badge variant="dark">TS TYPESCRIPT 7</Badge>
          <Badge variant="outline">POSTGRESQL 17</Badge>
        </div>
      </ComponentPreview>
    </div>

    <!-- C) VENTANAS TUI CON CONTROLES RETRO INTERACTIVOS -->
    <div id="comp-card" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Ventanas de Consola TUI Interactivas (Card.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Haz clic en los controles geométricos <code>[-]</code> para minimizar/restaurar la ventana, <code>[□]</code> para resaltar el borde o <code>[×]</code> para probar la protección del kernel.
      </p>

      <ComponentPreview title="TUI_WINDOW_CONSOLE" code={cardSnippet} status="INTERACTIVE" cli="ryukami-ui add card" propsDoc={cardProps}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <Card title="0xSERVER // NODE_2" status="ONLINE">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Botkeep Cloud Container</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Contenedor asignado con 2 GB de RAM, PostgreSQL 17 y Redis 7.2 sin suspensión por inactividad.
              </p>
              <div class="pt-2">
                <Button variant="cyan" size="sm">INSPECCIONAR NODO</Button>
              </div>
            </div>
          </Card>

          <Card title="0xSENTINEL // FIELDWATCH" status="LISTENING">
            <div class="space-y-3">
              <h4 class="font-extrabold text-base uppercase">Monitor Pasivo RF Android</h4>
              <p class="text-xs leading-relaxed opacity-80">
                Escucha de balizas Wi-Fi y Bluetooth Low Energy (AirTags, Flipper Zero, drones con Remote ID).
              </p>
              <div class="pt-2">
                <Button variant="crimson" size="sm">VER LOGS DE RADIO</Button>
              </div>
            </div>
          </Card>
        </div>
      </ComponentPreview>
    </div>

    <!-- D) BARRAS DE PROGRESO Y TELEMETRÍA BIOS (NUEVO) -->
    <div id="comp-progress" class="space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 bg-emerald-500 border border-black"></span>
          <h3 class="font-extrabold text-lg uppercase font-mono">Barras de Progreso BIOS &amp; ASCII (ProgressBar.astro)</h3>
        </div>
        <button
          type="button"
          id="simulate-telemetry-btn"
          class="btn-brutal bg-scorch-crimson text-white px-3 py-1 text-xs font-extrabold inline-flex items-center gap-1.5"
        >
          <Icon name="zap" class="w-3.5 h-3.5 shrink-0" />
          <span>SIMULAR PULSO DE TELEMETRÍA</span>
        </button>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Barras de carga segmentadas estilo monitor BIOS con lectura matricial <code>[████████░░░░]</code> sincronizada y animación en GPU (<code>scaleX</code>).
      </p>

      <ComponentPreview title="BIOS_PROGRESS_METERS" code={progressSnippet} status="GPU SCALEX" cli="ryukami-ui add progress-bar" propsDoc={progressProps}>
        <div class="space-y-5 w-full py-1" id="telemetry-demo-stack">
          <ProgressBar label="Núcleo Térmico Velgrynd" value={92} variant="crimson" status="8,940 °C" />
          <ProgressBar label="Memoria RAM Contenedor Node_2" value={64} variant="cyan" status="1.28 GB / 2.0 GB" />
          <ProgressBar label="Ancho de Banda Túnel WireGuard" value={78} variant="gold" status="940 Mbps" />
          <ProgressBar label="Integridad de Paquetes Astro 7" value={100} variant="emerald" status="NOMINAL" />
        </div>
      </ComponentPreview>
    </div>

    <!-- E) AVATARES DE OPERADOR, SKELETON BUFFERS Y TECLAS KBD (NUEVO) -->
    <div id="comp-avatar" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Avatares de Operador, Skeletons &amp; Teclas (Avatar.astro &amp; Skeleton.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Identificadores cuadrados de operador con indicador de estado en vivo, buffers de carga matricial ASCII y teclas mecánicas 3D.
      </p>

      <ComponentPreview title="OPERATOR_AVATARS_AND_BUFFERS" code={avatarSkeletonSnippet} status="TUI IDENTITY" cli="ryukami-ui add avatar skeleton kbd" propsDoc={avatarSkeletonProps}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full py-2">
          <div class="space-y-3">
            <h4 class="font-extrabold text-xs uppercase text-slate-700 dark:text-slate-300">// Avatares de Operador</h4>
            <div class="flex flex-wrap gap-3">
              <Avatar name="0xAlex // Lead" role="ROOT ARCHITECT" initials="0X" status="ONLINE" variant="crimson" />
              <Avatar name="Velgrynd Core" role="AI SENTINEL" initials="VG" status="BUSY" variant="gold" />
              <Avatar name="Node_02 Relay" role="EDGE DAEMON" initials="N2" status="IDLE" variant="cyan" />
            </div>
            <div id="comp-kbd" class="pt-2 flex flex-wrap items-center gap-2 text-xs font-mono">
              <span class="font-bold text-slate-700 dark:text-slate-300">Atajos Kbd:</span>
              <Kbd>Ctrl</Kbd> + <Kbd>K</Kbd>
              <span class="mx-1">|</span>
              <Kbd>Ctrl</Kbd> + <Kbd>D</Kbd>
              <span class="mx-1">|</span>
              <Kbd>Esc</Kbd>
            </div>
          </div>

          <div class="space-y-3">
            <h4 class="font-extrabold text-xs uppercase text-slate-700 dark:text-slate-300">// Buffers de Carga (Skeleton.astro)</h4>
            <Skeleton lines={2} label="SYNCING_SCORCH_REGISTRY" variant="crimson" />
            <Skeleton lines={1} label="DECRYPTING_SSH_HANDSHAKE" variant="cyan" showAscii={false} />
          </div>
        </div>
      </ComponentPreview>
    </div>

    <!-- F) TARJETAS KPI STATCARD Y TOOLTIPS TUI (NUEVO v2.4) -->
    <div id="comp-statcard" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Tarjetas KPI &amp; Tooltips TUI (StatCard.astro &amp; Tooltip.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Tarjetas de telemetría cuantitativa con sparklines ASCII <code>[▁▂▃▅▆▇█]</code> y tooltips emergentes accesibles por teclado y hover sin dependencias JS.
      </p>

      <ComponentPreview title="STAT_CARDS_AND_TOOLTIPS" code={statCardTooltipSnippet} status="KPI & TOOLTIP" cli="ryukami-ui add stat-card tooltip" propsDoc={statCardTooltipProps}>
        <div class="space-y-5 w-full py-2">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <StatCard label="LATENCIA_EDGE" value="11.4 ms" delta="-18.2%" trend="up" sparkline="▇▆▅▃▂▁▁" variant="cyan" />
            <StatCard label="THROUGHPUT_RPS" value="48,920" delta="+24.5%" trend="up" sparkline="▁▂▃▄▆▇█" variant="crimson" />
            <StatCard label="REGISTRY_SHA256" value="35 MODS" delta="VERIFIED" trend="neutral" sparkline="███████" variant="gold" />
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-2 border-t-2 border-black/15 dark:border-white/15">
            <span class="text-xs font-extrabold uppercase text-slate-700 dark:text-slate-300">// Pasa el cursor o enfoca con Tab:</span>
            <Tooltip text="Contraste WCAG AA: 5.04:1 sobre #FFFFFF" variant="crimson">
              <Badge variant="crimson">HOVER: #D62436 WCAG</Badge>
            </Tooltip>
            <Tooltip text="Servidor MCP JSON-RPC 2.0 en stdio" variant="cyan">
              <Badge variant="cyan">HOVER: RYUKAMI-UI MCP</Badge>
            </Tooltip>
            <Tooltip text="Sincronizado con bóveda Obsidian v4.1" variant="gold" position="bottom">
              <Badge variant="gold">HOVER: OBSIDIAN SYNC</Badge>
            </Tooltip>
          </div>
        </div>
      </ComponentPreview>
    </div>
    </div>
  </section>

  <!-- 4. SUITE DE FORMULARIOS RETRO -->
  <section id="forms" class="tui-window overflow-hidden shadow-brutal">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white flex flex-wrap justify-between items-center gap-2 px-4 py-2.5">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 bg-scorch-cyan border border-black inline-block shrink-0"></span>
        <h2 class="font-pixel text-xs sm:text-sm tracking-wider uppercase text-white truncate">// 02_SUITE DE FORMULARIOS</h2>
      </div>
      <span class="font-mono text-[10px] bg-black text-scorch-gold border border-slate-700 px-2 py-0.5 font-bold shrink-0">
        4 PREVIEWS // 7 CONTROLES TUI
      </span>
    </div>
    <div class="p-4 sm:p-6 space-y-10 bg-white dark:bg-slate-900/60">

    <!-- A) CAMPOS DE TEXTO (INPUT) -->
    <div id="comp-input" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-crimson border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Campos de Entrada (Input.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Inputs de texto brutalistas con prefijo de terminal, sombra hacia la izquierda y foco de alta visibilidad.
      </p>

      <ComponentPreview title="TEXT_INPUTS" code={inputSnippet} status="FORM CONTROLS" cli="ryukami-ui add input" propsDoc={inputProps}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <Input
            label="Comando de Terminal"
            prefix="$"
            placeholder="ryukami-ui add button"
            hint="Ejecuta en tu terminal de confianza"
          />
          <Input
            label="Dirección de Host"
            prefix="tcp://"
            placeholder="node.scorch.internal"
            value="192.168.1.11:4321"
          />
          <Input
            label="Clave Maestra"
            type="password"
            placeholder="••••••••••••"
            hint="Token cifrado con SHA-256"
          />
          <Input
            label="Campo con Error de Validación"
            value="alexwce@invalid"
            error="Formato de correo o nodo no reconocido"
          />
        </div>
      </ComponentPreview>
    </div>

    <!-- B) SELECTORES DESPLEGABLES Y SLIDERS ASCII (NUEVO) -->
    <div id="comp-select" class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-scorch-gold border border-black"></span>
        <h3 class="font-extrabold text-lg uppercase font-mono">Selectores TUI &amp; Sliders ASCII (Select.astro &amp; Slider.astro)</h3>
      </div>
      <p class="text-xs sm:text-sm opacity-80">
        Listas desplegables con indicador mecánico y sliders de rango con barra de progreso en caracteres ASCII <code>[========|-------]</code> en tiempo real.
      </p>

      <ComponentPreview title="SELECT_AND_ASCII_SLIDER" code={selectSliderSnippet} status="INTERACTIVE" cli="ryukami-ui add select slider" propsDoc={selectSliderProps}>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full py-2">
          <div class="space-y-4">
            <Select
              label="Arquitectura de Despliegue"
              prefix="STACK //"
              value="astro-7"
              hint="Selecciona el motor de renderizado objetivo"
              options={[
                { value: 'astro-7', label: 'Astro 7.4.0 (Static SSG + Rolldown)' },
                { value: 'next-16', label: 'Next.js 16 (App Router + Tailwind 4)' },
                { value: 'tauri-2', label: 'Tauri 2.1 + Rust Native Desktop' },
              ]}
            />
            <Select
              label="Región del Nodo Cloud"
              prefix="NODE //"
              value="eu-south"
              options={[
                { value: 'eu-south', label: 'Italia // Node_02 (PostgreSQL 17)' },
