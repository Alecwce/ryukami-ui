---
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ToastContainer from '../components/ToastContainer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '⚡ Ryukami-UI // Retro TUI & Neo-Brutalism Library',
  description = 'Librería de componentes retro TUI y Neo-Brutalismo inspirada en Velgrynd Scorch Lore para Astro & Web.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="light scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Preload LCP Banner Asset (WebP) -->
  <link
    rel="preload"
    as="image"
    href="/scorch-dragon-banner-800.webp"
    imagesrcset="/scorch-dragon-banner-480.webp 480w, /scorch-dragon-banner-800.webp 800w, /scorch-dragon-banner.webp 1376w"
    imagesizes="(max-width: 1024px) 92vw, 440px"
    type="image/webp"
    fetchpriority="high"
  />

  <!-- Google Fonts Non-Blocking Load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;0,800;1,400&family=Press+Start+2P&family=Tiny5&family=VT323&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,700;0,800;1,400&family=Press+Start+2P&family=Tiny5&family=VT323&display=swap"
    />
  </noscript>
</head>
<body class="p-4 md:p-8 max-w-6xl mx-auto space-y-12">
  <Header />

  <main class="space-y-16">
    <slot />
  </main>

  <footer class="text-center text-xs font-bold text-slate-700 dark:text-slate-300 pb-8 space-y-1 border-t-2 border-black dark:border-slate-800 pt-8">
    <p>⚡ RYUKAMI-UI // SCORCH DRAGON SYSTEM (VELGRYND TRIBUTE EDITION)</p>
    <p>Neo-Brutalism + Retro TUI CLI + 8-Bit Matrix. MIT License 2026. Made with Astro &amp; Tailwind CSS.</p>
  </footer>

  <!-- Modales y Notificaciones Globales (Fase 2) -->
  <CommandPalette />
  <ToastContainer />

  <!-- Script de Audio y Tema Global -->
  <script is:inline>
    // Inicializar Tema
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
      actualizarBotonTema(true);
    } else {
      document.documentElement.classList.remove('dark');
      actualizarBotonTema(false);
    }

    window.toggleTheme = function() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      actualizarBotonTema(isDark);
      if (window.playTerminalBeep) window.playTerminalBeep(isDark ? 600 : 900, 0.08);
    };

    function actualizarBotonTema(isDark) {
      const label = document.getElementById('theme-label');
      const icon = document.getElementById('theme-icon');
      if (label && icon) {
        label.innerText = isDark ? 'HACKER' : 'PAPER';
        icon.innerText = isDark ? '🌙' : '☀️';
      }
    }

    // Web Audio API Synthesis
    let audioCtx = null;
    let soundEnabled = true;

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    window.playMechanicalClick = function() {
      if (!soundEnabled) return;
      try {
        initAudio();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const filter = audioCtx.createBiquadFilter();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(45, now + 0.03);

        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1400, now);
        filter.Q.setValueAtTime(2.0, now);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(now);
        osc.stop(now + 0.03);
      } catch (e) {}
    };

    window.playTerminalBeep = function(freq = 880, duration = 0.05) {
      if (!soundEnabled) return;
      try {
        initAudio();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'square';
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(now);
        osc.stop(now + duration);
      } catch (e) {}
    };

    window.toggleSound = function() {
      soundEnabled = !soundEnabled;
      const icon = document.getElementById('sound-icon');
      const label = document.getElementById('sound-label');
      if (icon && label) {
        icon.innerText = soundEnabled ? '🔊' : '🔇';
        label.innerText = soundEnabled ? 'SND: ON' : 'SND: OFF';
      }
    };

    // Enganchar sonido de click a botones
    document.addEventListener('click', (e) => {
      if (e.target.closest('.btn-brutal') || e.target.closest('button')) {
        window.playMechanicalClick();
      }
    });
  </script>
</body>
</html>
