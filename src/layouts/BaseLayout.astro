---
import Header from '../components/Header.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ToastContainer from '../components/ToastContainer.astro';
import Font from 'astro/components/Font.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ryukami-UI // Retro TUI & Neo-Brutalism Library',
  description = 'Librería de componentes retro TUI y Neo-Brutalismo inspirada en Velgrynd Scorch Lore para Astro & Web.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="light scroll-smooth" style="scroll-padding-top: 7.5rem;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="https://ryukami-ui.pages.dev/" />

  <!-- Theme Color & Mobile Browser Bar (Item 7) -->
  <meta name="theme-color" content="#D62436" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0F17" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F5F7FA" />

  <!-- Open Graph / Facebook (Item 7) -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://ryukami-ui.pages.dev/" />
  <meta property="og:site_name" content="Ryukami-UI" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://ryukami-ui.pages.dev/scorch-dragon-banner.jpg" />
  <meta property="og:image:width" content="1376" />
  <meta property="og:image:height" content="768" />
  <meta property="og:image:alt" content="Ryukami-UI // Retro TUI & Neo-Brutalism Component Library" />

  <!-- Twitter Card (Item 7) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://ryukami-ui.pages.dev/" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://ryukami-ui.pages.dev/scorch-dragon-banner.jpg" />
  <meta name="twitter:image:alt" content="Ryukami-UI // Retro TUI & Neo-Brutalism Component Library" />

  <!-- Built-in Fonts API (Astro 7.4) - Fuentes servidas localmente desde el mismo origen (self) -->
  <Font cssVariable="--font-pixel" preload />
  <Font cssVariable="--font-sub" />
  <Font cssVariable="--font-mono" />
  <Font cssVariable="--font-vt323" />
</head>
<body class="p-3 sm:p-4 md:p-8 pt-0 sm:pt-0 md:pt-0 max-w-6xl mx-auto space-y-8 sm:space-y-12">
  <!-- Enlace de salto accesible para navegación por teclado (Vercel Web Interface Guidelines) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-scorch-crimson focus:text-white focus:border-2 focus:border-black focus:shadow-brutal focus:font-mono focus:text-xs focus:font-extrabold focus:outline-none"
  >
    &gt; [ SALTAR AL CONTENIDO PRINCIPAL ]
  </a>

  <!-- Barra de Progreso de Lectura Superior (100% GPU scaleX) -->
  <div class="fixed top-0 left-0 right-0 h-1 bg-black/20 z-50 pointer-events-none" aria-hidden="true">
    <div
      id="scorch-scroll-bar"
      class="h-full bg-scorch-crimson origin-left"
      style="transform: scaleX(0);"
    ></div>
  </div>

  <Header />

  <main id="main-content" class="space-y-16">
    <slot />
  </main>

  <footer class="tui-window p-6 text-xs font-mono space-y-4">
    <div class="flex flex-wrap justify-between items-center gap-4 border-b-2 border-black/20 dark:border-white/20 pb-4">
      <div class="flex items-center gap-2.5">
        <span class="bg-scorch-crimson text-white px-2 py-0.5 border border-black font-extrabold">
          🐉 RYUKAMI-UI v2.3.0
        </span>
        <span class="font-bold text-slate-700 dark:text-slate-300">
          SCORCH DRAGON SYSTEM // VELGRYND TRIBUTE EDITION
        </span>
      </div>
      <div class="flex items-center gap-3">
        <a href="https://github.com/Alecwce/ryukami-ui" target="_blank" rel="noopener noreferrer" class="underline font-bold hover:text-scorch-crimson">
          [GitHub Repo ↗]
        </a>
        <a href="/r/registry.json" target="_blank" class="underline font-bold hover:text-scorch-crimson">
          [/r/registry.json]
        </a>
        <a href="#hero" class="btn-brutal bg-scorch-gold text-black px-2.5 py-1 text-[11px] font-extrabold">
          ↑ VOLVER ARRIBA
        </a>
      </div>
    </div>
    <div class="flex flex-wrap justify-between items-center gap-2 text-slate-700 dark:text-slate-300">
      <p>Neo-Brutalism + Retro TUI CLI + 8-Bit Matrix · Astro 7.4 · Tailwind CSS 4.3 · TypeScript 7.0</p>
      <p class="font-bold">MIT License 2026 · Ryukami Labs</p>
    </div>
  </footer>

  <!-- Modales y Notificaciones Globales (Fase 2) -->
  <CommandPalette />
  <ToastContainer />

  <!-- Script de Audio, Tema y Telemetría de Scroll Global -->
  <script is:inline>
    // Inicializar Tema
    const savedTheme = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
      document.documentElement.classList.add('dark');
      actualizarBotonTema(true);
    } else {
      document.documentElement.classList.remove('dark');
      actualizarBotonTema(false);
    }

    window.toggleTheme = function() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      actualizarBotonTema(isDark);
      if (window.playTerminalBeep) window.playTerminalBeep(isDark ? 600 : 900, 0.08);
    };

    function actualizarBotonTema(isDark) {
      const label = document.getElementById('theme-label');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');
      if (label) {
        label.innerText = isDark ? 'HACKER' : 'PAPER';
      }
      if (sunIcon && moonIcon) {
        sunIcon.classList.toggle('hidden', isDark);
        moonIcon.classList.toggle('hidden', !isDark);
      }
    }

    // Barra de progreso de scroll acelerada por GPU
    const scrollBar = document.getElementById('scorch-scroll-bar');
    if (scrollBar) {
      window.addEventListener(
        'scroll',
        () => {
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = maxScroll > 0 ? Math.min(1, Math.max(0, window.scrollY / maxScroll)) : 0;
          scrollBar.style.transform = `scaleX(${ratio})`;
        },
        { passive: true }
      );
    }

    // Web Audio API Synthesis (Persistencia en localStorage)
    const SOUND_STORAGE_KEY = 'ryukami-sound-enabled';
    let audioCtx = null;
    let soundEnabled = localStorage.getItem(SOUND_STORAGE_KEY) === 'true';

    function actualizarBotonSonido(enabled) {
      const soundBtn = document.getElementById('sound-btn');
      const offIcon = document.getElementById('sound-icon-off');
      const onIcon = document.getElementById('sound-icon-on');
      const label = document.getElementById('sound-label');
      if (soundBtn) {
        soundBtn.setAttribute('aria-checked', enabled ? 'true' : 'false');
      }
      if (label) {
        label.innerText = enabled ? 'SND: ON' : 'SND: OFF';
      }
      if (offIcon && onIcon) {
        offIcon.classList.toggle('hidden', enabled);
        onIcon.classList.toggle('hidden', !enabled);
      }
    }

    if (soundEnabled) {
      actualizarBotonSonido(true);
    }

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }

    window.playMechanicalClick = function() {
      // Pulso háptico táctil en móviles para emular pulsación mecánica Cherry MX (8ms)
      try {
        if ('vibrate' in navigator) {
          navigator.vibrate(8);
        }
      } catch (e) {}

      if (!soundEnabled) return;
      try {
        initAudio();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const filter = audioCtx.createBiquadFilter();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(45, now + 0.03);

        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(1400, now);
        filter.Q.setValueAtTime(2.0, now);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(now);
        osc.stop(now + 0.03);
      } catch (e) {}
    };

    window.playTerminalBeep = function(freq = 880, duration = 0.05) {
      if (!soundEnabled) return;
      try {
        initAudio();
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'square';
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(now);
        osc.stop(now + duration);
      } catch (e) {}
    };

    window.toggleSound = function() {
      soundEnabled = !soundEnabled;
      localStorage.setItem(SOUND_STORAGE_KEY, soundEnabled ? 'true' : 'false');
      actualizarBotonSonido(soundEnabled);
      if (soundEnabled) {
        window.playTerminalBeep(980, 0.06);
      }
    };

    // Enganchar sonido de click a botones
    document.addEventListener('click', (e) => {
      if (e.target.closest('.btn-brutal') || e.target.closest('button')) {
        window.playMechanicalClick();
      }
    });
  </script>
</body>
</html>
