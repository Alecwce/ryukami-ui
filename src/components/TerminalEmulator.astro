---
// Consola Interactiva en Vivo 0xSCORCH_SHELL
---

<div class="tui-window overflow-hidden font-mono text-xs scroll-mt-52 sm:scroll-mt-48" id="scorch-live-terminal">
  <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-emerald-400 border border-black"></span>
      <span class="truncate">0xSCORCH_SHELL <span class="hidden sm:inline">// INTERACTIVE_TUI_CONSOLE (zsh 5.9)</span></span>
    </span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="bg-black text-scorch-gold px-1.5 py-0.5 text-[10px] border border-slate-700 font-bold">
        TTY1 // ROOT
      </span>
    </div>
  </div>

  <!-- Barra de Comandos Rápidos en 1 Clic (Relative z-10 para evitar superposición) -->
  <div class="relative z-10 px-2.5 sm:px-3 py-2 bg-slate-900 text-slate-200 border-b-2 border-black dark:border-slate-800 flex flex-wrap items-center gap-1.5 sm:gap-2">
    <span class="text-[10px] font-extrabold text-scorch-gold uppercase mr-1 w-full sm:w-auto">COMANDOS RÁPIDOS:</span>
    <button type="button" data-term-cmd="neofetch" class="px-2 py-0.5 bg-slate-800 hover:bg-scorch-crimson text-white border border-slate-600 font-bold cursor-pointer text-[11px]">
      neofetch
    </button>
    <button type="button" data-term-cmd="status" class="px-2 py-0.5 bg-slate-800 hover:bg-scorch-cyan hover:text-black text-white border border-slate-600 font-bold cursor-pointer text-[11px]">
      status
    </button>
    <button type="button" data-term-cmd="cli" class="px-2 py-0.5 bg-slate-800 hover:bg-scorch-gold hover:text-black text-white border border-slate-600 font-bold cursor-pointer text-[11px]">
      cli
    </button>
    <button type="button" data-term-cmd="dragon" class="px-2 py-0.5 bg-slate-800 hover:bg-scorch-crimson text-white border border-slate-600 font-bold cursor-pointer text-[11px]">
      dragon
    </button>
    <button type="button" data-term-cmd="theme" class="px-2 py-0.5 bg-slate-800 hover:bg-emerald-400 hover:text-black text-white border border-slate-600 font-bold cursor-pointer text-[11px]">
      theme
    </button>
    <button type="button" data-term-cmd="clear" class="px-2 py-0.5 bg-black hover:bg-white hover:text-black text-slate-300 border border-slate-700 font-bold cursor-pointer text-[11px] ml-auto">
      clear
    </button>
  </div>

  <!-- Salida de Consola -->
  <div
    id="scorch-term-output"
    class="p-4 bg-[#070A0F] text-slate-100 h-64 overflow-y-auto space-y-2 text-xs leading-relaxed"
    aria-live="polite"
  >
    <div class="text-slate-400">
      ◆ <strong class="text-scorch-cyan">Ryukami Scorch-OS v4.1</strong> — Escribe <code class="text-scorch-gold">help</code> o pulsa cualquiera de los botones superiores.
    </div>
    <pre class="text-[11px] leading-tight text-scorch-crimson font-extrabold overflow-x-auto">  ╔══════════════════════════════════════════════════════════════╗
  ║  🐉 RYUKAMI LABS // SCORCH KERNEL ONLINE (AUDITED 95/97/100) ║
  ║  Stack: Astro 7.4.0 · Tailwind 4.3.3 · TypeScript 7.0.2      ║
  ╚══════════════════════════════════════════════════════════════╝</pre>
  </div>

  <!-- Input de Comando en Vivo -->
  <form
    id="scorch-term-form"
    class="p-2 sm:p-2.5 bg-black border-t-2 border-black dark:border-slate-800 flex flex-wrap sm:flex-nowrap items-center gap-2"
  >
    <div class="flex items-center gap-1.5 flex-1 min-w-[180px]">
      <label for="scorch-term-input" class="text-scorch-crimson font-extrabold select-none shrink-0 text-xs">
        <span class="hidden xs:inline">alex@</span>ryukami:~#
      </label>
      <input
        id="scorch-term-input"
        type="text"
        placeholder="Escribe un comando (help, neofetch, dragon...)"
        autocomplete="off"
        class="w-full bg-transparent text-slate-100 font-mono text-xs outline-none placeholder:text-slate-500 min-w-0"
      />
    </div>
    <button
      type="submit"
      class="px-2.5 py-1 bg-scorch-crimson text-white font-extrabold text-[11px] border border-black cursor-pointer shrink-0 ml-auto sm:ml-0"
    >
      EJECUTAR ↵
    </button>
  </form>
</div>

<script is:inline>
  (function () {
    const output = document.getElementById('scorch-term-output');
    const form = document.getElementById('scorch-term-form');
    const input = document.getElementById('scorch-term-input');
    const root = document.getElementById('scorch-live-terminal');
    if (!output || !form || !input || !root) return;

    const RESPONSES = {
      help: `<div class="space-y-1 text-slate-200">
  <div class="text-scorch-gold font-extrabold">// COMANDOS DEL KERNEL RYUKAMI:</div>
  <div>• <span class="text-scorch-cyan font-bold">neofetch</span> — Información del sistema y arquitectura Scorch</div>
  <div>• <span class="text-scorch-cyan font-bold">status</span>   — Estado de nodos PostgreSQL 17, Redis 7.2 y Lighthouse</div>
  <div>• <span class="text-scorch-cyan font-bold">cli</span>      — Comandos del instalador <code class="text-scorch-gold">ryukami-ui</code></div>
  <div>• <span class="text-scorch-cyan font-bold">dragon</span>   — Invocar matriz ASCII del Dragón Scorch (Velgrynd)</div>
  <div>• <span class="text-scorch-cyan font-bold">theme</span>    — Alternar entre Modo Paper y Modo Hacker en vivo</div>
  <div>• <span class="text-scorch-cyan font-bold">clear</span>    — Limpiar búfer de terminal</div>
</div>`,
      neofetch: `<pre class="text-[11px] leading-tight text-scorch-cyan font-bold overflow-x-auto">      /\\  /\\        <span class="text-scorch-crimson">alex@ryukami-labs</span>
     /  \\/  \\       ───────────────────────────────
    / /\\  /\\ \\      <span class="text-scorch-gold">OS:</span>      Scorch-OS v4.1 (Linux x86_64)
   / /  \\/  \\ \\     <span class="text-scorch-gold">Engine:</span>  Astro 7.4.0 (Vite 8 + Rolldown)
  / /   /\\   \\ \\    <span class="text-scorch-gold">Styles:</span>  Tailwind CSS 4.3.3 (@theme)
  \\ \\  /  \\  / /    <span class="text-scorch-gold">Types:</span>   TypeScript 7.0.2 Strict
   \\ \\/ /\\ \\/ /     <span class="text-scorch-gold">CLI:</span>     ryukami-ui v2.3.0 (27 modules)
    \\  /  \\  /      <span class="text-scorch-gold">Audit:</span>   Lighthouse 95 / 97 / 100 / 100</pre>`,
      status: `<div class="space-y-1">
  <div class="text-emerald-400 font-bold">✓ [NODE_01] PostgreSQL 17.2     [████████████████] 100% ONLINE</div>
  <div class="text-emerald-400 font-bold">✓ [NODE_02] Redis 7.2 Cache     [████████████████] 100% ONLINE</div>
  <div class="text-scorch-cyan font-bold">◆ [REGISTRY] /r/registry.json   [████████████████] 27 MODULES</div>
  <div class="text-scorch-gold font-bold">★ [LIGHTHOUSE] Core Web Vitals  [CLS: 0.064 · TBT: 90ms · 95/97/100/100]</div>
</div>`,
      cli: `<div class="space-y-1 text-slate-200">
  <div class="text-scorch-crimson font-extrabold">$ ryukami-ui init --dir ./mi-app</div>
  <div class="text-scorch-cyan font-extrabold">$ ryukami-ui add button card modal tabs accordion terminal-emulator</div>
  <div class="text-slate-400">→ Endpoint activo: <a href="/r/registry.json" target="_blank" class="underline text-scorch-gold">/r/registry.json</a></div>
</div>`,
      dragon: `<pre class="text-[11px] leading-tight text-scorch-crimson font-extrabold overflow-x-auto">              /|  /|  ---------------------------
              ||__||  |  SCORCH DRAGON AWAKENED |
             /   O O\\__  ------------------------
            /          \\   [VELGRYND TRIBUTE CORE]
           /      \\     \\   TEMP: 9,800°C // MAX
          /   _    \\     \\ ----------------------
         /    |\\____\\     \\      ||
        /     | | | |\\____/      ||
       /       \\| | | |/ |     __||
      /  /  \\   -------  |_____| ||
     /   |   |           |       --|
     |   |   |           |_____  --|</pre>`,
    };

    function runCommand(rawCmd) {
      const cmd = (rawCmd || '').trim().toLowerCase();
      if (!cmd) return;

      if (window.playTerminalBeep) window.playTerminalBeep(780, 0.04);

      if (cmd === 'clear' || cmd === 'cls') {
        output.innerHTML = `<div class="text-slate-400">Búfer limpiado. Escribe <code class="text-scorch-gold">help</code> para ver comandos.</div>`;
        return;
      }

      const cmdLine = document.createElement('div');
      cmdLine.className = 'text-slate-300 font-bold pt-1';
      cmdLine.innerHTML = `<span class="text-scorch-crimson">alex@ryukami:~#</span> ${cmd}`;
      output.appendChild(cmdLine);

      const resBlock = document.createElement('div');
      resBlock.className = 'pl-2 border-l-2 border-scorch-crimson/60 my-1';

      if (cmd === 'theme') {
        if (window.toggleTheme) window.toggleTheme();
        const isDark = document.documentElement.classList.contains('dark');
        resBlock.innerHTML = `<span class="text-scorch-gold font-bold">◆ Tema conmutado a: ${isDark ? 'MODO HACKER CRT (#0B0F17)' : 'MODO PAPER BRUTALISM (#F5F7FA)'}</span>`;
      } else if (RESPONSES[cmd]) {
        resBlock.innerHTML = RESPONSES[cmd];
      } else {
        resBlock.innerHTML = `<span class="text-scorch-crimson">zsh: comando no encontrado: "${cmd}". Escribe <strong class="text-scorch-gold">help</strong>.</span>`;
      }

      output.appendChild(resBlock);
      output.scrollTop = output.scrollHeight;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      runCommand(input.value);
      input.value = '';
    });

    root.querySelectorAll('[data-term-cmd]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cmd = btn.getAttribute('data-term-cmd');
        runCommand(cmd);
      });
    });
  })();
</script>
