---
import { REGISTRY_COMPONENTS, CATEGORIES } from '../data/registry';

export interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<aside class="space-y-4 font-mono text-xs" aria-label="Índice de documentación">
  <div class="tui-window overflow-hidden">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white text-[11px] flex items-center justify-between gap-2 flex-nowrap">
      <span class="whitespace-nowrap shrink-0">INDEX // EXPLORER</span>
      <span class="whitespace-nowrap shrink-0">35 MODS</span>
    </div>

    <nav
      id="scorch-sidebar-nav"
      class="p-3.5 space-y-4 bg-white dark:bg-slate-900 max-h-[calc(100vh-9rem)] overflow-y-auto"
    >
      <!-- Grupo 0: Empezar -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-crimson">
          // 00_GETTING_STARTED
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="/docs"
              class={`sidebar-link block px-2 py-1 border-l-2 font-bold transition-colors ${
                activeSlug === 'index'
                  ? 'bg-scorch-crimson text-white border-black'
                  : 'border-transparent hover:bg-scorch-crimson hover:text-white'
              }`}
            >
              &gt; Introducción
            </a>
          </li>
          <li>
            <a
              href="/docs/cli"
              class={`sidebar-link block px-2 py-1 border-l-2 font-bold transition-colors ${
                activeSlug === 'cli'
                  ? 'bg-scorch-crimson text-white border-black'
                  : 'border-transparent hover:bg-scorch-crimson hover:text-white'
              }`}
            >
              &gt; Instalador CLI
            </a>
          </li>
          <li>
            <a
              href="/docs/mcp"
              class={`sidebar-link block px-2 py-1 border-l-2 font-bold transition-colors ${
                activeSlug === 'mcp'
                  ? 'bg-scorch-crimson text-white border-black'
                  : 'border-transparent hover:bg-scorch-crimson hover:text-white'
              }`}
            >
              &gt; Servidor MCP (IA)
            </a>
          </li>
        </ul>
      </div>

      <!-- Categorías de Componentes (Dinámico desde registry.ts) -->
      {CATEGORIES.map((cat) => {
        const items = REGISTRY_COMPONENTS.filter((c) => c.category === cat.id);
        const catColorClass =
          cat.id === '01_CORE_UI'
            ? 'text-sky-700 dark:text-scorch-cyan'
            : cat.id === '02_FORM_CONTROLS'
            ? 'text-scorch-gold-text dark:text-scorch-gold'
            : cat.id === '03_LAYOUT_AND_MODALS'
            ? 'text-emerald-700 dark:text-emerald-400'
            : 'text-purple-700 dark:text-purple-400';

        return (
          <div class="space-y-1">
            <div class={`text-[10px] font-extrabold uppercase tracking-wider ${catColorClass}`}>
              // {cat.label}
            </div>
            <ul class="space-y-0.5 pl-1">
              {items.map((item) => {
                const isActive = activeSlug === item.slug;
                return (
                  <li>
                    <a
                      href={`/docs/components/${item.slug}`}
                      class={`sidebar-link block px-2 py-1 border-l-2 font-bold transition-colors flex items-center justify-between ${
                        isActive
                          ? 'bg-black text-white dark:bg-white dark:text-black border-scorch-crimson'
                          : 'border-transparent hover:bg-slate-100 dark:hover:bg-slate-800'
                      }`}
                    >
                      <span class="truncate">&gt; {item.title}</span>
                      {['bento-grid', 'drawer', 'data-table', 'stat-card'].includes(item.slug) && (
                        <span class="bg-scorch-crimson text-white text-[9px] px-1 border border-black shrink-0 ml-1">
                          v2.4
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </nav>
  </div>
</aside>
