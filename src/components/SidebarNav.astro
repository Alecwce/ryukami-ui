---
// Sidebar de Navegación Categorizado estilo 8bitcn / shadcn
---

<aside class="space-y-4 font-mono text-xs">
  <div class="tui-window sticky top-28 overflow-hidden">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
      <span>INDEX // EXPLORER</span>
      <span>11 MODS</span>
    </div>

    <nav class="p-3.5 space-y-5 bg-white dark:bg-slate-900 max-h-[calc(100vh-10rem)] overflow-y-auto">
      <!-- Grupo 1: Inicio -->
      <div class="space-y-1.5">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-crimson">
          // 00_GETTING_STARTED
        </div>
        <ul class="space-y-1 pl-1">
          <li>
            <a href="#hero" class="block px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors">
              &gt; Visión General
            </a>
          </li>
          <li>
            <a href="#install-docs" class="block px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors">
              &gt; Instalación &amp; Setup
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 2: Componentes Base -->
      <div class="space-y-1.5">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-cyan">
          // 01_CORE_UI
        </div>
        <ul class="space-y-1 pl-1">
          <li>
            <a href="#components" class="block px-2 py-1 hover:bg-scorch-cyan hover:text-black font-bold transition-colors">
              &gt; Button.astro
            </a>
          </li>
          <li>
            <a href="#components" class="block px-2 py-1 hover:bg-scorch-cyan hover:text-black font-bold transition-colors">
              &gt; Badge.astro
            </a>
          </li>
          <li>
            <a href="#components" class="block px-2 py-1 hover:bg-scorch-cyan hover:text-black font-bold transition-colors">
              &gt; Card.astro (TUI)
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 3: Formularios -->
      <div class="space-y-1.5">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-gold-text dark:text-scorch-gold">
          // 02_FORM_CONTROLS
        </div>
        <ul class="space-y-1 pl-1">
          <li>
            <a href="#forms" class="block px-2 py-1 hover:bg-scorch-gold hover:text-black font-bold transition-colors">
              &gt; Input.astro
            </a>
          </li>
          <li>
            <a href="#forms" class="block px-2 py-1 hover:bg-scorch-gold hover:text-black font-bold transition-colors">
              &gt; Checkbox.astro
            </a>
          </li>
          <li>
            <a href="#forms" class="block px-2 py-1 hover:bg-scorch-gold hover:text-black font-bold transition-colors">
              &gt; Switch.astro
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 4: Feedback & Modales -->
      <div class="space-y-1.5">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-crimson">
          // 03_FEEDBACK_OVERLAYS
        </div>
        <ul class="space-y-1 pl-1">
          <li>
            <a href="#alerts" class="block px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors">
              &gt; Alert.astro
            </a>
          </li>
          <li>
            <a href="#alerts" class="block px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors">
              &gt; ToastContainer.astro
            </a>
          </li>
          <li>
            <a href="#alerts" class="block px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors">
              &gt; Modal.astro (Dialog)
            </a>
          </li>
          <li>
            <button
              type="button"
              onclick="window.openPalette && window.openPalette()"
              class="w-full text-left px-2 py-1 hover:bg-scorch-cyan hover:text-black font-bold transition-colors flex justify-between items-center"
            >
              <span>&gt; CommandPalette</span>
              <span class="text-[9px] border border-current px-1">⌘K</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Grupo 5: Datos & Herramientas -->
      <div class="space-y-1.5">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-500">
          // 04_SCORCH_STUDIO
        </div>
        <ul class="space-y-1 pl-1">
          <li>
            <a href="#theme-studio" class="px-2 py-1 hover:bg-scorch-crimson hover:text-white font-bold transition-colors flex justify-between items-center">
              <span>&gt; Theme Studio</span>
              <span class="bg-scorch-crimson text-white text-[9px] px-1 border border-black">LIVE</span>
            </a>
          </li>
          <li>
            <a href="#ascii-forge" class="px-2 py-1 hover:bg-scorch-gold hover:text-black font-bold transition-colors flex justify-between items-center">
              <span>&gt; ASCII Forge</span>
              <span class="bg-scorch-gold text-black text-[9px] px-1 border border-black">NEW</span>
            </a>
          </li>
          <li>
            <a href="#tables" class="block px-2 py-1 hover:bg-scorch-cyan hover:text-black font-bold transition-colors">
              &gt; Table &amp; Kbd
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</aside>
