              &gt; Checkbox &amp; Switch
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 4: Navegación, Feedback & Modales -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-crimson">
          // 03_LAYOUT_AND_MODALS
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="#comp-tabs"
              data-nav-target="comp-tabs"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold"
            >
              &gt; Tabs.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-accordion"
              data-nav-target="comp-accordion"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold"
            >
              &gt; Accordion.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-nav-primitives"
              data-nav-target="comp-nav-primitives"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold flex justify-between items-center"
            >
              <span>&gt; Breadcrumb &amp; Pager</span>
              <span class="bg-scorch-crimson text-white text-[9px] px-1 border border-black">NEW</span>
            </a>
          </li>
          <li>
            <a
              href="#comp-alert"
              data-nav-target="comp-alert"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold"
            >
              &gt; Alert.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-toast"
              data-nav-target="comp-toast"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold flex justify-between items-center"
            >
              <span>&gt; Popover, Modal &amp; Toast</span>
              <span class="bg-scorch-crimson text-white text-[9px] px-1 border border-black">API</span>
            </a>
          </li>
          <li>
            <button
              type="button"
              onclick="window.openPalette && window.openPalette()"
              class="w-full text-left px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold flex justify-between items-center cursor-pointer"
            >
              <span>&gt; CommandPalette</span>
              <span class="text-[9px] border border-current px-1">⌘K</span>
            </button>
          </li>
        </ul>
      </div>

      <!-- Grupo 5: Datos & Herramientas -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
          // 04_SCORCH_LABS
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="#live-shell"
              data-nav-target="live-shell"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-emerald-500 hover:text-black font-bold flex justify-between items-center"
            >
              <span>&gt; 0xSCORCH_SHELL</span>
              <span class="bg-emerald-400 text-black text-[9px] px-1 border border-black">TTY</span>
            </a>
          </li>
          <li>
            <a
              href="#theme-studio"
              data-nav-target="theme-studio"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold flex justify-between items-center"
            >
              <span>&gt; Theme Studio</span>
              <span class="bg-scorch-crimson text-white text-[9px] px-1 border border-black">LIVE</span>
            </a>
          </li>
          <li>
            <a
              href="#ascii-forge"
              data-nav-target="ascii-forge"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-gold hover:text-black font-bold flex justify-between items-center"
            >
              <span>&gt; ASCII Forge</span>
              <span class="bg-scorch-gold text-black text-[9px] px-1 border border-black">8BIT</span>
            </a>
          </li>
          <li>
            <a
              href="#tables"
              data-nav-target="tables"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold"
            >
              &gt; Table &amp; Kbd
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</aside>

<script is:inline>
  (function () {
    const nav = document.getElementById('scorch-sidebar-nav');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll('a.sidebar-link[data-nav-target]'));
    const targetIds = links.map((l) => l.getAttribute('data-nav-target')).filter(Boolean);

    function setActiveLink(activeId) {
      links.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-target') === activeId;
        if (isMatch) {
          link.classList.add('bg-slate-900', 'text-white', 'dark:bg-scorch-crimson', 'border-scorch-crimson', 'dark:border-white');
          link.classList.remove('border-transparent');
        } else {
          link.classList.remove('bg-slate-900', 'text-white', 'dark:bg-scorch-crimson', 'border-scorch-crimson', 'dark:border-white');
          link.classList.add('border-transparent');
        }
      });
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-nav-target');
        const targetEl = targetId ? document.getElementById(targetId) : null;
        if (!targetEl) return;

        e.preventDefault();
        if (window.playMechanicalClick) window.playMechanicalClick();

        setActiveLink(targetId);
        history.replaceState(null, '', `#${targetId}`);

        const headerOffset = 116;
        const elementPosition = targetEl.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({
          top: Math.max(0, elementPosition - headerOffset),
          behavior: 'smooth',
        });

        targetEl.classList.add('ring-2', 'ring-scorch-crimson', 'ring-offset-4');
        setTimeout(() => {
          targetEl.classList.remove('ring-2', 'ring-scorch-crimson', 'ring-offset-4');
        }, 900);
      });
    });

    const sections = targetIds.map((id) => document.getElementById(id)).filter(Boolean);
    if ('IntersectionObserver' in window && sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0 && visible[0].target.id) {
            setActiveLink(visible[0].target.id);
          }
        },
        {
          rootMargin: '-120px 0px -65% 0px',
          threshold: 0.05,
        }
      );

      sections.forEach((sec) => observer.observe(sec));
    }

    const initialHash = window.location.hash ? window.location.hash.slice(1) : 'hero';
    setActiveLink(targetIds.includes(initialHash) ? initialHash : 'hero');
  })();
</script>
