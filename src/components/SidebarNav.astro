---
// Sidebar de Navegación Categorizado estilo 8bitcn / shadcn con ScrollSpy activo (27 módulos)
---

<aside class="space-y-4 font-mono text-xs" aria-label="Índice de documentación">
  <div class="tui-window overflow-hidden">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
      <span>INDEX // EXPLORER</span>
      <span>27 MODS</span>
    </div>

    <nav
      id="scorch-sidebar-nav"
      class="p-3.5 space-y-4 bg-white dark:bg-slate-900 max-h-[calc(100vh-9rem)] overflow-y-auto"
    >
      <!-- Grupo 1: Inicio -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-crimson">
          // 00_GETTING_STARTED
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="#hero"
              data-nav-target="hero"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold"
            >
              &gt; Visión General
            </a>
          </li>
          <li>
            <a
              href="#install-docs"
              data-nav-target="install-docs"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-crimson hover:text-white font-bold"
            >
              &gt; CLI &amp; Instalación
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 2: Componentes Base -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-sky-700 dark:text-scorch-cyan">
          // 01_CORE_UI
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="#comp-button"
              data-nav-target="comp-button"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold"
            >
              &gt; Button.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-badge"
              data-nav-target="comp-badge"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold"
            >
              &gt; Badge.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-card"
              data-nav-target="comp-card"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold"
            >
              &gt; Card.astro (TUI)
            </a>
          </li>
          <li>
            <a
              href="#comp-progress"
              data-nav-target="comp-progress"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold"
            >
              &gt; ProgressBar.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-avatar"
              data-nav-target="comp-avatar"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-cyan hover:text-black font-bold flex justify-between items-center"
            >
              <span>&gt; Avatar &amp; Skeleton</span>
              <span class="bg-scorch-cyan text-black text-[9px] px-1 border border-black">NEW</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo 3: Formularios -->
      <div class="space-y-1">
        <div class="text-[10px] font-extrabold uppercase tracking-wider text-scorch-gold-text dark:text-scorch-gold">
          // 02_FORM_CONTROLS
        </div>
        <ul class="space-y-0.5 pl-1">
          <li>
            <a
              href="#comp-input"
              data-nav-target="comp-input"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-gold hover:text-black font-bold"
            >
              &gt; Input.astro
            </a>
          </li>
          <li>
            <a
              href="#comp-textarea"
              data-nav-target="comp-textarea"
              class="sidebar-link px-2 py-1 border-l-2 border-transparent hover:bg-scorch-gold hover:text-black font-bold flex justify-between items-center"
            >
              <span>&gt; Textarea &amp; Radio</span>
              <span class="bg-scorch-gold text-black text-[9px] px-1 border border-black">NEW</span>
            </a>
          </li>
          <li>
            <a
              href="#comp-select"
              data-nav-target="comp-select"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-gold hover:text-black font-bold"
            >
              &gt; Select &amp; Slider
            </a>
          </li>
          <li>
            <a
              href="#comp-checkbox"
              data-nav-target="comp-checkbox"
              class="sidebar-link block px-2 py-1 border-l-2 border-transparent hover:bg-scorch-gold hover:text-black font-bold"
