---
export interface Props {
  title?: string;
  status?: string;
  class?: string;
  controls?: boolean;
}

const {
  title = '0xMODULE // STATUS',
  status,
  class: className = '',
  controls = true,
} = Astro.props;
---

<div class={`tui-window ${className}`} data-tui-card>
  <div class="tui-header">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2 h-2 shrink-0 bg-scorch-cyan border border-black"></span>
      <span class="truncate">{title}</span>
    </span>
    <div class="flex items-center gap-2.5 shrink-0">
      {status && (
        <span class="inline-flex items-center justify-center bg-black text-scorch-gold px-1.5 h-5 border border-slate-700 font-bold text-[10px] leading-none">
          {status}
        </span>
      )}
      {controls && (
        <div class="inline-flex items-center gap-1 select-none" aria-hidden="true">
          <!-- Minimizar (-) -->
          <span
            data-card-action="minimize"
            title="Minimizar / Restaurar ventana"
            class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25 hover:bg-white hover:text-black cursor-pointer"
          >
            <span class="w-2.5 h-0.5 bg-current block"></span>
          </span>
          <!-- Maximizar (□) -->
          <span
            data-card-action="maximize"
            title="Resaltar ventana"
            class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25 hover:bg-scorch-cyan hover:text-black cursor-pointer"
          >
            <span class="w-2.5 h-2.5 border-[1.5px] border-current block"></span>
          </span>
          <!-- Cerrar (×) -->
          <span
            data-card-action="close"
            title="Proceso protegido"
            class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson hover:bg-white text-white hover:text-black cursor-pointer"
          >
            <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
              <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
            </svg>
          </span>
        </div>
      )}
    </div>
  </div>
  <div class="p-5" data-card-body>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll('[data-tui-card]').forEach((card) => {
    const body = card.querySelector('[data-card-body]');
    const minBtn = card.querySelector('[data-card-action="minimize"]');
    const maxBtn = card.querySelector('[data-card-action="maximize"]');
    const closeBtn = card.querySelector('[data-card-action="close"]');

    if (minBtn && body) {
      minBtn.addEventListener('click', () => {
        if ((window as any).playMechanicalClick) (window as any).playMechanicalClick();
        body.classList.toggle('hidden');
      });
    }

    if (maxBtn) {
      maxBtn.addEventListener('click', () => {
        if ((window as any).playMechanicalClick) (window as any).playMechanicalClick();
        card.classList.toggle('ring-2');
        card.classList.toggle('ring-scorch-cyan');
        if (body && body.classList.contains('hidden')) {
          body.classList.remove('hidden');
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        if ((window as any).showToast) {
          (window as any).showToast(
            '0xKERNEL // PROTECTED',
            'Ventana del sistema anclada. Usa [-] para plegar su contenido.',
            'gold',
            2200
          );
        }
      });
    }
  });
</script>
