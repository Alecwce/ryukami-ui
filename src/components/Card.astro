---
interface Props {
  title?: string;
  status?: string;
  class?: string;
  controls?: boolean;
}

const {
  title = '0xMODULE // STATUS',
  status,
  class: className = '',
  controls = true,
} = Astro.props;
---

<div class={`tui-window ${className}`}>
  <div class="tui-header">
    <span class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-scorch-cyan border border-black"></span>
      {title}
    </span>
    <div class="flex items-center gap-3">
      {status && <span class="bg-black text-scorch-gold px-1.5 py-0.5 border border-slate-700 font-bold text-[11px]">{status}</span>}
      {controls && (
        <div class="flex gap-1 text-xs select-none" aria-hidden="true">
          <span class="px-1 border border-current font-bold">[ _ ]</span>
          <span class="px-1 border border-current font-bold">[ □ ]</span>
          <span class="px-1 border border-current font-bold">[ × ]</span>
        </div>
      )}
    </div>
  </div>
  <div class="p-5">
    <slot />
  </div>
</div>
