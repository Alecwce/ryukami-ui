---
interface CommonProps {
  variant?: 'crimson' | 'cyan' | 'gold' | 'outline' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  id?: string;
  disabled?: boolean;
  onclick?: string;
  title?: string;
  'aria-label'?: string;
  [key: string]: any;
}

interface AnchorButtonProps extends CommonProps {
  href: string;
  target?: string;
  rel?: string;
  download?: string | boolean;
  type?: never;
}

interface NativeButtonProps extends CommonProps {
  href?: never;
  type?: 'button' | 'submit' | 'reset';
  target?: never;
  rel?: never;
  download?: never;
}

export type Props = AnchorButtonProps | NativeButtonProps;

const props = Astro.props as Props;
const {
  variant = 'crimson',
  size = 'md',
  class: className = '',
  id,
  onclick,
  disabled = false,
  ...rest
} = props;

const variantStyles = {
  crimson: 'bg-scorch-crimson text-white hover:bg-red-600',
  cyan: 'bg-scorch-cyan text-black hover:bg-sky-400',
  gold: 'bg-scorch-gold text-black hover:bg-yellow-400',
  outline: 'bg-white text-black dark:bg-slate-800 dark:text-white',
  dark: 'bg-black text-white dark:bg-slate-900',
};

const sizeStyles = {
  sm: 'px-3 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-xs sm:text-sm',
  lg: 'px-7 py-3.5 text-sm sm:text-base',
};

const isLink = 'href' in props && typeof props.href === 'string' && props.href.length > 0;
const disabledClasses = disabled ? 'pointer-events-none opacity-50 cursor-not-allowed select-none' : '';
---

{isLink ? (
  <a
    href={disabled ? undefined : props.href}
    id={id}
    role={disabled ? 'link' : undefined}
    aria-disabled={disabled ? 'true' : undefined}
    tabindex={disabled ? -1 : undefined}
    target={props.target}
    rel={props.target === '_blank' && !props.rel ? 'noopener noreferrer' : props.rel}
    download={props.download}
    onclick={disabled ? 'return false;' : onclick}
    class={`btn-brutal ${variantStyles[variant]} ${sizeStyles[size]} ${disabledClasses} ${className}`}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    type={'type' in props && props.type ? props.type : 'button'}
    id={id}
    disabled={disabled}
    aria-disabled={disabled ? 'true' : undefined}
    onclick={onclick}
    class={`btn-brutal ${variantStyles[variant]} ${sizeStyles[size]} ${disabledClasses} ${className}`}
    {...rest}
  >
    <slot />
  </button>
)}
