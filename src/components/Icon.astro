---
export interface Props {
  name:
    | 'copy'
    | 'app-window'
    | 'monitor'
    | 'search'
    | 'volume-x'
    | 'volume-2'
    | 'sun'
    | 'moon'
    | 'command'
    | 'terminal'
    | 'package'
    | 'zap'
    | 'flame'
    | 'droplet'
    | 'github';
