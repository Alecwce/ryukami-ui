---
interface Props {
  label?: string;
  placeholder?: string;
  prefix?: string;
  type?: string;
  value?: string;
  id?: string;
  name?: string;
  disabled?: boolean;
  hint?: string;
  error?: string;
  required?: boolean;
}

const {
  label,
  placeholder = "Escribe aquí...",
  prefix,
  type = "text",
  value = "",
  id,
  name,
  disabled = false,
  hint,
  error,
  required = false,
} = Astro.props;

const inputId = id || `input-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="space-y-1.5 font-mono text-xs w-full">
  {label && (
    <label for={inputId} class="block font-extrabold uppercase tracking-wider text-xs">
      {label} {required && <span class="text-scorch-crimson">*</span>}
    </label>
  )}

  <div class="relative flex items-stretch">
    {prefix && (
      <span class="inline-flex items-center px-3 bg-slate-900 text-scorch-cyan border-2 border-r-0 border-black dark:border-slate-700 font-extrabold select-none">
        {prefix}
      </span>
    )}

    <input
      id={inputId}
      name={name}
      type={type}
      value={value}
      placeholder={placeholder}
      disabled={disabled}
      required={required}
      class={`w-full bg-white dark:bg-slate-900 border-2 border-black dark:border-slate-700 px-3.5 py-2 text-xs md:text-sm font-mono shadow-[-4px_4px_0px_0px_var(--shadow-color,#000000)] rounded-none outline-none placeholder:text-slate-500 dark:placeholder:text-slate-400 focus:border-scorch-crimson focus:shadow-[-6px_6px_0px_0px_var(--shadow-color,#000000)] disabled:opacity-50 disabled:cursor-not-allowed ${
        error ? 'border-scorch-crimson' : ''
      }`}
    />
  </div>

  {hint && !error && (
    <p class="text-[11px] text-slate-700 dark:text-slate-300">&gt; {hint}</p>
  )}

  {error && (
    <p class="text-[11px] text-scorch-crimson font-bold">&gt; [ERROR] {error}</p>
  )}
</div>
