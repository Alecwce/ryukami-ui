---
export interface Props {
  initials: string;
  name: string;
  role?: string;
  status?: 'online' | 'busy' | 'idle' | 'ONLINE' | 'BUSY' | 'IDLE';
  variant?: 'crimson' | 'cyan' | 'gold' | 'dark';
}

const {
  initials = '0xA',
  name = '0xAlex // Root Architect',
  role = 'SYS_ADMIN // LEVEL_99',
  status = 'online',
  variant = 'crimson',
} = Astro.props;

const bgMap = {
  crimson: 'bg-scorch-crimson text-white',
  cyan: 'bg-scorch-cyan text-black',
  gold: 'bg-scorch-gold text-black',
  dark: 'bg-slate-900 text-white',
};

const statusMap = {
  online: { dot: 'bg-emerald-400', label: 'ONLINE' },
  busy: { dot: 'bg-scorch-crimson', label: 'BUSY' },
  idle: { dot: 'bg-scorch-gold', label: 'IDLE' },
};

const normalizedStatus = (String(status).toLowerCase() as keyof typeof statusMap);
const statusInfo = statusMap[normalizedStatus] || statusMap.online;
---

<div class="inline-flex items-center gap-3 p-2.5 bg-white dark:bg-slate-900 border-2 border-black dark:border-slate-300 shadow-[-3px_3px_0px_0px_var(--shadow-color,#000000)] font-mono text-xs">
  <div class="relative shrink-0">
    <div class={`w-10 h-10 border-2 border-black flex items-center justify-center font-extrabold text-xs tracking-tighter ${bgMap[variant]}`}>
      {initials}
    </div>
    <span
      class={`w-3 h-3 border-2 border-black absolute -bottom-1 -right-1 ${statusInfo.dot}`}
      title={statusInfo.label}
      aria-hidden="true"
    ></span>
  </div>

  <div class="min-w-0 pr-1">
    <div class="font-extrabold uppercase tracking-tight truncate">{name}</div>
    <div class="flex items-center gap-1.5 text-[10px] text-slate-700 dark:text-slate-300 font-bold">
      <span>{role}</span>
      <span>·</span>
      <span class="underline">{statusInfo.label}</span>
    </div>
  </div>
</div>
