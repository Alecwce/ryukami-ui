---
interface Props {
  id: string;
  title: string;
  status?: string;
}

const { id, title, status = 'MODAL_ACTIVE' } = Astro.props;
const titleId = `${id}-title`;
---

<dialog
  id={id}
  closedby="any"
  aria-labelledby={titleId}
  class="scorch-modal tui-window w-[calc(100vw-2rem)] max-w-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border-2 border-black dark:border-slate-200 shadow-[-8px_8px_0px_0px_var(--shadow-color,#000000)] p-0 font-mono"
>
  <div class="tui-header">
    <span id={titleId} class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-scorch-crimson border border-black"></span>
      <span>{title}</span>
    </span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="inline-flex items-center justify-center bg-black text-scorch-gold px-1.5 h-5 border border-slate-700 font-bold text-[10px] leading-none">{status}</span>
      <form method="dialog" class="inline-flex">
        <button
          type="submit"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson hover:bg-white text-white hover:text-black cursor-pointer"
          aria-label="Cerrar ventana modal"
        >
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <div class="p-5 space-y-4 text-xs sm:text-sm">
    <slot />
  </div>
</dialog>

<script>
  document.querySelectorAll('dialog.scorch-modal').forEach((dialog) => {
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const e = event as MouseEvent;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width;
        if (!isDialogContent) {
          (dialog as HTMLDialogElement).close();
        }
      });
    }
  });
</script>
