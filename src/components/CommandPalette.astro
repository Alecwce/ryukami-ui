---
import Kbd from './Kbd.astro';
import { REGISTRY_COMPONENTS } from '../data/registry.ts';
import { BLOCKS_DATA } from '../data/blocks.ts';

const serializedComponents = REGISTRY_COMPONENTS.map((c) => ({
  id: `comp-${c.slug}`,
  category: 'COMPONENTS',
  label: `${c.title} — ${c.description}`,
  url: `/docs/components/${c.slug}`,
  shortcut: c.status,
  keywords: `${c.name} ${c.title} ${c.slug} ${c.category} ${c.description} componente`,
}));

const serializedBlocks = BLOCKS_DATA.map((b) => ({
  id: `block-${b.id}`,
  category: 'BLOCKS',
  label: `${b.title} (${b.name}) — ${b.description}`,
  url: `/blocks#${b.id}`,
  shortcut: b.category,
  keywords: `${b.id} ${b.name} ${b.title} ${b.category} ${b.description} bloque plantilla template`,
}));
---

<dialog
  id="scorch-cmd-palette"
  closedby="any"
  aria-labelledby="cmdPaletteTitle"
  class="tui-window w-[calc(100vw-2rem)] max-w-xl bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border-2 border-black dark:border-slate-200 shadow-[-8px_8px_0px_0px_var(--shadow-color,#000000)] p-0 font-mono"
  data-components={JSON.stringify(serializedComponents)}
  data-blocks={JSON.stringify(serializedBlocks)}
>
  <!-- Cabecera de Consola -->
  <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
    <span id="cmdPaletteTitle" class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 bg-scorch-gold border border-black"></span>
      <span>0xCOMMAND_PALETTE // SCORCH_CLI</span>
    </span>
    <div class="flex items-center gap-2 shrink-0">
      <span class="text-[10px] opacity-80 hidden sm:inline leading-none">ESC PARA CERRAR</span>
      <form method="dialog" class="inline-flex">
        <button
          type="submit"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/30 hover:bg-white text-white hover:text-black cursor-pointer"
          aria-label="Cerrar paleta de comandos"
        >
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Buscador en Tiempo Real -->
  <div class="p-3 border-b-2 border-black dark:border-slate-700 bg-slate-100 dark:bg-slate-950 flex items-center gap-2.5 focus-within:ring-2 focus-within:ring-scorch-crimson">
    <span class="text-scorch-crimson font-extrabold text-sm select-none">&gt;_</span>
    <input
      id="cmd-search-input"
      type="text"
      placeholder="Buscar entre 35 componentes, 10 bloques, temas o comandos (Ctrl+K)..."
      autocomplete="off"
      class="w-full bg-transparent text-xs sm:text-sm font-mono focus:outline-none placeholder:opacity-50 text-slate-900 dark:text-slate-100"
    />
  </div>

  <!-- Lista de Comandos -->
  <div id="cmd-list" class="max-h-80 overflow-y-auto divide-y divide-black/10 dark:divide-white/10 p-2 space-y-1">
    <!-- Items inyectados / gestionados dinámicamente -->
  </div>

  <!-- Pie de Consola -->
  <div class="px-3 py-2 border-t-2 border-black dark:border-slate-700 bg-slate-50 dark:bg-slate-950 flex flex-wrap justify-between items-center gap-2 text-[11px] opacity-80">
    <div class="flex items-center gap-3">
      <span><Kbd>↑</Kbd> <Kbd>↓</Kbd> Navegar</span>
      <span><Kbd>Enter</Kbd> Abrir</span>
      <span><Kbd>Esc</Kbd> Salir</span>
    </div>
    <span class="text-scorch-crimson font-bold">RYUKAMI // v2.4.0</span>
  </div>
</dialog>

<script is:inline>
  (function () {
    const dialog = document.getElementById('scorch-cmd-palette');
    const searchInput = document.getElementById('cmd-search-input');
    const cmdList = document.getElementById('cmd-list');

    if (!dialog || !searchInput || !cmdList) return;

    // Fallback para navegadores sin closedBy="any"
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const isDialogContent =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (!isDialogContent) {
          dialog.close();
        }
      });
    }

    let lastActiveElement = null;

    dialog.addEventListener('close', () => {
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    });

    // Cargar datos estáticos de componentes y bloques desde data-attributes
    let componentItems = [];
    let blockItems = [];
    try {
      componentItems = JSON.parse(dialog.getAttribute('data-components') || '[]');
      blockItems = JSON.parse(dialog.getAttribute('data-blocks') || '[]');
    } catch (e) {
      console.error('Error parseando datos de componentes para CommandPalette:', e);
    }

    const navigationGuides = [
      {
        id: 'guide-docs',
        category: 'DOCS',
        label: 'Documentación Oficial // Comenzar',
        shortcut: 'DOCS',
        url: '/docs',
        keywords: 'documentacion introduccion inicio guia docs',
      },
      {
        id: 'guide-components',
        category: 'DOCS',
        label: 'Catálogo Completo de Componentes (35 Módulos)',
        shortcut: 'CATALOG',
        url: '/docs/components',
        keywords: 'componentes catalogo lista todos módulos componentes',
      },
      {
        id: 'guide-cli',
        category: 'DOCS',
        label: 'Guía del CLI ryukami-ui // Instalación & Diff',
        shortcut: 'CLI',
        url: '/docs/cli',
        keywords: 'cli terminal instalador add diff init list comandos',
      },
      {
        id: 'guide-mcp',
        category: 'DOCS',
        label: 'Servidor MCP // Integración con Agentes de IA',
        shortcut: 'MCP',
        url: '/docs/mcp',
        keywords: 'mcp model context protocol jsonrpc ia agents claude antigravity',
      },
      {
        id: 'guide-blocks',
        category: 'DOCS',
        label: 'Galería de Bloques & Plantillas Modulares (10 Bloques)',
        shortcut: 'BLOCKS',
        url: '/blocks',
        keywords: 'bloques templates plantillas hero login faq cta bento',
      },
      {
        id: 'guide-themes',
        category: 'DOCS',
        label: 'Laboratorio de Temas & Tokens W3C (6 Presets)',
        shortcut: 'THEMES',
        url: '/themes',
        keywords: 'temas themes tokens colores paleta dither sombras',
      },
      {
        id: 'guide-tokens-json',
        category: 'API',
        label: 'Ver W3C Design Tokens JSON (/r/tokens.json)',
        shortcut: 'JSON',
        url: '/r/tokens.json',
        keywords: 'tokens json w3c variables css api',
      },
      {
        id: 'guide-registry-json',
        category: 'API',
        label: 'Ver Registro Maestro JSON (/r/registry.json)',
        shortcut: 'API',
        url: '/r/registry.json',
        keywords: 'registry registro json modulos sha256 api',
      },
    ];

    const systemActions = [
      {
        id: 'act-theme',
        category: 'SISTEMA',
        label: 'Alternar Modo Nocturno / Modo Claro',
        shortcut: 'Ctrl+D',
        keywords: 'tema dark light oscuro claro color hacker paper',
        action: () => {
          if (window.toggleTheme) window.toggleTheme();
          if (window.showToast) {
            const isDark = document.documentElement.classList.contains('dark');
            window.showToast(
              'TEMA ACTUALIZADO',
              isDark ? 'Modo Hacker CRT activado (#0B0F17).' : 'Modo Paper Brutalism activado (#F5F7FA).',
              isDark ? 'crimson' : 'cyan'
            );
          }
        },
      },
      {
        id: 'act-sound',
        category: 'SISTEMA',
        label: 'Alternar Sintetizador Acústico Web Audio (Cherry MX)',
        shortcut: 'AUDIO',
        keywords: 'sonido audio mute silencio click cherry sintetizador',
        action: () => {
          if (window.toggleSound) window.toggleSound();
        },
      },
      {
        id: 'act-copy-cli',
        category: 'CLI',
        label: 'Copiar Comando de Instalación CLI',
        shortcut: 'INSTALL',
        keywords: 'copiar instalar cli repo git bin ryukami-ui symlink global',
        action: async () => {
          const cliInstallCmd =
            'git clone https://github.com/Alecwce/ryukami-ui.git ~/.local/share/ryukami-ui && ln -sf ~/.local/share/ryukami-ui/bin/ryukami-ui.mjs ~/.local/bin/ryukami-ui && chmod +x ~/.local/bin/ryukami-ui';
          await navigator.clipboard.writeText(cliInstallCmd);
          if (window.showToast) {
            window.showToast(
              'CLI COPIADO',
              'Comando de instalación enlazado a ~/.local/bin.',
              'emerald'
            );
          }
        },
      },
      {
        id: 'act-test-toast',
        category: 'DEMO',
        label: 'Disparar Notificación de Prueba (Scorch Dragon)',
        shortcut: 'TOAST',
        keywords: 'toast prueba test dragon alerta velgrynd',
        action: () => {
          if (window.showToast) {
            window.showToast(
              'SCORCH_DRAGON // ACTIVE',
              'Pulso térmico de Velgrynd sincronizado al 100% con el kernel.',
              'crimson'
            );
          }
        },
      },
    ];

    const commands = [
      ...systemActions,
      ...navigationGuides,
      ...blockItems,
      ...componentItems,
    ];

    let filteredCommands = [...commands];
    let selectedIndex = 0;

    function renderList() {
      cmdList.innerHTML = '';

      if (filteredCommands.length === 0) {
        cmdList.innerHTML = `
          <div class="p-6 text-center text-xs opacity-60">
            &gt; [404] No se encontraron resultados para "${searchInput.value}"
          </div>
        `;
        return;
      }

      filteredCommands.forEach((cmd, idx) => {
        const isSelected = idx === selectedIndex;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `w-full text-left px-3 py-2 flex items-center justify-between gap-3 text-xs transition-colors border ${
          isSelected
            ? 'bg-scorch-crimson text-white border-black font-extrabold'
            : 'border-transparent hover:bg-slate-200 dark:hover:bg-slate-800'
        }`;

        let badgeBg = 'opacity-70';
        if (isSelected) {
          badgeBg = 'bg-black text-scorch-gold';
        } else if (cmd.category === 'COMPONENTS') {
          badgeBg = 'bg-scorch-cyan/20 text-sky-800 dark:text-scorch-cyan border-scorch-cyan';
        } else if (cmd.category === 'BLOCKS') {
          badgeBg = 'bg-scorch-gold/20 text-scorch-gold-text dark:text-scorch-gold border-scorch-gold';
        } else if (cmd.category === 'DOCS') {
          badgeBg = 'bg-emerald-500/20 text-emerald-800 dark:text-emerald-400 border-emerald-500';
        }

        btn.innerHTML = `
          <div class="flex items-center gap-2.5 truncate min-w-0">
            <span class="px-1.5 py-0.5 text-[9px] font-extrabold border shrink-0 ${badgeBg}">${cmd.category}</span>
            <span class="truncate">${cmd.label}</span>
          </div>
          <span class="text-[10px] font-mono px-1.5 py-0.5 border border-current opacity-80 shrink-0">${cmd.shortcut || ''}</span>
        `;

        btn.addEventListener('mouseenter', () => {
          selectedIndex = idx;
          const prev = cmdList.querySelector('.bg-scorch-crimson');
          if (prev) {
            prev.className = prev.className.replace('bg-scorch-crimson text-white border-black font-extrabold', 'border-transparent hover:bg-slate-200 dark:hover:bg-slate-800');
          }
          btn.className = `w-full text-left px-3 py-2 flex items-center justify-between gap-3 text-xs transition-colors border bg-scorch-crimson text-white border-black font-extrabold`;
        });

        btn.addEventListener('click', () => {
          executeCommand(cmd);
        });

        cmdList.appendChild(btn);
      });
    }

    function executeCommand(cmd) {
      if (!cmd) return;
      dialog.close();
      if (cmd.url) {
        window.location.href = cmd.url;
      } else if (typeof cmd.action === 'function') {
        cmd.action();
      }
    }

    window.openPalette = function () {
      lastActiveElement = document.activeElement;
      if (window.playTerminalBeep) window.playTerminalBeep(740, 0.05);
      searchInput.value = '';
      filteredCommands = [...commands];
      selectedIndex = 0;
      renderList();
      dialog.showModal();
      searchInput.focus();
    };

    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      filteredCommands = commands.filter(
        (c) =>
          c.label.toLowerCase().includes(q) ||
          c.category.toLowerCase().includes(q) ||
          (c.keywords && c.keywords.toLowerCase().includes(q))
      );
      selectedIndex = 0;
      renderList();
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (filteredCommands.length > 0) {
          selectedIndex = (selectedIndex + 1) % filteredCommands.length;
          renderList();
          scrollSelectedIntoView();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (filteredCommands.length > 0) {
          selectedIndex = (selectedIndex - 1 + filteredCommands.length) % filteredCommands.length;
          renderList();
          scrollSelectedIntoView();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (filteredCommands[selectedIndex]) {
          executeCommand(filteredCommands[selectedIndex]);
        }
      }
    });

    function scrollSelectedIntoView() {
      const buttons = cmdList.querySelectorAll('button');
      if (buttons[selectedIndex]) {
        buttons[selectedIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    // Atajos de teclado globales: Ctrl+K / Cmd+K y Ctrl+D
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else {
          window.openPalette();
        }
      } else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'd') {
        e.preventDefault();
        if (window.toggleTheme) window.toggleTheme();
        if (window.showToast) {
          const isDark = document.documentElement.classList.contains('dark');
          window.showToast(
            'ATAJO CTRL+D',
            isDark ? 'Modo Hacker CRT activado.' : 'Modo Paper Brutalism activado.',
            isDark ? 'crimson' : 'cyan'
          );
        }
      }
    });
  })();
</script>
