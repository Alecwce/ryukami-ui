---
import Button from './Button.astro';
import Kbd from './Kbd.astro';
---

<header class="tui-window sticky top-4 z-40 mb-10">
  <div class="tui-header">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-scorch-cyan border border-black"></span>
      <span class="truncate">0xRYUKAMI_UI // SCORCH_OS v4.1.0</span>
    </span>
    <div class="flex items-center gap-3 shrink-0">
      <span class="hidden sm:inline font-mono text-xs leading-none">PID: 9021 · MEM: 124MB</span>
      <div class="inline-flex items-center gap-1 select-none" aria-hidden="true">
        <!-- Minimizar (-) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25">
          <span class="w-2.5 h-0.5 bg-current block"></span>
        </span>
        <!-- Maximizar (□) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25">
          <span class="w-2.5 h-2.5 border-[1.5px] border-current block"></span>
        </span>
        <!-- Cerrar (×) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson text-white">
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div class="p-4 flex flex-wrap justify-between items-center gap-4 bg-white dark:bg-slate-900 border-b-2 border-black dark:border-slate-700">
    <div class="flex items-center gap-3">
      <a href="#hero" class="flex items-center gap-2">
        <span class="bg-scorch-crimson text-white border-2 border-black px-2 py-0.5 text-xs font-extrabold tracking-wider">
          RYUKAMI // UI
        </span>
        <span class="text-xs sm:text-sm font-bold tracking-tight">
          ~/scorch-components
        </span>
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <!-- Nav Links -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-3.5 text-xs font-bold uppercase">
        <a href="#components" class="hover:text-scorch-crimson hover:underline">[01_CORE]</a>
        <a href="#forms" class="hover:text-scorch-crimson hover:underline">[02_FORMS]</a>
        <a href="#alerts" class="hover:text-scorch-crimson hover:underline">[03_MODALS]</a>
        <a href="#theme-studio" class="hover:text-scorch-crimson hover:underline">[04_STUDIO]</a>
        <a href="#ascii-forge" class="hover:text-scorch-crimson hover:underline">[05_ASCII]</a>
      </nav>

      <!-- GitHub Repo Link -->
      <a
        href="https://github.com/Alecwce/ryukami-ui"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal bg-black text-white dark:bg-white dark:text-black px-2.5 sm:px-3 py-1.5 text-xs font-bold inline-flex items-center gap-1.5"
        aria-label="Repositorio oficial en GitHub"
        title="Ver repositorio en GitHub (Alecwce/ryukami-ui)"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GITHUB</span>
      </a>

      <!-- Botón Command Palette -->
      <button type="button" onclick="window.openPalette && window.openPalette()" class="btn-brutal bg-scorch-cyan text-black px-2.5 sm:px-3 py-1.5 text-xs font-bold">
        <span aria-hidden="true">⌨️</span>
        <span>CMD+K</span>
      </button>

      <!-- Toggle Audio -->
      <button type="button" onclick="window.toggleSound && window.toggleSound()" class="btn-brutal bg-slate-100 dark:bg-slate-800 px-2.5 sm:px-3 py-1.5 text-xs font-bold" id="sound-btn">
        <span id="sound-icon" aria-hidden="true">🔇</span>
        <span id="sound-label">SND: OFF</span>
      </button>

      <!-- Toggle Theme -->
      <button type="button" onclick="window.toggleTheme && window.toggleTheme()" class="btn-brutal bg-scorch-gold text-black px-2.5 sm:px-3 py-1.5 text-xs font-bold" id="theme-btn">
        <span id="theme-icon" aria-hidden="true">☀️</span>
        <span id="theme-label">PAPER</span>
      </button>
    </div>
  </div>
</header>
