---
import Button from './Button.astro';
import Kbd from './Kbd.astro';
---

<header class="tui-window sticky top-4 z-40 mb-10">
  <div class="tui-header">
    <span class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 bg-scorch-cyan border border-black"></span>
      0xRYUKAMI_UI // SCORCH_OS v4.1.0
    </span>
    <div class="flex items-center gap-3">
      <span class="hidden sm:inline font-mono text-xs">PID: 9021 · MEM: 124MB</span>
      <div class="flex gap-1 text-xs select-none" aria-hidden="true">
        <span class="px-1 border border-current font-bold">[ _ ]</span>
        <span class="px-1 border border-current font-bold">[ □ ]</span>
        <span class="px-1 border border-current font-bold">[ × ]</span>
      </div>
    </div>
  </div>

  <div class="p-4 flex flex-wrap justify-between items-center gap-4 bg-white dark:bg-slate-900 border-b-2 border-black dark:border-slate-700">
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2">
        <span class="bg-scorch-crimson text-white border-2 border-black px-2 py-0.5 text-xs font-extrabold tracking-wider">
          RYUKAMI // UI
        </span>
        <span class="text-xs sm:text-sm font-bold tracking-tight">
          ~/scorch-components
        </span>
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <!-- Nav Links -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-3.5 text-xs font-bold uppercase">
        <a href="#components" class="hover:text-scorch-crimson hover:underline">[01_CORE]</a>
        <a href="#forms" class="hover:text-scorch-crimson hover:underline">[02_FORMS]</a>
        <a href="#alerts" class="hover:text-scorch-crimson hover:underline">[03_MODALS]</a>
        <a href="#theme-studio" class="hover:text-scorch-crimson hover:underline">[04_STUDIO]</a>
        <a href="#ascii-forge" class="hover:text-scorch-crimson hover:underline">[05_ASCII]</a>
      </nav>

      <!-- Botón Command Palette -->
      <button type="button" onclick="window.openPalette && window.openPalette()" class="btn-brutal bg-scorch-cyan text-black px-3 py-1.5 text-xs font-bold">
        <span aria-hidden="true">⌨️</span>
        <span>CMD+K</span>
      </button>

      <!-- Toggle Audio -->
      <button type="button" onclick="window.toggleSound && window.toggleSound()" class="btn-brutal bg-slate-100 dark:bg-slate-800 px-3 py-1.5 text-xs font-bold" id="sound-btn">
        <span id="sound-icon" aria-hidden="true">🔊</span>
        <span id="sound-label">SND: ON</span>
      </button>

      <!-- Toggle Theme -->
      <button type="button" onclick="window.toggleTheme && window.toggleTheme()" class="btn-brutal bg-scorch-gold text-black px-3 py-1.5 text-xs font-bold" id="theme-btn">
        <span id="theme-icon" aria-hidden="true">☀️</span>
        <span id="theme-label">PAPER</span>
      </button>
    </div>
  </div>
</header>
