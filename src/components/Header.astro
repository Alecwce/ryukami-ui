---
import Button from './Button.astro';
import Kbd from './Kbd.astro';
import Icon from './Icon.astro';
---

<header class="tui-window sticky top-0 z-40 mb-8 sm:mb-10">
  <div class="tui-header">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-scorch-cyan border border-black"></span>
      <span class="truncate">0xRYUKAMI_UI // SCORCH_OS v4.1.0</span>
    </span>
    <div class="flex items-center gap-3 shrink-0">
      <span class="hidden sm:inline font-mono text-xs leading-none">PID: 9021 · MEM: 124MB</span>
      <div class="inline-flex items-center gap-1 select-none" aria-hidden="true">
        <!-- Minimizar (-) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25">
          <span class="w-2.5 h-0.5 bg-current block"></span>
        </span>
        <!-- Maximizar (□) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25">
          <span class="w-2.5 h-2.5 border-[1.5px] border-current block"></span>
        </span>
        <!-- Cerrar (×) -->
        <span class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson text-white">
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <div class="px-2.5 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-2 sm:gap-3 flex-nowrap overflow-x-clip bg-white dark:bg-slate-900 border-b-2 border-black dark:border-slate-700">
    <div class="flex items-center gap-2 sm:gap-3 shrink-0 min-w-0">
      <a href="#hero" class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <span class="bg-scorch-crimson text-white border-2 border-black px-2 py-0.5 text-xs font-extrabold tracking-wider shrink-0 select-none">
          RYUKAMI // UI
        </span>
        <span class="hidden xl:inline text-xs sm:text-sm font-bold tracking-tight text-slate-600 dark:text-slate-400 truncate">
          ~/scorch-components
        </span>
      </a>
    </div>

    <!-- Nav Links con ScrollSpy (Oculto bajo lg, visible en escritorio) -->
    <nav
      aria-label="Navegación principal"
      id="header-nav-list"
      class="hidden lg:flex items-center gap-0.5 xl:gap-1 text-[11px] xl:text-xs font-bold uppercase shrink-0"
    >
      <a
        href="#components"
        data-header-nav="components"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [01_CORE]
      </a>
      <a
        href="#forms"
        data-header-nav="forms"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [02_FORMS]
      </a>
      <a
        href="#alerts"
        data-header-nav="alerts"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [03_MODALS]
      </a>
      <a
        href="#live-shell"
        data-header-nav="live-shell"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [04_SHELL]
      </a>
      <a
        href="#tables"
        data-header-nav="tables"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [05_TABLES]
      </a>
      <a
        href="#theme-studio"
        data-header-nav="theme-studio"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [06_STUDIO]
      </a>
      <a
        href="#ascii-forge"
        data-header-nav="ascii-forge"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [07_ASCII]
      </a>
      <a
        href="#install-docs"
        data-header-nav="install-docs"
        class="header-nav-link px-1.5 py-1 transition-colors border border-transparent hover:text-scorch-crimson"
      >
        [08_CLI]
      </a>
    </nav>

    <!-- 4 Acciones con altura idéntica h-8, leading-none e iconos w-3.5 h-3.5 alineados al pixel -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 flex-nowrap">
      <!-- GitHub Repo Link -->
      <a
        href="https://github.com/Alecwce/ryukami-ui"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal h-8 w-8 xl:w-auto px-0 xl:px-2.5 text-xs font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-black text-white dark:bg-white dark:text-black shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        aria-label="Repositorio oficial en GitHub"
        title="Ver repositorio en GitHub (Alecwce/ryukami-ui)"
      >
        <Icon name="github" class="w-3.5 h-3.5 block shrink-0" />
        <span class="hidden xl:inline leading-none">GITHUB</span>
      </a>

      <!-- Botón Command Palette -->
      <button
        type="button"
        onclick="window.openPalette && window.openPalette()"
        class="btn-brutal h-8 w-8 xl:w-auto px-0 xl:px-2.5 text-xs font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-scorch-cyan text-black shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        title="Abrir paleta de comandos (Ctrl+K)"
        aria-label="Abrir paleta de comandos (Ctrl+K)"
      >
        <Icon name="command" class="w-3.5 h-3.5 block shrink-0" />
        <span class="hidden xl:inline leading-none">CMD+K</span>
      </button>

      <!-- Toggle Audio -->
      <button
        type="button"
        onclick="window.toggleSound && window.toggleSound()"
        class="btn-brutal h-8 w-8 xl:w-auto px-0 xl:px-2.5 text-xs font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-slate-100 dark:bg-slate-800 text-black dark:text-white shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        id="sound-btn"
        title="Alternar sintetizador de sonido"
        aria-label="Alternar sintetizador de sonido"
      >
        <span id="sound-icon" class="inline-flex items-center shrink-0" aria-hidden="true">
          <span id="sound-icon-off" class="block"><Icon name="volume-x" class="w-3.5 h-3.5 block shrink-0" /></span>
          <span id="sound-icon-on" class="hidden"><Icon name="volume-2" class="w-3.5 h-3.5 block shrink-0" /></span>
        </span>
        <span id="sound-label" class="hidden xl:inline leading-none">SND: OFF</span>
      </button>

      <!-- Toggle Theme -->
      <button
        type="button"
        onclick="window.toggleTheme && window.toggleTheme()"
        class="btn-brutal h-8 w-8 xl:w-auto px-0 xl:px-2.5 text-xs font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-scorch-gold text-black shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        id="theme-btn"
        title="Alternar modo claro / modo oscuro"
        aria-label="Alternar modo claro / modo oscuro"
      >
        <span id="theme-icon" class="inline-flex items-center shrink-0" aria-hidden="true">
          <span id="theme-icon-sun" class="block"><Icon name="sun" class="w-3.5 h-3.5 block shrink-0" /></span>
          <span id="theme-icon-moon" class="hidden"><Icon name="moon" class="w-3.5 h-3.5 block shrink-0" /></span>
        </span>
        <span id="theme-label" class="hidden xl:inline leading-none">PAPER</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('header-nav-list');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll('a[data-header-nav]'));
    const targetIds = links.map((l) => l.getAttribute('data-header-nav')).filter(Boolean);

    const activeClasses = [
      'bg-black',
      'text-white',
      'dark:bg-white',
      'dark:text-black',
      'border-black',
      'dark:border-white',
    ];

    function setActive(activeId) {
      links.forEach((link) => {
        const isMatch = link.getAttribute('data-header-nav') === activeId;
        if (isMatch) {
          link.classList.add(...activeClasses);
          link.classList.remove('border-transparent');
        } else {
          link.classList.remove(...activeClasses);
          link.classList.add('border-transparent');
        }
      });
    }

    function scrollToSection(targetId) {
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      const header = document.querySelector('header.sticky');
      const headerHeight = header ? header.getBoundingClientRect().height : 92;
      const headerTop = header ? (parseFloat(window.getComputedStyle(header).top) || 16) : 16;
      const totalOffset = headerTop + headerHeight + 12;

      const elementPos = targetEl.getBoundingClientRect().top + window.scrollY;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: Math.max(0, elementPos - totalOffset),
        behavior: prefersReduced ? 'auto' : 'smooth',
      });

      setActive(targetId);
      history.replaceState(null, '', `#${targetId}`);
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-header-nav');
        if (targetId) {
          e.preventDefault();
          if (window.playMechanicalClick) window.playMechanicalClick();
          scrollToSection(targetId);
        }
      });
    });

    const initialHash = window.location.hash ? window.location.hash.slice(1) : '';
    if (initialHash && targetIds.includes(initialHash)) {
      setActive(initialHash);
    }

    const sections = targetIds.map((id) => document.getElementById(id)).filter(Boolean);
    if ('IntersectionObserver' in window && sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0 && visible[0].target.id) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: '-110px 0px -60% 0px',
          threshold: 0.05,
        }
      );
      sections.forEach((sec) => observer.observe(sec));
    }
  })();
</script>
