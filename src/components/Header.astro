---
import Button from './Button.astro';
import Kbd from './Kbd.astro';
import Icon from './Icon.astro';
import { THEME_PRESETS } from '../data/theme-presets';
---

<header class="tui-window sticky top-0 z-40 mb-8 sm:mb-10">
  <div class="tui-header">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-scorch-cyan border border-black"></span>
      <span class="truncate">0xRYUKAMI_UI // SCORCH_OS v4.1.0</span>
    </span>
    <div class="flex items-center gap-3 shrink-0">
      <span class="hidden sm:inline font-mono text-xs leading-none">PID: 9021 · MEM: 124MB</span>
      <div class="inline-flex items-center gap-1 select-none">
        <!-- Minimizar (-) -->
        <button
          type="button"
          aria-label="Minimizar o restaurar consola"
          title="Minimizar o restaurar consola"
          onclick="window.showToast && window.showToast('0xKERNEL // SHELL', 'Consola fija de sistema activa.', 'cyan', 2000)"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25 hover:bg-white hover:text-black cursor-pointer transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-scorch-cyan"
        >
          <span class="w-2.5 h-0.5 bg-current block" aria-hidden="true"></span>
        </button>
        <!-- Maximizar (□) -->
        <button
          type="button"
          aria-label="Resaltar consola"
          title="Resaltar consola"
          onclick="window.showToast && window.showToast('0xKERNEL // FOCUS', 'Pantalla completa de Scorch OS activa.', 'gold', 2000)"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-black/25 hover:bg-scorch-cyan hover:text-black cursor-pointer transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-scorch-cyan"
        >
          <span class="w-2.5 h-2.5 border-[1.5px] border-current block" aria-hidden="true"></span>
        </button>
        <!-- Cerrar (×) -->
        <button
          type="button"
          aria-label="Proceso de sistema protegido"
          title="Proceso de sistema protegido"
          onclick="window.showToast && window.showToast('0xKERNEL // PROTECTED', 'El kernel Scorch es inmutable y no se puede terminar.', 'crimson', 2200)"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson hover:bg-white text-white hover:text-black cursor-pointer transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-white"
        >
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="px-2 sm:px-4 py-2 sm:py-2.5 flex items-center justify-between gap-1.5 sm:gap-3 flex-nowrap relative bg-white dark:bg-slate-900 border-b-2 border-black dark:border-slate-700">
    <div class="flex items-center gap-3 lg:gap-5 shrink-0 min-w-0">
      <a href="#hero" class="flex items-center gap-2 shrink-0" title="Ir al inicio (Ryukami-UI)">
        <span class="bg-scorch-crimson text-white border-2 border-black px-2 py-0.5 text-xs font-extrabold tracking-wider shrink-0 select-none">
          RYUKAMI // UI
        </span>
      </a>

      <!-- Nav Links estilo 8bitcn / shadcn (Docs, Components, Blocks, Shell, Themes) -->
      <nav
        aria-label="Navegación principal"
        id="header-nav-list"
        class="hidden md:flex items-center gap-0.5 lg:gap-1.5 text-[11px] lg:text-xs font-bold uppercase shrink-0"
      >
        <a
          href="/docs"
          class="header-nav-link px-1.5 lg:px-2 py-1 whitespace-nowrap transition-colors border border-transparent hover:text-scorch-crimson"
        >
          Docs
        </a>
        <a
          href="/docs/components"
          class="header-nav-link px-1.5 lg:px-2 py-1 whitespace-nowrap transition-colors border border-transparent hover:text-scorch-crimson"
        >
          Components
        </a>
        <a
          href="/blocks"
          class="header-nav-link px-1.5 lg:px-2 py-1 whitespace-nowrap transition-colors border border-transparent hover:text-scorch-crimson"
        >
          Blocks
        </a>
        <a
          href="/blocks#shell"
          class="header-nav-link px-1.5 lg:px-2 py-1 whitespace-nowrap transition-colors border border-transparent hover:text-scorch-crimson"
        >
          Shell
        </a>
        <a
          href="/themes"
          class="header-nav-link px-1.5 lg:px-2 py-1 whitespace-nowrap transition-colors border border-transparent hover:text-scorch-crimson"
        >
          Themes
        </a>
      </nav>
    </div>

    <!-- 4 Acciones con altura idéntica h-8, leading-none e iconos w-3.5 h-3.5 alineados al pixel -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0 flex-nowrap">
      <!-- Botón Buscador / Command Palette (estilo 8bitcn Search docs... Cmd+K) -->
      <button
        type="button"
        onclick="window.openPalette && window.openPalette()"
        class="btn-brutal h-8 w-8 lg:w-auto px-0 lg:px-2.5 text-[11px] font-bold leading-none inline-flex items-center justify-center lg:justify-between gap-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        title="Buscar documentación y componentes (Ctrl+K)"
        aria-label="Buscar documentación y componentes (Ctrl+K)"
      >
        <span class="inline-flex items-center gap-1.5">
          <Icon name="command" class="w-3.5 h-3.5 block shrink-0 text-scorch-crimson dark:text-scorch-cyan" />
          <span class="hidden lg:inline leading-none">Search docs...</span>
        </span>
        <span class="hidden lg:inline-block bg-black text-scorch-gold px-1.5 py-0.5 text-[10px] border border-black leading-none">
          CMD+K
        </span>
      </button>

      <!-- GitHub Repo Link -->
      <a
        href="https://github.com/Alecwce/ryukami-ui"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutal h-8 w-8 lg:w-auto px-0 lg:px-2.5 text-[11px] font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-black text-white dark:bg-white dark:text-black shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        aria-label="Repositorio oficial en GitHub"
        title="Ver repositorio en GitHub (Alecwce/ryukami-ui)"
      >
        <Icon name="github" class="w-3.5 h-3.5 block shrink-0" />
        <span class="hidden lg:inline leading-none">GITHUB</span>
      </a>

      <!-- Toggle Audio -->
      <button
        type="button"
        onclick="window.toggleSound && window.toggleSound()"
        class="btn-brutal h-8 w-8 xl:w-auto px-0 xl:px-2 text-[11px] font-bold leading-none inline-flex items-center justify-center gap-1 bg-slate-100 dark:bg-slate-800 text-black dark:text-white shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        id="sound-btn"
        role="switch"
        aria-checked="false"
        title="Alternar sintetizador de sonido mecánico"
        aria-label="Alternar sintetizador de sonido mecánico"
      >
        <span id="sound-icon" class="inline-flex items-center shrink-0" aria-hidden="true">
          <span id="sound-icon-off" class="block"><Icon name="volume-x" class="w-3.5 h-3.5 block shrink-0" /></span>
          <span id="sound-icon-on" class="hidden"><Icon name="volume-2" class="w-3.5 h-3.5 block shrink-0" /></span>
        </span>
        <span id="sound-label" class="hidden xl:inline leading-none">SND: OFF</span>
      </button>

      <!-- Quick Palette Picker (Fase 5) -->
      <div class="relative shrink-0" id="palette-picker-container">
        <button
          type="button"
          id="palette-dropdown-btn"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="Seleccionar paleta de colores del sistema"
          title="Seleccionar paleta de colores Scorch"
          class="btn-brutal h-8 w-8 sm:w-auto px-0 sm:px-2 text-[11px] font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-slate-100 dark:bg-slate-800 text-black dark:text-white shrink-0 relative after:absolute after:-inset-1.5 after:content-[''] cursor-pointer"
        >
          <span id="palette-swatch" class="w-3 h-3 border border-black inline-block shrink-0 bg-scorch-crimson"></span>
          <span id="palette-label" class="hidden sm:inline font-mono leading-none">SCORCH</span>
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2] hidden sm:block shrink-0" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5L5 6.5L8 3.5" stroke-linecap="square" />
          </svg>
        </button>

        <!-- Menu Desplegable Brutalista -->
        <div
          id="palette-dropdown-menu"
          role="menu"
          aria-label="Paletas de color disponibles"
          class="hidden absolute right-0 top-full mt-2 w-56 sm:w-64 bg-white dark:bg-slate-900 border-2 border-black dark:border-white shadow-brutal z-50 font-mono text-xs select-none"
        >
          <div class="tui-header bg-black dark:bg-scorch-crimson text-white px-2.5 py-1 text-[10px] font-extrabold flex items-center justify-between border-b-2 border-black">
            <span>0xPALETTE // PRESETS</span>
            <span class="opacity-75">6 TEMAS</span>
          </div>
          <div class="p-1 space-y-0.5" id="palette-menu-items">
            {THEME_PRESETS.map((p) => (
              <button
                type="button"
                role="menuitem"
                data-preset-id={p.id}
                data-preset-name={p.name}
                data-preset-color={p.colors.primary}
                class="palette-item w-full text-left px-2 py-1.5 flex items-center justify-between text-xs border border-transparent hover:border-black hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer"
                aria-label={`Activar paleta ${p.name}`}
              >
                <span class="flex items-center gap-2 min-w-0">
                  <span class="w-3 h-3 border border-black inline-block shrink-0" style={`background-color: ${p.colors.primary};`}></span>
                  <span class="font-bold truncate text-[11px] sm:text-xs text-slate-800 dark:text-slate-100">{p.name}</span>
                </span>
                <span class="flex items-center gap-1.5 shrink-0">
                  <span class="text-[9px] px-1 py-0.2 border border-black bg-black text-white dark:bg-white dark:text-black font-extrabold">{p.tag}</span>
                  <span class="palette-check hidden text-[10px] font-extrabold text-scorch-crimson dark:text-scorch-cyan">&gt;</span>
                </span>
              </button>
            ))}
          </div>
          <div class="p-2 border-t-2 border-black/10 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 flex items-center justify-between text-[10px]">
            <span class="text-slate-600 dark:text-slate-400">Tokens personalizados</span>
            <a href="/themes#studio" class="underline font-bold text-scorch-crimson hover:text-black dark:hover:text-white">
              STUDIO &gt;
            </a>
          </div>
        </div>
      </div>

      <!-- Toggle Theme -->
      <button
        type="button"
        onclick="window.toggleTheme && window.toggleTheme()"
        class="btn-brutal h-8 w-8 lg:w-auto px-0 lg:px-2.5 text-[11px] font-bold leading-none inline-flex items-center justify-center gap-1.5 bg-scorch-gold text-black shrink-0 relative after:absolute after:-inset-1.5 after:content-['']"
        id="theme-btn"
        title="Alternar modo claro / modo oscuro"
        aria-label="Alternar modo claro / modo oscuro"
      >
        <span id="theme-icon" class="inline-flex items-center shrink-0" aria-hidden="true">
          <span id="theme-icon-sun" class="block"><Icon name="sun" class="w-3.5 h-3.5 block shrink-0" /></span>
          <span id="theme-icon-moon" class="hidden"><Icon name="moon" class="w-3.5 h-3.5 block shrink-0" /></span>
        </span>
        <span id="theme-label" class="hidden lg:inline leading-none">PAPER</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const nav = document.getElementById('header-nav-list');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll('a[data-header-nav]'));
    const targetIds = links.map((l) => l.getAttribute('data-header-nav')).filter(Boolean);

    const activeClasses = [
      'bg-black',
      'text-white',
      'dark:bg-white',
      'dark:text-black',
      'border-black',
      'dark:border-white',
    ];

    function setActive(activeId) {
      links.forEach((link) => {
        const isMatch = link.getAttribute('data-header-nav') === activeId;
        if (isMatch) {
          link.classList.add(...activeClasses);
          link.classList.remove('border-transparent');
        } else {
          link.classList.remove(...activeClasses);
          link.classList.add('border-transparent');
        }
      });
    }

    function scrollToSection(targetId) {
      const targetEl = document.getElementById(targetId);
      if (!targetEl) return;

      const header = document.querySelector('header.sticky');
      const headerHeight = header ? header.getBoundingClientRect().height : 92;
      const headerTop = header ? (parseFloat(window.getComputedStyle(header).top) || 16) : 16;
      const totalOffset = headerTop + headerHeight + 12;

      const elementPos = targetEl.getBoundingClientRect().top + window.scrollY;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({
        top: Math.max(0, elementPos - totalOffset),
        behavior: prefersReduced ? 'auto' : 'smooth',
      });

      setActive(targetId);
      history.replaceState(null, '', `#${targetId}`);
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const targetId = link.getAttribute('data-header-nav');
        if (targetId) {
          e.preventDefault();
          if (window.playMechanicalClick) window.playMechanicalClick();
          scrollToSection(targetId);
        }
      });
    });

    const initialHash = window.location.hash ? window.location.hash.slice(1) : '';
    if (initialHash && targetIds.includes(initialHash)) {
      setActive(initialHash);
    }

    const sections = targetIds.map((id) => document.getElementById(id)).filter(Boolean);
    if ('IntersectionObserver' in window && sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0 && visible[0].target.id) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: '-110px 0px -60% 0px',
          threshold: 0.05,
        }
      );
      sections.forEach((sec) => observer.observe(sec));
    }
  })();

  // Quick Palette Picker Dropdown Controller (Fase 5)
  (function () {
    const btn = document.getElementById('palette-dropdown-btn');
    const menu = document.getElementById('palette-dropdown-menu');
    const swatch = document.getElementById('palette-swatch');
    const label = document.getElementById('palette-label');
    const items = menu ? Array.from(menu.querySelectorAll('.palette-item')) : [];

    const PRESET_SHORT_NAMES = {
      'scorch': 'SCORCH',
      'matrix': 'MATRIX',
      'amber': 'DUNGEON',
      'paper': 'PAPER',
      'cyber': 'CYBER',
      'emperor': 'VELGRYND'
    };

    function updateHeaderPaletteUI(presetId, primaryColor) {
      if (swatch && primaryColor) {
        swatch.style.backgroundColor = primaryColor;
      }
      if (label) {
        label.textContent = PRESET_SHORT_NAMES[presetId] || presetId.toUpperCase();
      }
      items.forEach((item) => {
        const id = item.getAttribute('data-preset-id');
        const isCurrent = id === presetId;
        item.classList.toggle('bg-slate-200', isCurrent);
        item.classList.toggle('dark:bg-slate-800', isCurrent);
        item.classList.toggle('border-black', isCurrent);
        item.classList.toggle('font-extrabold', isCurrent);
        const check = item.querySelector('.palette-check');
        if (check) check.classList.toggle('hidden', !isCurrent);
      });
    }

    const currentPresetId = localStorage.getItem('ryukami-theme-preset') || 'scorch';
    const activeItem = items.find((i) => i.getAttribute('data-preset-id') === currentPresetId);
    if (activeItem) {
      updateHeaderPaletteUI(currentPresetId, activeItem.getAttribute('data-preset-color'));
    }

    if (btn && menu) {
      function openMenu() {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !menu.classList.contains('hidden');
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      document.addEventListener('click', (e) => {
        if (!menu.classList.contains('hidden') && !menu.contains(e.target) && !btn.contains(e.target)) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
          closeMenu();
          btn.focus();
        }
      });

      items.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const presetId = item.getAttribute('data-preset-id');
          const presetColor = item.getAttribute('data-preset-color');
          if (window.applyThemePreset) {
            window.applyThemePreset(presetId);
          }
          updateHeaderPaletteUI(presetId, presetColor);
          closeMenu();
        });
      });
    }

    window.addEventListener('ryukami:theme-change', (e) => {
      if (e.detail && e.detail.presetId && e.detail.theme) {
        updateHeaderPaletteUI(e.detail.presetId, e.detail.theme.primary);
      }
    });
  })();
</script>
