---
export interface Props {
  id?: string;
  triggerLabel: string;
  title: string;
  status?: string;
  variant?: 'crimson' | 'cyan' | 'gold' | 'outline';
}

const {
  id = `scorch-popover-${Math.random().toString(36).substring(2, 8)}`,
  triggerLabel = 'INSPECCIONAR NODO',
  title = '0xPOPOVER // TELEMETRY_NODE',
  status = 'POPOVER_API',
  variant = 'cyan',
} = Astro.props;

const variantClasses = {
  crimson: 'bg-scorch-crimson text-white',
  cyan: 'bg-scorch-cyan text-black',
  gold: 'bg-scorch-gold text-black',
  outline: 'bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100',
};
---

<div class="inline-block font-mono text-xs">
  <button
    type="button"
    popovertarget={id}
    class={`btn-brutal px-4 py-2 text-xs font-extrabold ${variantClasses[variant]}`}
  >
    <span>{triggerLabel}</span>
    <span class="text-[10px] border border-current px-1">⊞</span>
  </button>

  <div
    id={id}
    popover="auto"
    class="tui-window w-[calc(100vw-2rem)] max-w-sm p-0 m-auto bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border-2 border-black dark:border-slate-200 shadow-[-8px_8px_0px_0px_var(--shadow-color,#000000)]"
  >
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
      <span class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-scorch-gold border border-black"></span>
        <span>{title}</span>
      </span>
      <div class="flex items-center gap-2">
        <span class="bg-black text-scorch-cyan px-1.5 py-0.5 text-[10px] border border-slate-700 font-bold">
          {status}
        </span>
        <button
          type="button"
          popovertarget={id}
          popovertargetaction="hide"
          aria-label="Cerrar popover"
          class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson text-white hover:bg-white hover:text-black cursor-pointer"
        >
          <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none">
            <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
          </svg>
        </button>
      </div>
    </div>

    <div class="p-4 space-y-3 text-xs leading-relaxed">
      <slot />
    </div>
  </div>
</div>
