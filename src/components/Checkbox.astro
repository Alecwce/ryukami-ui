---
interface Props {
  label: string;
  id?: string;
  name?: string;
  checked?: boolean;
  disabled?: boolean;
  description?: string;
}

const {
  label,
  id,
  name,
  checked = false,
  disabled = false,
  description,
} = Astro.props;

const checkboxId = id || `chk-${Math.random().toString(36).substring(2, 9)}`;
---

<label for={checkboxId} class="inline-flex items-start gap-3 cursor-pointer select-none group font-mono text-xs">
  <div class="relative flex items-center justify-center mt-0.5">
    <input
      type="checkbox"
      id={checkboxId}
      name={name}
      checked={checked}
      disabled={disabled}
      class="peer sr-only"
    />
    <div class="w-5 h-5 bg-white dark:bg-slate-900 border-2 border-black dark:border-slate-700 shadow-[-2px_2px_0px_0px_var(--shadow-color,#000000)] rounded-none flex items-center justify-center transition-transform peer-checked:bg-scorch-crimson peer-checked:text-white peer-checked:border-black group-hover:translate-x-0.5 group-hover:-translate-y-0.5 peer-disabled:opacity-50 peer-disabled:cursor-not-allowed">
      <span class="opacity-0 peer-checked:opacity-100 font-extrabold text-xs">✕</span>
    </div>
  </div>

  <div class="space-y-0.5">
    <span class="block font-bold uppercase tracking-wide group-hover:text-scorch-crimson">
      {label}
    </span>
    {description && (
      <span class="block text-[11px] text-slate-700 dark:text-slate-300 leading-relaxed">
        {description}
      </span>
    )}
  </div>
</label>
