---
import Button from './Button.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`tui-window overflow-hidden font-mono select-none ${className}`} id="scorch-arcade-container">
  <!-- Cabecera de la Ventana Arcade -->
  <div class="tui-header bg-black dark:bg-scorch-crimson text-white flex flex-wrap justify-between items-center gap-2">
    <div class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 bg-scorch-gold border border-black shrink-0"></span>
      <span class="font-extrabold truncate text-xs sm:text-sm">
        0xARCADE // SCORCH_DEFENDER_8BIT
      </span>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="hidden sm:inline-block bg-black text-scorch-cyan px-2 py-0.5 border border-slate-700 text-[10px] font-bold">
        HTML5 CANVAS + WEB AUDIO
      </span>
      <div class="inline-flex items-center gap-1 select-none">
        <span class="w-4 h-4 border border-current inline-flex items-center justify-center text-[10px]">-</span>
        <span class="w-4 h-4 border border-current inline-flex items-center justify-center text-[10px]">□</span>
        <span class="w-4 h-4 border border-current inline-flex items-center justify-center bg-scorch-crimson text-white text-[10px]">×</span>
      </div>
    </div>
  </div>

  <!-- Barra de Telemetria y Puntuacion -->
  <div class="bg-slate-950 text-slate-100 p-3 sm:px-5 border-b-2 border-black dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-4 sm:gap-6 flex-wrap">
      <div>
        <span class="text-slate-500 text-[10px] block font-bold uppercase">SCORE</span>
        <span id="arcade-score" class="text-scorch-gold font-extrabold text-sm sm:text-base">00000</span>
      </div>
      <div>
        <span class="text-slate-500 text-[10px] block font-bold uppercase">HI-SCORE</span>
        <span id="arcade-highscore" class="text-emerald-400 font-extrabold text-sm sm:text-base">00000</span>
      </div>
      <div>
        <span class="text-slate-500 text-[10px] block font-bold uppercase">ESCUDOS</span>
        <div id="arcade-shields" class="flex gap-1 text-scorch-crimson font-black text-sm">
          <span>[■]</span>
          <span>[■]</span>
          <span>[■]</span>
        </div>
      </div>
      <div>
        <span class="text-slate-500 text-[10px] block font-bold uppercase">ESTADO</span>
        <span id="arcade-status" class="text-scorch-cyan font-bold text-xs uppercase">EN ESPERA</span>
      </div>
    </div>

    <!-- Controles Rápidos -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="arcade-sound-btn"
        class="btn-brutal bg-slate-800 hover:bg-slate-700 text-white px-2.5 py-1 text-[11px] font-bold inline-flex items-center gap-1.5"
        title="Alternar audio arcade"
      >
        <Icon name="volume-2" class="w-3 h-3 text-scorch-gold" />
        <span id="arcade-sound-label">SND: ON</span>
      </button>

      <button
        type="button"
        id="arcade-main-btn"
        class="btn-brutal bg-scorch-crimson hover:bg-black text-white px-3 py-1 text-[11px] font-extrabold inline-flex items-center gap-1.5"
      >
        <span>&gt; INICIAR JUEGO</span>
      </button>
    </div>
  </div>

  <!-- Area del Canvas del Juego -->
  <div class="relative bg-black flex items-center justify-center p-2 sm:p-4 overflow-hidden">
    <canvas
      id="scorch-arcade-canvas"
      width="640"
      height="360"
      class="w-full max-w-full aspect-[16/9] border-2 border-slate-800 shadow-[-4px_4px_0px_0px_#000000] bg-[#05070A] cursor-crosshair focus:outline-none focus:border-scorch-crimson"
      tabindex="0"
      aria-label="Pantalla interactiva del juego arcade Scorch Defender"
    ></canvas>

    <!-- Overlay de Instrucciones / Pantalla de Inicio -->
    <div
      id="arcade-start-overlay"
      class="absolute inset-0 bg-black/85 flex flex-col items-center justify-center p-4 text-center space-y-4"
    >
      <div class="space-y-1">
        <span class="text-scorch-gold text-[10px] font-bold uppercase tracking-widest block">
          // SECTOR 404 DEFENSA KERNEL
        </span>
        <h3 class="title-8bit text-xl sm:text-3xl text-white">
          SCORCH DEFENDER
        </h3>
        <p class="text-xs text-slate-300 max-w-md mx-auto pt-1 leading-relaxed">
          Destruye los fragmentos de memoria corruptos <span class="text-scorch-crimson font-bold">[404]</span>, <span class="text-scorch-cyan font-bold">[NULL]</span> y <span class="text-scorch-gold font-bold">[BUG]</span> antes de que penetren el firewall del sistema.
        </p>
      </div>

      <div class="p-3 bg-slate-900/90 border border-slate-700 max-w-sm w-full text-xs space-y-1.5 text-left text-slate-300">
        <div class="flex justify-between items-center">
          <span class="font-bold text-white">Mover cañón:</span>
          <span class="text-scorch-gold font-bold">[A] / [D] o [←] / [→]</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="font-bold text-white">Disparar plasma:</span>
          <span class="text-scorch-cyan font-bold">[ESPACIO]</span>
        </div>
        <div class="flex justify-between items-center">
          <span class="font-bold text-white">Pausar:</span>
          <span class="text-slate-400 font-bold">[P]</span>
        </div>
      </div>

      <button
        type="button"
        id="arcade-overlay-start-btn"
        class="btn-brutal bg-scorch-gold hover:bg-white text-black px-6 py-2.5 text-xs font-black uppercase tracking-wider"
      >
        &gt; DESPLEGAR CAÑÓN SCORCH
      </button>
    </div>
  </div>

  <!-- Botonera Táctil en Móviles (Visible solo en pantallas táctiles / móviles) -->
  <div class="p-3 bg-slate-900 border-t-2 border-black dark:border-slate-800 flex items-center justify-between gap-2 sm:hidden text-xs">
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="touch-left-btn"
        class="btn-brutal bg-slate-800 active:bg-scorch-cyan active:text-black text-white w-12 h-10 font-black text-sm flex items-center justify-center select-none"
        aria-label="Mover a la izquierda"
      >
        &lt;
      </button>
      <button
        type="button"
        id="touch-right-btn"
        class="btn-brutal bg-slate-800 active:bg-scorch-cyan active:text-black text-white w-12 h-10 font-black text-sm flex items-center justify-center select-none"
        aria-label="Mover a la derecha"
      >
        &gt;
      </button>
    </div>

    <button
      type="button"
      id="touch-fire-btn"
      class="btn-brutal bg-scorch-crimson active:bg-white active:text-black text-white flex-1 h-10 font-black text-xs uppercase flex items-center justify-center gap-1.5 select-none"
      aria-label="Disparar plasma"
    >
      <Icon name="zap" class="w-3.5 h-3.5" />
      <span>DISPARAR</span>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    const canvas = document.getElementById('scorch-arcade-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Elementos del DOM
    const scoreEl = document.getElementById('arcade-score');
    const highScoreEl = document.getElementById('arcade-highscore');
    const shieldsEl = document.getElementById('arcade-shields');
    const statusEl = document.getElementById('arcade-status');
    const soundBtn = document.getElementById('arcade-sound-btn');
    const soundLabel = document.getElementById('arcade-sound-label');
    const mainBtn = document.getElementById('arcade-main-btn');
    const overlay = document.getElementById('arcade-start-overlay');
    const overlayStartBtn = document.getElementById('arcade-overlay-start-btn');

    // Botones táctiles
    const touchLeftBtn = document.getElementById('touch-left-btn');
    const touchRightBtn = document.getElementById('touch-right-btn');
    const touchFireBtn = document.getElementById('touch-fire-btn');

    // Sonido Arcade Web Audio API
    let audioCtx = null;
    let soundEnabled = true;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playLaserSound() {
      if (!soundEnabled) return;
      try {
        initAudio();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'square';
        osc.frequency.setValueAtTime(880, now);
        osc.frequency.exponentialRampToValueAtTime(180, now + 0.08);

        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.08);
      } catch (e) {}
    }

    function playHitSound() {
      if (!soundEnabled) return;
      try {
        initAudio();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(320, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.12);

        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.12);
      } catch (e) {}
    }

    function playDamageSound() {
      if (!soundEnabled) return;
      try {
        initAudio();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(140, now);
        osc.frequency.exponentialRampToValueAtTime(40, now + 0.25);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start(now);
        osc.stop(now + 0.25);
      } catch (e) {}
    }

    function playGameOverSound() {
      if (!soundEnabled) return;
      try {
        initAudio();
        const now = audioCtx.currentTime;
        [330, 294, 262, 196].forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          const start = now + idx * 0.1;
          osc.type = 'square';
          osc.frequency.setValueAtTime(freq, start);
          gain.gain.setValueAtTime(0.15, start);
          gain.gain.exponentialRampToValueAtTime(0.001, start + 0.1);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(start);
          osc.stop(start + 0.1);
        });
      } catch (e) {}
    }

    // Estado del Juego
    const HIGH_SCORE_KEY = 'ryukami-404-arcade-highscore';
    let highScore = parseInt(localStorage.getItem(HIGH_SCORE_KEY) || '0', 10);
    if (highScoreEl) highScoreEl.textContent = String(highScore).padStart(5, '0');

    let gameState = 'IDLE'; // 'IDLE', 'PLAYING', 'PAUSED', 'GAMEOVER'
    let score = 0;
    let shields = 3;
    let animationId = null;
    let lastSpawnTime = 0;
    let spawnInterval = 1200; // ms

    // Entidades
    const player = {
      x: canvas.width / 2 - 25,
      y: canvas.height - 32,
      width: 50,
      height: 18,
      speed: 6,
      vx: 0,
    };

    let lasers = [];
    let enemies = [];
    let particles = [];
    const stars = Array.from({ length: 45 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      size: Math.random() > 0.8 ? 2 : 1,
      speed: 0.3 + Math.random() * 0.7,
    }));

    const ENEMY_LABELS = [
      { text: '[404]', color: '#D62436', points: 30 },
      { text: '[NULL]', color: '#4DA3FF', points: 20 },
      { text: '[BUG]', color: '#F4D35E', points: 25 },
      { text: '[ERR]', color: '#E11D48', points: 35 },
      { text: '[FAULT]', color: '#10B981', points: 40 },
    ];

    // Entrada de Teclado
    const keys = {
      left: false,
      right: false,
      space: false,
    };

    function updateTelemetry() {
      if (scoreEl) scoreEl.textContent = String(score).padStart(5, '0');
      if (highScoreEl) highScoreEl.textContent = String(highScore).padStart(5, '0');
      if (shieldsEl) {
        let shieldBars = '';
        for (let i = 0; i < 3; i++) {
          shieldBars += i < shields ? '<span class="text-scorch-crimson">[■]</span>' : '<span class="text-slate-700">[ ]</span>';
        }
        shieldsEl.innerHTML = shieldBars;
      }
      if (statusEl) {
        statusEl.textContent =
          gameState === 'PLAYING'
            ? 'ONLINE'
            : gameState === 'PAUSED'
            ? 'EN PAUSA'
            : gameState === 'GAMEOVER'
            ? 'DEFENSA CAÍDA'
            : 'EN ESPERA';
      }
    }

    function spawnEnemy() {
      const type = ENEMY_LABELS[Math.floor(Math.random() * ENEMY_LABELS.length)];
      const width = 56;
      const height = 18;
      const x = Math.max(10, Math.min(canvas.width - width - 10, Math.random() * (canvas.width - width)));
      const speed = 1.0 + Math.min(2.5, score / 400);

      enemies.push({
        x,
        y: -height,
        width,
        height,
        text: type.text,
        color: type.color,
        points: type.points,
        speed,
      });
    }

    function shootLaser() {
      if (gameState !== 'PLAYING') return;
      lasers.push({
        x: player.x + player.width / 2 - 2,
        y: player.y - 8,
        width: 4,
        height: 10,
        speed: 8,
      });
      playLaserSound();
    }

    function createExplosion(x, y, color) {
      for (let i = 0; i < 14; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = 1 + Math.random() * 4;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          size: Math.random() > 0.5 ? 3 : 2,
          color,
          alpha: 1.0,
          decay: 0.03 + Math.random() * 0.03,
        });
      }
    }

    function startGame() {
      initAudio();
      gameState = 'PLAYING';
      score = 0;
      shields = 3;
      lasers = [];
      enemies = [];
      particles = [];
      player.x = canvas.width / 2 - player.width / 2;
      lastSpawnTime = performance.now();
      if (overlay) overlay.classList.add('hidden');
      if (mainBtn) mainBtn.textContent = '|| PAUSAR';
      updateTelemetry();
      canvas.focus();
    }

    function pauseGame() {
      if (gameState === 'PLAYING') {
        gameState = 'PAUSED';
        if (mainBtn) mainBtn.textContent = '> REANUDAR';
      } else if (gameState === 'PAUSED') {
        gameState = 'PLAYING';
        if (mainBtn) mainBtn.textContent = '|| PAUSAR';
        lastSpawnTime = performance.now();
      }
      updateTelemetry();
    }

    function gameOver() {
      gameState = 'GAMEOVER';
      playGameOverSound();
      if (score > highScore) {
        highScore = score;
        try {
          localStorage.setItem(HIGH_SCORE_KEY, String(highScore));
        } catch (e) {}
      }
      updateTelemetry();
      if (mainBtn) mainBtn.textContent = '> REINTENTAR';
    }

    // Bucle Principal de Renderizado
    function gameLoop(now) {
      // 1. Limpieza con fondo TUI CRT
      ctx.fillStyle = '#05070A';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // 2. Fondo de Estrellas y Matriz Dither
      ctx.fillStyle = '#1E293B';
      stars.forEach((star) => {
        star.y += star.speed;
        if (star.y > canvas.height) {
          star.y = 0;
          star.x = Math.random() * canvas.width;
        }
        ctx.fillRect(star.x, star.y, star.size, star.size);
      });

      // 3. Línea del Firewall en la Base
      ctx.strokeStyle = '#D62436';
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 6]);
      ctx.beginPath();
      ctx.moveTo(0, canvas.height - 12);
      ctx.lineTo(canvas.width, canvas.height - 12);
      ctx.stroke();
      ctx.setLineDash([]);

      if (gameState === 'PLAYING') {
        // Movimiento Jugador
        if (keys.left) player.x -= player.speed;
        if (keys.right) player.x += player.speed;
        player.x = Math.max(6, Math.min(canvas.width - player.width - 6, player.x));

        // Spawn de Enemigos
        if (now - lastSpawnTime > spawnInterval) {
          spawnEnemy();
          lastSpawnTime = now;
          spawnInterval = Math.max(500, 1200 - score * 0.5);
        }

        // Actualizar Láseres
        for (let i = lasers.length - 1; i >= 0; i--) {
          const l = lasers[i];
          l.y -= l.speed;
          if (l.y < -10) {
            lasers.splice(i, 1);
            continue;
          }

          // Colisión Láser vs Enemigos
          for (let j = enemies.length - 1; j >= 0; j--) {
            const e = enemies[j];
            if (
              l.x < e.x + e.width &&
              l.x + l.width > e.x &&
              l.y < e.y + e.height &&
              l.y + l.height > e.y
            ) {
              createExplosion(e.x + e.width / 2, e.y + e.height / 2, e.color);
              score += e.points;
              if (score > highScore) highScore = score;
              playHitSound();
              enemies.splice(j, 1);
              lasers.splice(i, 1);
              updateTelemetry();
              break;
            }
          }
        }

        // Actualizar Enemigos
        for (let i = enemies.length - 1; i >= 0; i--) {
          const e = enemies[i];
          e.y += e.speed;

          // Impacto en el Firewall
          if (e.y + e.height >= canvas.height - 12) {
            createExplosion(e.x + e.width / 2, e.y + e.height / 2, '#D62436');
            playDamageSound();
            enemies.splice(i, 1);
            shields--;
            updateTelemetry();

            if (shields <= 0) {
              gameOver();
              break;
            }
          }
        }
      }

      // Dibujar Partículas
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          particles.splice(i, 1);
          continue;
        }

        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.alpha;
        ctx.fillRect(p.x, p.y, p.size, p.size);
      }
      ctx.globalAlpha = 1.0;

      // Dibujar Láseres
      ctx.fillStyle = '#4DA3FF';
      lasers.forEach((l) => {
        ctx.fillRect(l.x, l.y, l.width, l.height);
      });

      // Dibujar Enemigos
      enemies.forEach((e) => {
        // Caja exterior
        ctx.fillStyle = '#0B0F17';
        ctx.fillRect(e.x, e.y, e.width, e.height);
        ctx.strokeStyle = e.color;
        ctx.lineWidth = 1.5;
        ctx.strokeRect(e.x, e.y, e.width, e.height);

        // Texto 8-Bit
        ctx.fillStyle = e.color;
        ctx.font = 'bold 10px monospace';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(e.text, e.x + e.width / 2, e.y + e.height / 2);
      });

      // Dibujar Cañón del Jugador [=▲=]
      // Base
      ctx.fillStyle = '#D62436';
      ctx.fillRect(player.x, player.y + 6, player.width, player.height - 6);
      ctx.strokeStyle = '#000000';
      ctx.lineWidth = 2;
      ctx.strokeRect(player.x, player.y + 6, player.width, player.height - 6);

      // Torreta central
      ctx.fillStyle = '#F4D35E';
      ctx.fillRect(player.x + player.width / 2 - 4, player.y, 8, 8);
      ctx.strokeStyle = '#000000';
      ctx.strokeRect(player.x + player.width / 2 - 4, player.y, 8, 8);

      // Propulsores laterales
      ctx.fillStyle = '#4DA3FF';
      ctx.fillRect(player.x + 3, player.y + player.height, 8, 3);
      ctx.fillRect(player.x + player.width - 11, player.y + player.height, 8, 3);

      // Pantallas de Estado
      if (gameState === 'GAMEOVER') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.85)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#D62436';
        ctx.font = 'bold 22px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('0x404 // KERNEL DESINTEGRADO', canvas.width / 2, canvas.height / 2 - 20);

        ctx.fillStyle = '#F8FAFC';
        ctx.font = '13px monospace';
        ctx.fillText(`PUNTUACIÓN FINAL: ${String(score).padStart(5, '0')}`, canvas.width / 2, canvas.height / 2 + 15);

        ctx.fillStyle = '#F4D35E';
        ctx.font = '11px monospace';
        ctx.fillText('HAZ CLIC EN [REINTENTAR] PARA REINICIAR DEFENSAS', canvas.width / 2, canvas.height / 2 + 45);
      } else if (gameState === 'PAUSED') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.75)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = '#4DA3FF';
        ctx.font = 'bold 20px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('0xARCADE // EN PAUSA', canvas.width / 2, canvas.height / 2 - 10);

        ctx.fillStyle = '#F8FAFC';
        ctx.font = '12px monospace';
        ctx.fillText('PULSA [P] O [REANUDAR] PARA CONTINUAR', canvas.width / 2, canvas.height / 2 + 20);
      }

      animationId = requestAnimationFrame(gameLoop);
    }

    // Eventos de Teclado
    window.addEventListener('keydown', (e) => {
      // Capturar solo si el contenedor está en viewport o canvas enfocado
      if (['Space', 'ArrowLeft', 'ArrowRight', 'KeyA', 'KeyD'].includes(e.code)) {
        if (document.activeElement === canvas || gameState === 'PLAYING') {
          e.preventDefault();
        }
      }

      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = true;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = true;
      if (e.code === 'Space') {
        if (gameState === 'IDLE' || gameState === 'GAMEOVER') {
          startGame();
        } else if (gameState === 'PLAYING') {
          shootLaser();
        }
      }
      if (e.code === 'KeyP') {
        if (gameState === 'PLAYING' || gameState === 'PAUSED') {
          pauseGame();
        }
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'ArrowLeft' || e.code === 'KeyA') keys.left = false;
      if (e.code === 'ArrowRight' || e.code === 'KeyD') keys.right = false;
    });

    // Eventos de Botonera Táctil
    if (touchLeftBtn) {
      touchLeftBtn.addEventListener('touchstart', (e) => { e.preventDefault(); keys.left = true; });
      touchLeftBtn.addEventListener('touchend', (e) => { e.preventDefault(); keys.left = false; });
      touchLeftBtn.addEventListener('mousedown', () => { keys.left = true; });
      touchLeftBtn.addEventListener('mouseup', () => { keys.left = false; });
    }

    if (touchRightBtn) {
      touchRightBtn.addEventListener('touchstart', (e) => { e.preventDefault(); keys.right = true; });
      touchRightBtn.addEventListener('touchend', (e) => { e.preventDefault(); keys.right = false; });
      touchRightBtn.addEventListener('mousedown', () => { keys.right = true; });
      touchRightBtn.addEventListener('mouseup', () => { keys.right = false; });
    }

    if (touchFireBtn) {
      touchFireBtn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        if (gameState === 'PLAYING') shootLaser();
        else startGame();
      });
      touchFireBtn.addEventListener('click', () => {
        if (gameState === 'PLAYING') shootLaser();
        else startGame();
      });
    }

    // Botones de Cabecera
    if (mainBtn) {
      mainBtn.addEventListener('click', () => {
        if (gameState === 'IDLE' || gameState === 'GAMEOVER') {
          startGame();
        } else if (gameState === 'PLAYING' || gameState === 'PAUSED') {
          pauseGame();
        }
      });
    }

    if (overlayStartBtn) {
      overlayStartBtn.addEventListener('click', () => {
        startGame();
      });
    }

    if (soundBtn) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        if (soundLabel) soundLabel.textContent = soundEnabled ? 'SND: ON' : 'SND: OFF';
        if (soundEnabled) playLaserSound();
      });
    }

    // Iniciar bucle de animación
    animationId = requestAnimationFrame(gameLoop);
  })();
</script>
