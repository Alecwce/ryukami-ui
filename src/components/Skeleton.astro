---
export interface Props {
  label?: string;
  lines?: number;
}

const {
  label = '0xBUFFER // FETCHING_ENCRYPTED_BLOCKS...',
  lines = 3,
} = Astro.props;

const widths = ['w-3/4', 'w-full', 'w-5/6', 'w-2/3'];
---

<div
  class="p-4 border-2 border-black dark:border-slate-300 bg-white dark:bg-slate-900 shadow-[-3px_3px_0px_0px_var(--shadow-color,#000000)] font-mono text-xs space-y-3"
  role="status"
  aria-label={label}
>
  <div class="flex items-center justify-between gap-2 border-b border-black/20 dark:border-white/20 pb-2">
    <span class="text-[10px] font-extrabold text-scorch-crimson uppercase tracking-wider">
      {label}
    </span>
    <span class="bg-black text-scorch-gold px-1.5 py-0.5 text-[10px] border border-slate-700 font-bold">
      [ ░░░ SYNC ░░░ ]
    </span>
  </div>

  <div class="flex items-center gap-3">
    <div class="w-10 h-10 bg-slate-200 dark:bg-slate-800 border-2 border-black dark:border-slate-600 shrink-0 flex items-center justify-center text-[10px] font-bold text-slate-600 dark:text-slate-300">
      0x??
    </div>
    <div class="w-full space-y-2">
      <div class="h-3 w-1/2 bg-slate-200 dark:bg-slate-800 border border-black/30 dark:border-slate-600"></div>
      <div class="h-2.5 w-1/3 bg-slate-200 dark:bg-slate-800 border border-black/30 dark:border-slate-600"></div>
    </div>
  </div>

  <div class="space-y-2 pt-1">
    {Array.from({ length: lines }).map((_, idx) => (
      <div class={`h-2.5 ${widths[idx % widths.length]} bg-slate-200 dark:bg-slate-800 border border-black/30 dark:border-slate-600`}></div>
    ))}
  </div>
</div>
