---
interface Props {
  label: string;
  id?: string;
  name?: string;
  checked?: boolean;
  disabled?: boolean;
  variant?: 'crimson' | 'cyan' | 'gold';
}

const {
  label,
  id,
  name,
  checked = false,
  disabled = false,
  variant = 'crimson',
} = Astro.props;

const switchId = id || `sw-${Math.random().toString(36).substring(2, 9)}`;

const variantBg = {
  crimson: 'peer-checked:bg-scorch-crimson',
  cyan: 'peer-checked:bg-scorch-cyan',
  gold: 'peer-checked:bg-scorch-gold',
}[variant];
---

<label for={switchId} class="inline-flex items-center gap-3 cursor-pointer select-none group font-mono text-xs">
  <div class="relative">
    <input
      type="checkbox"
      id={switchId}
      name={name}
      checked={checked}
      disabled={disabled}
      class="peer sr-only"
    />
    <!-- Track -->
    <div class={`w-12 h-6 bg-slate-300 dark:bg-slate-800 border-2 border-black dark:border-slate-700 shadow-[-2px_2px_0px_0px_var(--shadow-color,#000000)] rounded-none ${variantBg} peer-disabled:opacity-50`}></div>
    <!-- Thumb con respuesta háptica/física Emil Kowalski (active:scale-90 + custom ease) -->
    <div class="absolute top-1 left-1 w-4 h-4 bg-white dark:bg-slate-200 border border-black transition-transform duration-100 ease-[cubic-bezier(0.23,1,0.32,1)] peer-checked:translate-x-6 group-active:scale-90"></div>
  </div>

  <span class="font-bold uppercase tracking-wide group-hover:text-scorch-crimson">
    {label}
  </span>
</label>
