---
import Button from './Button.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
---

<div class="tui-window overflow-hidden font-mono text-xs">
  <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-scorch-gold border border-black"></span>
      <span class="truncate">0xTHEME_STUDIO <span class="hidden sm:inline">// LIVE_TOKEN_ENGINE</span></span>
    </span>
    <span class="text-[10px] opacity-80 shrink-0">REALTIME CSS</span>
  </div>

  <div class="p-3.5 sm:p-5 bg-white dark:bg-slate-900 space-y-5 sm:space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Controles Interactivos -->
      <div class="lg:col-span-7 space-y-5">
        <!-- 1. Selector de Paleta -->
        <div class="space-y-2">
          <label class="block font-extrabold uppercase tracking-wider text-xs">
            // 1. NÚCLEO CROMÁTICO (PALETA EN VIVO)
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5" id="theme-preset-group">
            <button
              type="button"
              data-preset="scorch"
              class="preset-btn btn-brutal bg-scorch-crimson text-white px-3 py-2 text-left justify-between text-xs"
            >
              <span class="flex items-center gap-1.5"><Icon name="flame" class="w-3.5 h-3.5 text-scorch-gold shrink-0" /> SCORCH ORIGINAL</span>
              <span class="flex gap-1">
                <span class="w-3 h-3 bg-[#E63946] border border-black"></span>
                <span class="w-3 h-3 bg-[#4DA3FF] border border-black"></span>
              </span>
            </button>

            <button
              type="button"
              data-preset="crimson-soft"
              class="preset-btn btn-brutal bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-left justify-between text-xs"
            >
              <span class="flex items-center gap-1.5"><Icon name="droplet" class="w-3.5 h-3.5 text-scorch-crimson shrink-0" /> CRIMSON SOFT (PRO)</span>
              <span class="flex gap-1">
                <span class="w-3 h-3 bg-[#C81E32] border border-black"></span>
                <span class="w-3 h-3 bg-[#38BDF8] border border-black"></span>
              </span>
            </button>

            <button
              type="button"
              data-preset="matrix"
              class="preset-btn btn-brutal bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-left justify-between text-xs"
            >
              <span class="flex items-center gap-1.5"><Icon name="monitor" class="w-3.5 h-3.5 text-emerald-400 shrink-0" /> CRT MATRIX</span>
              <span class="flex gap-1">
                <span class="w-3 h-3 bg-[#10B981] border border-black"></span>
                <span class="w-3 h-3 bg-[#F59E0B] border border-black"></span>
              </span>
            </button>

            <button
              type="button"
              data-preset="cyber-gold"
              class="preset-btn btn-brutal bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-left justify-between text-xs"
            >
              <span class="flex items-center gap-1.5"><Icon name="zap" class="w-3.5 h-3.5 text-scorch-gold shrink-0" /> CYBER GOLD</span>
              <span class="flex gap-1">
                <span class="w-3 h-3 bg-[#F59E0B] border border-black"></span>
                <span class="w-3 h-3 bg-[#A855F7] border border-black"></span>
              </span>
            </button>
          </div>
        </div>

        <!-- 2. Profundidad de Sombra Brutalista -->
        <div class="space-y-2">
          <label class="block font-extrabold uppercase tracking-wider text-xs">
            // 2. FÍSICA DE SOMBRA (OFFSET IZQUIERDA-ABAJO)
          </label>
          <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5" id="shadow-size-group">
            <button
              type="button"
              data-shadow="-2px,2px"
              class="shadow-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              FINA (-2px)
            </button>
            <button
              type="button"
              data-shadow="-4px,4px"
              class="shadow-btn btn-brutal bg-scorch-cyan text-black px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              ESTÁNDAR (-4px)
            </button>
            <button
              type="button"
              data-shadow="-8px,8px"
              class="shadow-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              PESADA (-8px)
            </button>
          </div>
        </div>

        <!-- 3. Densidad de Matriz Halftone (Dither) -->
        <div class="space-y-2">
          <label class="block font-extrabold uppercase tracking-wider text-xs">
            // 3. TRAMA HALFTONE DE FONDO (DITHERING)
          </label>
          <div class="grid grid-cols-3 gap-1.5 sm:gap-2.5" id="dither-size-group">
            <button
              type="button"
              data-dither="8px"
              class="dither-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              DENSA (8px)
            </button>
            <button
              type="button"
              data-dither="12px"
              class="dither-btn btn-brutal bg-scorch-gold text-black px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              NORMAL (12px)
            </button>
            <button
              type="button"
              data-dither="20px"
              class="dither-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs"
            >
              AMPLIA (20px)
            </button>
          </div>
        </div>
      </div>

      <!-- Visor de Código CSS Generado en Vivo -->
      <div class="lg:col-span-5 flex flex-col justify-between bg-slate-950 text-slate-100 border-2 border-black dark:border-slate-700 p-4 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800 pb-2">
          <span class="text-scorch-gold font-extrabold text-[11px]">GENERATED_TOKENS.CSS</span>
          <Badge variant="crimson">TAILWIND v4</Badge>
        </div>

        <pre id="live-css-output" class="text-[11px] leading-relaxed overflow-x-auto text-emerald-400 font-mono">:root &#123;
  --scorch-red: #E63946;
  --cyber-blue: #4DA3FF;
  --eye-gold: #F4D35E;
  --shadow-offset-x: -4px;
  --shadow-offset-y: 4px;
  --dither-size: 12px;
&#125;</pre>

        <div class="flex gap-2 pt-2">
          <button
            type="button"
            id="copy-live-tokens-btn"
            class="btn-brutal bg-scorch-gold text-black w-full py-2 text-xs font-extrabold inline-flex items-center justify-center gap-1.5"
          >
            <Icon name="copy" class="w-3.5 h-3.5 shrink-0" />
            <span>COPIAR TOKENS CSS</span>
          </button>
          <button
            type="button"
            id="reset-theme-studio-btn"
            class="btn-brutal bg-slate-800 text-white px-3 py-2 text-xs font-extrabold"
            title="Restaurar valores originales"
          >
            ↺
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const presets = {
      scorch: {
        name: 'SCORCH ORIGINAL',
        primary: '#E63946',
        dark: '#9B1B30',
        secondary: '#4DA3FF',
        accent: '#F4D35E',
      },
      'crimson-soft': {
        name: 'CRIMSON SOFT (NOCTURNO PRO)',
        primary: '#C81E32',
        dark: '#7F1D1D',
        secondary: '#38BDF8',
        accent: '#EAB308',
      },
      matrix: {
        name: 'CRT MATRIX',
        primary: '#10B981',
        dark: '#065F46',
        secondary: '#34D399',
        accent: '#F59E0B',
      },
      'cyber-gold': {
        name: 'CYBER GOLD',
        primary: '#F59E0B',
        dark: '#B45309',
        secondary: '#A855F7',
        accent: '#38BDF8',
      },
    };

    let currentState = {
      preset: 'scorch',
      primary: '#E63946',
      secondary: '#4DA3FF',
      accent: '#F4D35E',
      shadowX: '-4px',
      shadowY: '4px',
      dither: '12px',
    };

    const outputEl = document.getElementById('live-css-output');
    const copyBtn = document.getElementById('copy-live-tokens-btn');
    const resetBtn = document.getElementById('reset-theme-studio-btn');

    function applyThemeState() {
      const root = document.documentElement;
      root.style.setProperty('--scorch-red', currentState.primary);
      root.style.setProperty('--color-scorch-crimson', currentState.primary);
      root.style.setProperty('--cyber-blue', currentState.secondary);
      root.style.setProperty('--color-scorch-cyan', currentState.secondary);
      root.style.setProperty('--eye-gold', currentState.accent);
      root.style.setProperty('--color-scorch-gold', currentState.accent);
      root.style.setProperty('--shadow-offset-x', currentState.shadowX);
      root.style.setProperty('--shadow-offset-y', currentState.shadowY);
      root.style.setProperty('--dither-size', currentState.dither);

      if (outputEl) {
        outputEl.textContent = `:root {\n  /* Preset: ${presets[currentState.preset].name} */\n  --scorch-red: ${currentState.primary};\n  --cyber-blue: ${currentState.secondary};\n  --eye-gold: ${currentState.accent};\n  --shadow-offset-x: ${currentState.shadowX};\n  --shadow-offset-y: ${currentState.shadowY};\n  --dither-size: ${currentState.dither};\n}`;
      }
    }

    document.querySelectorAll('.preset-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-preset');
        if (!key || !presets[key]) return;
        currentState.preset = key;
        currentState.primary = presets[key].primary;
        currentState.secondary = presets[key].secondary;
        currentState.accent = presets[key].accent;

        document.querySelectorAll('.preset-btn').forEach((b) => {
          b.className =
            'preset-btn btn-brutal bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3 py-2 text-left justify-between text-xs';
        });
        btn.className =
          'preset-btn btn-brutal bg-scorch-crimson text-white px-3 py-2 text-left justify-between text-xs';

        applyThemeState();
        if (window.showToast) {
          window.showToast('PALETA APLICADA', `Núcleo cromático cambiado a ${presets[key].name}.`, 'cyan', 2200);
        }
      });
    });

    document.querySelectorAll('.shadow-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-shadow');
        if (!val) return;
        const [x, y] = val.split(',');
        currentState.shadowX = x;
        currentState.shadowY = y;

        document.querySelectorAll('.shadow-btn').forEach((b) => {
          b.className = 'shadow-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs';
        });
        btn.className = 'shadow-btn btn-brutal bg-scorch-cyan text-black px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs';

        applyThemeState();
      });
    });

    document.querySelectorAll('.dither-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-dither');
        if (!val) return;
        currentState.dither = val;

        document.querySelectorAll('.dither-btn').forEach((b) => {
          b.className = 'dither-btn btn-brutal bg-white dark:bg-slate-800 px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs';
        });
        btn.className = 'dither-btn btn-brutal bg-scorch-gold text-black px-1.5 sm:px-3 py-1.5 text-[10px] sm:text-xs';

        applyThemeState();
      });
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        if (!outputEl) return;
        await navigator.clipboard.writeText(outputEl.textContent || '');
        if (window.showToast) {
          window.showToast('TOKENS COPIADOS', 'Variables CSS copiadas al portapapeles.', 'emerald');
        }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentState = {
          preset: 'scorch',
          primary: '#E63946',
          secondary: '#4DA3FF',
          accent: '#F4D35E',
          shadowX: '-4px',
          shadowY: '4px',
          dither: '12px',
        };
        applyThemeState();
        if (window.showToast) {
          window.showToast('STUDIO RESTAURADO', 'Valores originales de Scorch Dragon restablecidos.', 'gold');
        }
      });
    }
  })();
</script>
