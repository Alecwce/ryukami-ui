---
export interface SelectOption {
  value: string;
  label: string;
}

export interface Props {
  label: string;
  options: SelectOption[];
  prefix?: string;
  hint?: string;
  name?: string;
  value?: string;
}

const {
  label,
  options = [],
  prefix = 'OPT //',
  hint,
  name,
  value,
} = Astro.props;

const selectId = `scorch-select-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="space-y-1.5 font-mono text-xs w-full">
  <label for={selectId} class="block font-extrabold uppercase tracking-tight">
    {label}
  </label>

  <div class="relative flex items-stretch border-2 border-black dark:border-slate-200 bg-white dark:bg-slate-900 shadow-[-4px_4px_0px_0px_var(--shadow-color,#000000)] transition-transform duration-75 focus-within:translate-x-[1px] focus-within:-translate-y-[1px]">
    {prefix && (
      <span class="px-2.5 py-2 bg-black text-scorch-cyan font-extrabold border-r-2 border-black dark:border-slate-700 flex items-center select-none shrink-0">
        {prefix}
      </span>
    )}
    <select
      id={selectId}
      name={name}
      class="w-full appearance-none bg-transparent px-3 py-2.5 pr-10 font-mono text-xs font-bold text-slate-900 dark:text-slate-100 outline-none cursor-pointer"
      onchange="window.playMechanicalClick && window.playMechanicalClick()"
    >
      {options.map((opt) => (
        <option
          value={opt.value}
          selected={opt.value === value}
          class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-mono"
        >
          {opt.label}
        </option>
      ))}
    </select>
    <!-- Indicador Mecánico Derecha -->
    <span
      class="pointer-events-none inset-y-0 right-0 absolute px-2.5 bg-scorch-crimson text-white border-l-2 border-black flex items-center justify-center font-extrabold text-[10px]"
      aria-hidden="true"
    >
      ▼
    </span>
  </div>

  {hint && (
    <p class="text-[11px] text-slate-700 dark:text-slate-300">
      &gt; {hint}
    </p>
  )}
</div>
