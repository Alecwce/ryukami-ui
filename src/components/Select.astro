---
export interface SelectOption {
  value: string;
  label: string;
}

export interface Props {
  label: string;
  options: SelectOption[];
  prefix?: string;
  hint?: string;
  name?: string;
  value?: string;
}

const {
  label,
  options = [],
  prefix = 'OPT //',
  hint,
  name,
  value,
} = Astro.props;

const selectId = `scorch-select-${Math.random().toString(36).substring(2, 9)}`;
const hintId = `${selectId}-hint`;
---

<div class="space-y-1.5 font-mono text-xs w-full">
  <label for={selectId} class="block font-extrabold uppercase tracking-tight">
    {label}
  </label>

  <div class="relative flex items-stretch border-2 border-black dark:border-slate-200 bg-white dark:bg-slate-900 shadow-brutal transition-transform duration-75 focus-within:translate-x-[1px] focus-within:-translate-y-[1px] focus-within:border-scorch-crimson focus-within:ring-2 focus-within:ring-scorch-crimson">
    {prefix && (
      <span class="px-2.5 py-2 bg-black text-scorch-cyan font-extrabold border-r-2 border-black dark:border-slate-700 flex items-center select-none shrink-0">
        {prefix}
      </span>
    )}
    <select
      id={selectId}
      name={name}
      aria-describedby={hint ? hintId : undefined}
      class="w-full appearance-none bg-transparent px-3 py-2.5 pr-10 font-mono text-xs font-bold text-slate-900 dark:text-slate-100 focus:outline-none cursor-pointer"
      data-mech-change
    >
      {options.map((opt) => (
        <option
          value={opt.value}
          selected={opt.value === value}
          class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-mono"
        >
          {opt.label}
        </option>
      ))}
    </select>
    <!-- Indicador Mecánico Derecha -->
    <span
      class="pointer-events-none inset-y-0 right-0 absolute px-2.5 bg-scorch-crimson text-white border-l-2 border-black flex items-center justify-center font-extrabold text-[10px]"
      aria-hidden="true"
    >
      ▼
    </span>
  </div>

  {hint && (
    <p id={hintId} class="text-[11px] text-slate-700 dark:text-slate-300">
      &gt; {hint}
    </p>
  )}
</div>

<script is:inline>
  // Feedback mecánico sin `onchange` inline (compatible con CSP).
  document.querySelectorAll('select[data-mech-change]').forEach((select) => {
    if (select.dataset.mechBound === 'true') return;
    select.dataset.mechBound = 'true';
    select.addEventListener('change', () => {
      if (window.playMechanicalClick) window.playMechanicalClick();
    });
  });
</script>
