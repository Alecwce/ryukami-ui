---
import Icon from './Icon.astro';
import type { PropItem } from '../data/component-props';

interface Props {
  title: string;
  code: string;
  status?: string;
  cli?: string;
  propsDoc?: PropItem[];
}

const { title, code, status = "ASCII READY", cli, propsDoc } = Astro.props;
const uniqueId = `preview-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="tui-window overflow-hidden" id={uniqueId}>
  <!-- Header con Tabs y Controles -->
  <div class="tui-header flex flex-wrap gap-2 justify-between items-center">
    <div class="flex items-center gap-2 min-w-0">
      <span class="bg-black text-scorch-cyan px-2 py-0.5 border border-black font-extrabold truncate max-w-full">&gt; {title}</span>
      <span class="bg-black text-slate-200 text-[10px] border border-slate-700 px-1.5 py-0.5 shrink-0">{status}</span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {cli && (
        <button
          type="button"
          class="cli-copy-btn bg-black hover:bg-slate-800 text-slate-100 border border-slate-600 px-2 py-1 text-[11px] font-mono flex items-center gap-1.5 cursor-pointer"
          data-cli={cli}
          title="Copiar comando CLI de instalación"
        >
          <span class="text-scorch-crimson font-extrabold">$</span>
          <span class="cli-text">{cli}</span>
        </button>
      )}

      <!-- Tabs Selector -->
      <div class="flex bg-black p-0.5 border border-slate-700 text-xs">
        <button
          type="button"
          class="tab-btn active px-2.5 py-1 font-bold text-white bg-scorch-crimson border border-black cursor-pointer"
          data-tab="preview"
        >
          PREVIEW
        </button>
        <button
          type="button"
          class="tab-btn px-2.5 py-1 font-bold text-slate-200 hover:text-white cursor-pointer"
          data-tab="code"
        >
          CODE
        </button>
        {propsDoc && propsDoc.length > 0 && (
          <button
            type="button"
            class="tab-btn px-2.5 py-1 font-bold text-slate-200 hover:text-white cursor-pointer"
            data-tab="props"
          >
            PROPS
          </button>
        )}
      </div>

      <!-- Copy Button -->
      <button
        type="button"
        class="copy-btn btn-brutal bg-scorch-gold text-black text-xs px-2.5 py-1 font-extrabold flex items-center gap-1.5"
        data-code={code}
      >
        <span class="copy-icon inline-flex items-center" aria-hidden="true"><Icon name="copy" class="w-3.5 h-3.5" /></span>
        <span class="copy-text">COPIAR</span>
      </button>
    </div>
  </div>

  <!-- Vista Previa Container -->
  <div class="preview-content p-6 bg-canvas-surface dark:bg-canvas-dark-surface min-h-[120px] flex items-center justify-center">
    <div class="w-full">
      <slot />
    </div>
  </div>

  <!-- Vista Código Container (Oculto por defecto) -->
  <div class="code-content hidden p-4 bg-[#070A0F] text-slate-100 font-mono text-xs overflow-x-auto border-t-2 border-black dark:border-slate-800">
    <div class="min-w-full inline-block">
      {code.trim().split('\n').map((line, i) => (
        <div class="flex items-baseline leading-5 font-mono">
          <span class="w-8 shrink-0 text-right pr-3.5 select-none text-slate-500 font-mono text-[11px] font-bold opacity-60">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="whitespace-pre font-mono flex-1 min-w-0 text-slate-200">{line || '\u00A0'}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Vista Props Container (Oculto por defecto) -->
  {propsDoc && propsDoc.length > 0 && (
    <div class="props-content hidden p-4 bg-white dark:bg-slate-950 font-mono text-xs overflow-x-auto border-t-2 border-black dark:border-slate-800">
      <div class="overflow-x-auto w-full">
        <table class="w-full border-collapse border-2 border-black dark:border-slate-700 text-left">
          <thead>
            <tr class="bg-black text-white dark:bg-slate-900 border-b-2 border-black dark:border-slate-700 text-[11px] uppercase tracking-wider">
              <th class="p-2.5 font-extrabold border-r border-slate-800 dark:border-slate-700">Prop</th>
              <th class="p-2.5 font-extrabold border-r border-slate-800 dark:border-slate-700">Tipo TypeScript</th>
              <th class="p-2.5 font-extrabold border-r border-slate-800 dark:border-slate-700">Default</th>
              <th class="p-2.5 font-extrabold border-r border-slate-800 dark:border-slate-700">Descripción</th>
              <th class="p-2.5 font-extrabold">Variantes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-black/20 dark:divide-slate-800 text-[11px]">
            {propsDoc.map((item) => (
              <tr class="hover:bg-scorch-crimson/5 dark:hover:bg-scorch-crimson/10 transition-colors">
                <td class="p-2.5 font-extrabold text-scorch-crimson dark:text-scorch-cyan border-r border-black/10 dark:border-slate-800 whitespace-nowrap">
                  {item.name}
                </td>
                <td class="p-2.5 border-r border-black/10 dark:border-slate-800 text-sky-800 dark:text-sky-300 font-bold whitespace-nowrap">
                  <code>{item.type}</code>
                </td>
                <td class="p-2.5 border-r border-black/10 dark:border-slate-800 text-slate-600 dark:text-slate-400 whitespace-nowrap">
                  {item.default ? <code>{item.default}</code> : <span class="opacity-50">—</span>}
                </td>
                <td class="p-2.5 border-r border-black/10 dark:border-slate-800 text-slate-800 dark:text-slate-200">
                  {item.description}
                </td>
                <td class="p-2.5 text-slate-700 dark:text-slate-300">
                  {item.variants && item.variants.length > 0 ? (
                    <div class="flex flex-wrap gap-1">
                      {item.variants.map((v) => (
                        <span class="bg-slate-100 dark:bg-slate-900 px-1.5 py-0.5 border border-black/40 dark:border-slate-700 text-[10px] font-bold">
                          {v}
                        </span>
                      ))}
                    </div>
                  ) : (
                    <span class="opacity-50">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}
</div>

<script>
  // Inicializar todos los ComponentPreview
  document.querySelectorAll('.tui-window').forEach((container) => {
    const tabBtns = container.querySelectorAll('.tab-btn');
    const previewContent = container.querySelector('.preview-content');
    const codeContent = container.querySelector('.code-content');
    const propsContent = container.querySelector('.props-content');
    const copyBtn = container.querySelector('.copy-btn');
    const cliCopyBtn = container.querySelector('.cli-copy-btn');

    if (!tabBtns.length || !previewContent || !codeContent) return;

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if ((window as any).playMechanicalClick) (window as any).playMechanicalClick();
        const targetTab = btn.getAttribute('data-tab');

        tabBtns.forEach((b) => {
          b.classList.remove('active', 'bg-scorch-crimson', 'text-white', 'border', 'border-black');
          b.classList.add('text-slate-200');
        });

        btn.classList.add('active', 'bg-scorch-crimson', 'text-white', 'border', 'border-black');
        btn.classList.remove('text-slate-200');

        if (targetTab === 'preview') {
          previewContent.classList.remove('hidden');
          codeContent.classList.add('hidden');
          if (propsContent) propsContent.classList.add('hidden');
        } else if (targetTab === 'code') {
          previewContent.classList.add('hidden');
          codeContent.classList.remove('hidden');
          if (propsContent) propsContent.classList.add('hidden');
        } else if (targetTab === 'props') {
          previewContent.classList.add('hidden');
          codeContent.classList.add('hidden');
          if (propsContent) propsContent.classList.remove('hidden');
        }
      });
    });

    if (cliCopyBtn) {
      cliCopyBtn.addEventListener('click', async () => {
        const cliCmd = cliCopyBtn.getAttribute('data-cli');
        if (!cliCmd) return;
        try {
          await navigator.clipboard.writeText(cliCmd);
          if ((window as any).showToast) {
            (window as any).showToast('CLI COPIADO', `Comando listo: ${cliCmd}`, 'cyan', 2600);
          }
          const cliText = cliCopyBtn.querySelector('.cli-text');
          if (cliText) {
            const orig = cliText.textContent;
            cliText.textContent = 'COPIADO AL PORTAPAPELES';
            setTimeout(() => {
              cliText.textContent = orig;
            }, 1800);
          }
        } catch (err) {
          console.error(err);
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const textToCopy = copyBtn.getAttribute('data-code');
        if (!textToCopy) return;

        try {
          await navigator.clipboard.writeText(textToCopy);
          if ((window as any).showToast) {
            (window as any).showToast('SNIPPET COPIADO', 'Código Astro copiado al portapapeles.', 'emerald', 2800);
          } else if ((window as any).playTerminalBeep) {
            (window as any).playTerminalBeep(980, 0.08);
          }

          const copyText = copyBtn.querySelector('.copy-text');
          const copyIcon = copyBtn.querySelector('.copy-icon');

          if (copyText && copyIcon) {
            const originalText = copyText.textContent;
            copyText.textContent = 'COPIADO';
            copyBtn.classList.add('bg-emerald-400');

            setTimeout(() => {
              copyText.textContent = originalText;
              copyBtn.classList.remove('bg-emerald-400');
            }, 2000);
          }
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });
    }
  });
</script>
