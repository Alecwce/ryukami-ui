---
import Badge from './Badge.astro';

export interface TableColumn {
  key: string;
  label: string;
  sortable?: boolean;
}

export interface Props {
  id?: string;
  title?: string;
  columns: TableColumn[];
  rows: Record<string, string | number>[];
  searchable?: boolean;
  searchPlaceholder?: string;
  class?: string;
}

const {
  id = `scorch-table-${Math.random().toString(36).slice(2, 8)}`,
  title = '0xDATA_GRID // TUI_EXPLORER',
  columns = [],
  rows = [],
  searchable = true,
  searchPlaceholder = 'Filtrar registros en vivo (ej: online, postgres, 99%)…',
  class: className = '',
} = Astro.props;
---

<div class={`tui-window overflow-hidden font-mono text-xs ${className}`} data-scorch-datatable id={id}>
  <div class="tui-header bg-black dark:bg-scorch-crimson text-white">
    <span class="flex items-center gap-2 min-w-0">
      <span class="inline-block w-2.5 h-2.5 shrink-0 bg-scorch-cyan border border-black"></span>
      <span class="truncate">{title}</span>
    </span>
    <span class="px-1.5 py-0.5 text-[10px] bg-black text-scorch-gold border border-slate-700 font-extrabold shrink-0" data-table-count>
      {rows.length} ROWS
    </span>
  </div>

  {
    searchable && (
      <div class="p-2.5 border-b-2 border-black dark:border-slate-700 bg-slate-100 dark:bg-slate-950 flex items-center gap-2 focus-within:ring-2 focus-within:ring-scorch-crimson">
        <span class="text-scorch-crimson font-extrabold select-none">FILTER //</span>
        <input
          type="search"
          data-table-search
          placeholder={searchPlaceholder}
          aria-label={searchPlaceholder}
          class="w-full bg-transparent text-xs font-mono focus:outline-none placeholder:text-slate-500 text-slate-900 dark:text-slate-100"
        />
      </div>
    )
  }

  <div class="overflow-x-auto w-full">
    <table class="w-full min-w-[520px] border-collapse text-xs">
      <thead>
        <tr class="bg-slate-900 text-white dark:bg-slate-800 border-b-2 border-black dark:border-slate-600">
          {
            columns.map((col, colIdx) => (
              <th class="p-3 text-left font-extrabold uppercase select-none">
                {col.sortable !== false ? (
                  <button
                    type="button"
                    data-sort-col={colIdx}
                    class="inline-flex items-center gap-1.5 hover:text-scorch-gold cursor-pointer uppercase font-extrabold"
                    aria-label={`Ordenar por ${col.label}`}
                  >
                    <span>{col.label}</span>
                    <span class="text-[10px] opacity-75" data-sort-indicator>
                      ⇅
                    </span>
                  </button>
                ) : (
                  <span>{col.label}</span>
                )}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody class="divide-y divide-black/20 dark:divide-white/20" data-table-body>
        {
          rows.map((row) => (
            <tr class="hover:bg-scorch-crimson/10 transition-colors" data-table-row>
              {columns.map((col, idx) => {
                const val = String(row[col.key] ?? '');
                const upper = val.toUpperCase();
                const isStatus =
                  col.key === 'status' ||
                  col.key === 'estado' ||
                  ['ONLINE', 'ACTIVE', 'STABLE', 'WARNING', 'CRITICAL'].includes(upper);
                return (
                  <td class={`p-3 ${idx === 0 ? 'font-extrabold' : ''}`} data-cell-val={val.toLowerCase()}>
                    {isStatus ? (
                      <Badge
                        variant={
                          upper.includes('CRIT') || upper.includes('ERR')
                            ? 'crimson'
                            : upper.includes('WARN') || upper.includes('ACT')
                              ? 'gold'
                              : 'cyan'
                        }
                      >
                        ● {val}
                      </Badge>
                    ) : (
                      val
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<script is:inline>
  (function () {
    const tables = document.querySelectorAll('[data-scorch-datatable]');
    tables.forEach((root) => {
      if (root.hasAttribute('data-table-bound')) return;
      root.setAttribute('data-table-bound', 'true');

      const searchInput = root.querySelector('[data-table-search]');
      const tbody = root.querySelector('[data-table-body]');
      const countBadge = root.querySelector('[data-table-count]');
      const sortBtns = root.querySelectorAll('[data-sort-col]');
      if (!tbody) return;

      const allRows = Array.from(tbody.querySelectorAll('[data-table-row]'));
      let sortDirection = 1;

      if (searchInput) {
        searchInput.addEventListener('input', () => {
          const q = searchInput.value.trim().toLowerCase();
          let visibleCount = 0;
          allRows.forEach((tr) => {
            const text = tr.textContent ? tr.textContent.toLowerCase() : '';
            const match = !q || text.includes(q);
            tr.style.display = match ? '' : 'none';
            if (match) visibleCount++;
          });
          if (countBadge) countBadge.textContent = `${visibleCount} ROWS`;
        });
      }

      sortBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const colIdx = Number(btn.getAttribute('data-sort-col'));
          sortDirection *= -1;

          const sorted = [...allRows].sort((a, b) => {
            const cellA = a.children[colIdx]?.getAttribute('data-cell-val') || '';
            const cellB = b.children[colIdx]?.getAttribute('data-cell-val') || '';
            return cellA.localeCompare(cellB, undefined, { numeric: true }) * sortDirection;
          });

          sorted.forEach((tr) => tbody.appendChild(tr));
          const indicator = btn.querySelector('[data-sort-indicator]');
          if (indicator) indicator.textContent = sortDirection === 1 ? '▲' : '▼';
        });
      });
    });
  })();
</script>
