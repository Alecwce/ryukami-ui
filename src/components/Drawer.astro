---
export interface Props {
  id: string;
  title?: string;
  position?: 'right' | 'left';
  status?: string;
  triggerLabel?: string;
}

const {
  id,
  title = '0xDRAWER // SIDE_PANEL',
  position = 'right',
  status = 'ACTIVE',
  triggerLabel,
} = Astro.props;

const posClasses =
  position === 'left'
    ? 'mr-auto ml-0 h-full max-h-screen w-[calc(100vw-2.5rem)] max-w-md border-r-2'
    : 'ml-auto mr-0 h-full max-h-screen w-[calc(100vw-2.5rem)] max-w-md border-l-2';
---

{
  triggerLabel && (
    <button
      type="button"
      onclick={`document.getElementById('${id}').showModal()`}
      class="btn-brutal bg-scorch-cyan text-black px-4 py-2 text-xs font-extrabold"
    >
      <span>{triggerLabel}</span>
    </button>
  )
}

<dialog
  id={id}
  closedby="any"
  aria-labelledby={`${id}-title`}
  class={`tui-window ${posClasses} my-0 p-0 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border-2 border-black dark:border-slate-200 shadow-brutal-xl font-mono text-xs`}
>
  <div class="flex flex-col h-full max-h-screen">
    <div class="tui-header bg-black dark:bg-scorch-crimson text-white shrink-0">
      <span id={`${id}-title`} class="flex items-center gap-2 truncate">
        <span class="inline-block w-2 h-2 bg-scorch-gold border border-black shrink-0"></span>
        <span class="truncate">{title}</span>
      </span>
      <div class="flex items-center gap-2 shrink-0">
        <span class="bg-black text-scorch-cyan px-1.5 py-0.5 text-[10px] border border-slate-700 font-bold">
          {status}
        </span>
        <form method="dialog" class="inline-flex">
          <button
            type="submit"
            aria-label="Cerrar panel lateral"
            class="w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson text-white hover:bg-white hover:text-black cursor-pointer"
          >
            <svg class="w-2.5 h-2.5 stroke-current stroke-[2.2]" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5" stroke-linecap="square" />
            </svg>
          </button>
        </form>
      </div>
    </div>

    <div class="p-5 overflow-y-auto flex-1 space-y-4 leading-relaxed">
      <slot />
    </div>

    <div class="px-4 py-2.5 border-t-2 border-black dark:border-slate-700 bg-slate-50 dark:bg-slate-950 flex items-center justify-between text-[11px] shrink-0">
      <span class="opacity-75">ESC O CLIC FUERA PARA CERRAR</span>
      <form method="dialog">
        <button type="submit" class="btn-brutal bg-scorch-crimson text-white px-3 py-1 text-[11px]">
          CERRAR [×]
        </button>
      </form>
    </div>
  </div>
</dialog>
