# ============================================================================
# 🐉 RYUKAMI-UI // Cloudflare Pages Security, Cache & CORS Headers
# ============================================================================

# 1. Global Security Headers (100/100 Best Practices & Hardening)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  # CSP en modo reporte: se observan violaciones sin bloquear nada.
  # Para activarla: generar hashes de los <script is:inline> en build y cambiar
  # el nombre de la cabecera a Content-Security-Policy.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# 2. Open-Code CLI Registry JSON Endpoints (Allow remote CLI consumption)
/r/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

# 3. Immutable Static Assets (Hashed Astro CSS/JS & Optimized WebP Banners)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/scorch-dragon-banner*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400


