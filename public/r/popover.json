{
  "$schema": "https://ryukami-ui.dev/schema/registry-item.json",
  "name": "popover",
  "title": "Popover (HTML5 Popover API)",
  "type": "registry:ui",
  "category": "03_LAYOUT_AND_MODALS",
  "description": "Globo flotante de telemetría con API nativa popover=\"auto\" sin dependencias JS.",
  "registryDependencies": [],
  "sha256": "aecd6ed4f115e2a263ff6c9f6f75879d328006b51bff4809c613d071ab1204d5",
  "files": [
    {
      "path": "src/components/Popover.astro",
      "type": "registry:component",
      "sha256": "aecd6ed4f115e2a263ff6c9f6f75879d328006b51bff4809c613d071ab1204d5",
      "content": "---\nimport Icon from './Icon.astro';\n\nexport interface Props {\n  id?: string;\n  triggerLabel: string;\n  title: string;\n  status?: string;\n  variant?: 'crimson' | 'cyan' | 'gold' | 'outline';\n}\n\nconst {\n  id = `scorch-popover-${Math.random().toString(36).substring(2, 8)}`,\n  triggerLabel = 'INSPECCIONAR NODO',\n  title = '0xPOPOVER // TELEMETRY_NODE',\n  status = 'POPOVER_API',\n  variant = 'cyan',\n} = Astro.props;\n\nconst variantClasses = {\n  crimson: 'bg-scorch-crimson text-white',\n  cyan: 'bg-scorch-cyan text-black',\n  gold: 'bg-scorch-gold text-black',\n  outline: 'bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100',\n};\n---\n\n<div class=\"inline-block font-mono text-xs\">\n  <button\n    type=\"button\"\n    popovertarget={id}\n    class={`btn-brutal px-4 py-2 text-xs font-extrabold inline-flex items-center gap-1.5 ${variantClasses[variant]}`}\n  >\n    <Icon name=\"search\" class=\"w-3.5 h-3.5 shrink-0\" />\n    <span>{triggerLabel}</span>\n    <span class=\"text-[10px] border border-current px-1\">⊞</span>\n  </button>\n\n  <div\n    id={id}\n    popover=\"auto\"\n    class=\"tui-window w-[calc(100vw-2rem)] max-w-sm p-0 m-auto bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 border-2 border-black dark:border-slate-200 shadow-[-8px_8px_0px_0px_var(--shadow-color,#000000)]\"\n  >\n    <div class=\"tui-header bg-black dark:bg-scorch-crimson text-white\">\n      <span class=\"flex items-center gap-2\">\n        <span class=\"inline-block w-2 h-2 bg-scorch-gold border border-black\"></span>\n        <span>{title}</span>\n      </span>\n      <div class=\"flex items-center gap-2\">\n        <span class=\"bg-black text-scorch-cyan px-1.5 py-0.5 text-[10px] border border-slate-700 font-bold\">\n          {status}\n        </span>\n        <button\n          type=\"button\"\n          popovertarget={id}\n          popovertargetaction=\"hide\"\n          aria-label=\"Cerrar popover\"\n          class=\"w-5 h-5 inline-flex items-center justify-center border border-current bg-scorch-crimson text-white hover:bg-white hover:text-black cursor-pointer\"\n        >\n          <svg class=\"w-2.5 h-2.5 stroke-current stroke-[2.2]\" viewBox=\"0 0 10 10\" fill=\"none\">\n            <path d=\"M1.5 1.5L8.5 8.5M8.5 1.5L1.5 8.5\" stroke-linecap=\"square\" />\n          </svg>\n        </button>\n      </div>\n    </div>\n\n    <div class=\"p-4 space-y-3 text-xs leading-relaxed\">\n      <slot />\n    </div>\n  </div>\n</div>\n"
    }
  ]
}