{
  "name": "ryukami-ui",
  "type": "module",
  "version": "2.4.0",
  "description": "Retro TUI & Neo-Brutalist Component Library + CLI Installer & MCP Server (35 Modules) inspired by Velgrynd Scorch Lore. Built with Astro 7, Tailwind CSS 4 & TypeScript 7.",
  "author": "Ryukami Labs (Alecwce)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alecwce/ryukami-ui.git"
  },
  "homepage": "https://ryukami-ui.pages.dev",
  "keywords": [
    "astro",
    "tailwindcss-v4",
    "neo-brutalism",
    "tui",
    "retro-ui",
    "component-library",
    "cli-registry",
    "scorch-design-system",
    "ryukami-labs"
  ],
  "bin": {
    "ryukami-ui": "./bin/ryukami-ui.mjs"
  },
  "files": [
    "bin",
    "public/r",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.mjs",
    "dev": "node scripts/build-registry.mjs && astro dev",
    "start": "astro dev",
    "build": "node scripts/build-registry.mjs && astro build",
    "preview": "astro preview",
    "build:perf": "node scripts/build-registry.mjs && astro build --timings",
    "registry:build": "node scripts/build-registry.mjs",
    "cli": "node bin/ryukami-ui.mjs",
    "pages:dev": "pnpm build && npx --yes wrangler pages dev dist --port 8788",
    "pages:deploy": "pnpm build && npx --yes wrangler pages deploy dist --project-name=ryukami-ui --branch=main --commit-dirty=true",
    "ship": "git push origin main",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
